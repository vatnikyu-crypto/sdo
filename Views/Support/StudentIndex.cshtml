@model IEnumerable<SdoApp.Models.SupportTicket>
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Техническая поддержка";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    /* Баннер с контактами */
    .support-contact-banner {
        background: linear-gradient(135deg, rgba(79, 88, 157, 0.05) 0%, rgba(79, 88, 157, 0.02) 100%);
        border: 1px solid rgba(79, 88, 157, 0.15);
        border-radius: 16px;
    }

    .ticket-card {
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid var(--brand-gray);
        border-radius: 12px;
        background: #fff;
        padding: 16px;
    }

    .ticket-card:hover {
        background-color: #f8fafc;
        border-color: var(--brand-primary);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.08);
    }

    .ticket-card.active {
        background-color: #f0f4ff;
        border-color: var(--brand-primary);
        box-shadow: inset 4px 0 0 var(--brand-primary);
    }

    /* Аватарка в чате */
    .ticket-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #5b64ab 0%, #4F589D 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.2rem;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(79, 88, 157, 0.25);
    }

    /* Фиксированная высота окна чата */
    #chatTicketCard {
        height: 650px;
        max-height: calc(100vh - 150px);
    }

    .chat-box {
        background-color: #f4f6f9;
        overflow-y: auto;
        min-height: 0;
        /* Важно для работы скролла внутри flex */
    }

    .msg-bubble {
        max-width: 85%;
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 10px;
        font-size: 0.9rem;
    }

    .msg-student {
        background-color: var(--brand-primary);
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 2px;
        box-shadow: 0 2px 8px rgba(79, 88, 157, 0.2);
    }

    .msg-admin {
        background-color: #fff;
        color: #333;
        margin-right: auto;
        border-bottom-left-radius: 2px;
        border: 1px solid var(--brand-gray);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }

    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    /* Уведомления */
    .toast-container-custom {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .custom-toast {
        min-width: 300px;
        max-width: 400px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }

    .custom-toast.success {
        border-left-color: #198754;
    }

    .custom-toast.danger {
        border-left-color: #dc3545;
    }

    .custom-toast.warning {
        border-left-color: #F59E0B;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(120%);
            opacity: 0;
        }
    }
</style>

<!-- Контейнер для уведомлений -->
<div id="toastContainer" class="toast-container-custom"></div>

<!-- ЗАГОЛОВОК -->
<div class="mb-4 mt-2">
    <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-life-preserver text-primary fs-3"></i> Служба технической поддержки
    </h3>
    <p class="text-muted small mb-0">Если у вас возникли технические проблемы, отправьте обращение специалисту
        по дистанционному обучению</p>
    </div>

    <!-- БАННЕР С КОНТАКТАМИ СПЕЦИАЛИСТА (СВЕРХУ) -->
    <div class="support-contact-banner p-3 p-md-4 mb-4 shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-lg-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 bg-white shadow-sm"
                         style="width: 55px; height: 55px; border: 2px solid var(--brand-primary);">
                        <i class="bi bi-person-fill text-primary" style="font-size: 1.8rem;"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark fs-6">Бихтеев Пётр Вячеславович</div>
                        <div class="text-muted small">Специалист по дистанционному обучению</div>
                    </div>
                </div>
            </div>
        
            <div class="col-lg-5">
                <div class="d-flex flex-column flex-sm-row gap-3 gap-sm-4">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.65rem;">Телефон</div>
                        <a href="tel:+79521716132"
                           class="text-decoration-none text-dark fw-bold d-flex align-items-center gap-1">
                            <i class="bi bi-telephone-fill text-primary"></i> 8-952-171-61-32
                        </a>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.65rem;">Email</div>
                        <a href="mailto:bihteev_petr@mail.ru"
                           class="text-decoration-none text-dark fw-bold d-flex align-items-center gap-1">
                            <i class="bi bi-envelope-fill text-primary"></i> bihteev_petr@mail.ru
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="d-grid d-sm-flex gap-2 justify-content-lg-end">
                    <a href="tel:+79521716132" class="btn btn-brand fw-bold rounded-3 px-3 py-2 text-nowrap">
                        <i class="bi bi-telephone me-1"></i> Позвонить
                    </a>
                    <a href="mailto:bihteev_petr@mail.ru"
                       class="btn btn-outline-primary fw-bold rounded-3 px-3 py-2 text-nowrap">
                        <i class="bi bi-envelope me-1"></i> Написать
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- ЛЕВАЯ КОЛОНКА: ИСТОРИЯ ОБРАЩЕНИЙ -->
        <div class="col-lg-5">
            <div class="card bg-white border-0 shadow-sm p-4 h-100"
                 style="border-radius: 16px; border: 1px solid var(--brand-gray) !important; min-height: 550px;">
                <h5 class="fw-bold text-dark mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-list-task text-primary"></i> Ваши обращения
                </h5>
            
                <div class="d-flex flex-column gap-2" id="ticketsContainer" style="max-height: 450px; overflow-y: auto;">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted small" id="noTicketsPlaceholder">
                            <i class="bi bi-envelope-paper text-secondary opacity-50 d-block mb-3" style="font-size: 3rem;"></i>
                            <h6 class="fw-bold mt-2 mb-1 text-dark">Обращений пока нет</h6>
                            <p class="mb-0">Заполните форму справа, чтобы сформировать обращение.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            string badgeClass = t.Status == SdoApp.Models.TicketStatus.Открыто ? "bg-success" : "bg-secondary";
                        
                            var lastMessage = t.Messages.OrderByDescending(m => m.CreatedAt).FirstOrDefault();
                        
                            bool isNewReplyFromAdmin = t.Status == SdoApp.Models.TicketStatus.Открыто &&
                                                       lastMessage != null &&
                                                       lastMessage.SenderId != t.StudentId;

                            <div class="ticket-card position-relative" id="ticket-item-@t.Id"
                                 onclick="window.loadTicketChat(@t.Id)">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @badgeClass fw-bold px-2 py-1" style="font-size:0.7rem;">@t.Status</span>
                                    
                                        @if (isNewReplyFromAdmin)
                                        {
                                            <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size:0.65rem;">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Ответ техподдержки
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted"
                                           style="font-size:0.75rem;">@t.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div class="fw-bold text-dark text-truncate" style="font-size:0.9rem;">
                                    <i class="bi bi-telephone me-1 text-muted"></i> @t.Phone
                                </div>
                                <small class="text-muted d-block text-truncate mt-1">Нажмите для просмотра переписки</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- ПРАВАЯ КОЛОНКА: ФОРМА ИЛИ ЧАТ -->
        <div class="col-lg-7">
            <!-- ОКНО А: СОЗДАНИЕ ПЕРВОГО ТИКЕТА -->
            <div class="card bg-white border-0 shadow-sm p-4 h-100" id="createTicketCard"
                 style="border-radius: 16px; border: 1px solid var(--brand-gray) !important;">
                <h5 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i> Новое обращение
                </h5>
                <p class="text-muted small mb-4">Опишите проблему, и мы ответим вам в ближайшее время</p>
        
                <form id="createTicketForm" autocomplete="off" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Ваш номер телефона для связи <span
                            class="text-danger">*</span></label>
                            <input type="text" id="ticketPhone" name="phone" class="form-control fw-bold" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold text-uppercase">Описание технической проблемы
                                <span class="text-danger">*</span></label>
                                <textarea id="ticketText" name="text" class="form-control" rows="5" required></textarea>
                            </div>
                            <div class="mb-4">
                                <label class="form-label text-muted small fw-bold text-uppercase">Прикрепить файлы (до 3 штук, до 15
                                    МБ)</label>
                                    <input type="file" id="ticketFiles" name="files" class="form-control" multiple />
                                    <div id="fileValidationFeedback" class="text-danger small mt-1 d-none"></div>
                                </div>
                                <button type="button" id="submitTicketBtn" class="btn btn-brand w-100 fw-bold py-2 shadow-sm rounded-3">
                                    Отправить обращение
                                </button>
                            </form>
                        </div>

                        <!-- ОКНО Б: ИНТЕРАКТИВНЫЙ ДИАЛОГ ЧАТА -->
                        <div class="card bg-white border-0 shadow-sm p-0 d-none d-flex flex-column" id="chatTicketCard"
                             style="border-radius: 16px; border: 1px solid var(--brand-gray) !important; overflow: hidden;">
            
                            <!-- Шапка чата -->
                            <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ticket-avatar shadow-sm"><i class="bi bi-headset"></i></div>
                                    <div>
                                        <h5 class="fw-bold text-dark m-0 d-flex align-items-center gap-2" id="chatTitle">Обращение №00
                                        </h5>
                                        <small class="text-muted d-block mt-1" id="chatPhone">Контактный телефон: —</small>
                                    </div>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-outline-primary fw-bold rounded-3 shadow-sm"
                                            onclick="window.showCreateForm()">
                                        <i class="bi bi-plus-lg me-1"></i> Новое обращение
                                    </button>
                                </div>
                            </div>

                            <!-- Лента сообщений -->
                            <div class="chat-box flex-grow-1 m-0 p-4 border-0 rounded-0" id="chatBoxContainer"></div>

                            <!-- БЛОК ПОВТОРНОГО ОТВЕТА С ФАЙЛАМИ -->
                            <div id="studentReplyFormContainer" class="p-3 bg-white border-top">
                                <form id="studentReplyForm" autocomplete="off" enctype="multipart/form-data">
                    
                                    <!-- Контейнер для списка выбранных файлов -->
                                    <div id="studentFileListContainer" class="d-flex flex-wrap gap-2 mb-2 d-none"></div>

                                    <div class="d-flex align-items-end bg-light rounded-4 p-2 border shadow-sm gap-2">
                                        <textarea id="studentReplyText" class="form-control border-0 bg-transparent shadow-none p-2"
                                                  rows="2" style="resize: none; max-height: 120px;"
                                                  placeholder="Напишите ответ техподдержке..."></textarea>
                        
                                        <input type="file" id="studentReplyFiles" class="d-none" multiple />
                                        <label for="studentReplyFiles"
                                               class="btn btn-light border-0 rounded-circle text-secondary flex-shrink-0 d-flex align-items-center justify-content-center"
                                               style="width: 38px; height: 38px; cursor: pointer;"
                                               title="Прикрепить файлы (макс. 3 шт, до 15 МБ)">
                                            <i class="bi bi-paperclip fs-5"></i>
                                        </label>
                        
                                        <button type="button" id="studentSubmitReplyBtn"
                                                class="btn btn-brand rounded-circle flex-shrink-0 shadow-sm d-flex align-items-center justify-content-center"
                                                style="width: 38px; height: 38px; padding: 0;" title="Отправить">
                                            <i class="bi bi-send-fill fs-5"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <!-- ПЛАШКА БЛОКИРОВКИ 1: АДМИН ЗАКРЫЛ ТИКЕТ -->
                            <div id="studentReplyLockedNotice"
                                 class="alert alert-secondary border-0 border-top text-center small text-muted p-3 m-0 rounded-0 d-none">
                                <i class="bi bi-lock-fill me-1"></i> Это обращение успешно решено и закрыто техподдержкой. Диалог
                                заблокирован.
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    let currentActiveTicketId = null;

                    const createTicketCard = document.getElementById('createTicketCard');
                    const chatTicketCard = document.getElementById('chatTicketCard');
                    const createForm = document.getElementById('createTicketForm');

                    const fileInput = document.getElementById('ticketFiles');
                    const feedback = document.getElementById('fileValidationFeedback');
                    const submitBtn = document.getElementById('submitTicketBtn');
                    const chatBoxContainer = document.getElementById('chatBoxContainer');

                    const studentReplyFormContainer = document.getElementById('studentReplyFormContainer');
                    const studentReplyLockedNotice = document.getElementById('studentReplyLockedNotice');

                    const studentReplyText = document.getElementById('studentReplyText');
                    const studentSubmitReplyBtn = document.getElementById('studentSubmitReplyBtn');

                    // 1. УВЕДОМЛЕНИЯ (TOASTS)
                    function showToast(message, type = 'success') {
                        const container = document.getElementById('toastContainer');
                        const toast = document.createElement('div');
                        toast.className = `custom-toast ${type}`;
                        let iconClass = 'bi-check-circle-fill text-success';
                        if (type === 'danger') iconClass = 'bi-exclamation-triangle-fill text-danger';
                        if (type === 'warning') iconClass = 'bi-info-circle-fill text-warning';
        
                        toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
                        container.appendChild(toast);
        
                        setTimeout(() => {
                            toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
                            setTimeout(() => toast.remove(), 300);
                        }, 3500);
                    }

                    // 2. ВАЛИДАЦИЯ ФАЙЛОВ ПРИ СОЗДАНИИ ТИКЕТА
                    function validateFiles(inputEl, feedbackEl, buttonEl) {
                        feedbackEl.classList.add('d-none');
                        buttonEl.disabled = false;
                        const files = inputEl.files;
                        if (files.length === 0) return true;

                        if (files.length > 3) {
                            feedbackEl.innerHTML = '<span class="d-inline-flex align-items-center gap-1"><i class="bi bi-exclamation-triangle-fill"></i> Ошибка: Можно прикрепить не более 3 файлов!</span>';
                            feedbackEl.classList.remove('d-none');
                            buttonEl.disabled = true;
                            return false;
                        }
                        let totalBytes = 0;
                        for (let i = 0; i < files.length; i++) totalBytes += files[i].size;
                        const totalMb = totalBytes / (1024 * 1024);
                        if (totalMb > 15.0) {
                            feedbackEl.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i> Ошибка: Вес файлов (${totalMb.toFixed(2)} МБ) превышает 15 МБ!`;
                            feedbackEl.classList.remove('d-none');
                            buttonEl.disabled = true;
                            return false;
                        }
                        return true;
                    }

                    if (fileInput) fileInput.addEventListener('change', () => validateFiles(fileInput, feedback, submitBtn));

                    // 3. ОТПРАВКА ПЕРВОГО ТИКЕТА
                    if (submitBtn) {
                        submitBtn.addEventListener('click', async function () {
                            const phone = document.getElementById('ticketPhone').value.trim();
                            const text = document.getElementById('ticketText').value.trim();
            
                            if (!phone || !text) {
                                showToast('Заполните обязательные поля!', 'danger');
                                return;
                            }

                            this.disabled = true;
                            this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Отправка...';
            
                            const formData = new FormData();
                            formData.append('phone', phone);
                            formData.append('text', text);
                            for (let i = 0; i < fileInput.files.length; i++) formData.append('files', fileInput.files[i]);
            
                            try {
                                const response = await fetch('/Support/CreateTicket', { method: 'POST', body: formData });
                                const result = await response.json();
                                if (result.success) {
                                    showToast('Обращение успешно отправлено!', 'success');
                                    setTimeout(() => window.location.reload(), 1000);
                                }
                                else {
                                    showToast(result.message, 'danger');
                                    this.disabled = false;
                                    this.textContent = 'Отправить обращение';
                                }
                            } catch (err) {
                                showToast('Ошибка сети.', 'danger');
                                this.disabled = false;
                                this.textContent = 'Отправить обращение';
                            }
                        });
                    }

                    // === УПРАВЛЕНИЕ ФАЙЛАМИ В ОТВЕТЕ ===
                    let selectedFiles = new DataTransfer();
                    const replyFileInput = document.getElementById('studentReplyFiles');
                    const fileListContainer = document.getElementById('studentFileListContainer');

                    replyFileInput.addEventListener('change', function () {
                        const newFiles = Array.from(this.files);

                        for (let file of newFiles) {
                            if (selectedFiles.files.length >= 3) {
                                showToast('Можно прикрепить не более 3 файлов!', 'warning');
                                break;
                            }
                            let isDuplicate = false;
                            for (let i = 0; i < selectedFiles.files.length; i++) {
                                if (selectedFiles.files[i].name === file.name && selectedFiles.files[i].size === file.size) {
                                    isDuplicate = true; break;
                                }
                            }
                            if (!isDuplicate) selectedFiles.items.add(file);
                        }

                        let totalSizeMb = Array.from(selectedFiles.files).reduce((sum, f) => sum + f.size, 0) / (1024 * 1024);
                        if (totalSizeMb > 15.0) {
                            showToast(`Общий вес файлов (${totalSizeMb.toFixed(2)} МБ) превышает 15 МБ!`, 'danger');
                            selectedFiles = new DataTransfer();
                        }

                        this.files = selectedFiles.files;
                        renderFileList();
                    });

                    function renderFileList() {
                        fileListContainer.innerHTML = '';
                        const files = Array.from(selectedFiles.files);

                        if (files.length === 0) {
                            fileListContainer.classList.add('d-none');
                            return;
                        }
                        fileListContainer.classList.remove('d-none');

                        files.forEach((file, index) => {
                            const sizeMb = (file.size / 1024 / 1024).toFixed(2);
                            const chip = document.createElement('div');
                            chip.className = 'badge bg-light text-dark border px-2 py-2 d-flex align-items-center gap-2 shadow-sm';
                            chip.style.fontSize = '0.75rem';
                            chip.innerHTML = `
                                                <i class="bi bi-file-earmark-text text-primary"></i>
                                                <span class="text-truncate" style="max-width: 150px;" title="${file.name}">${file.name}</span>
                                                <span class="text-muted">(${sizeMb} МБ)</span>
                                                <button type="button" class="btn-close ms-1" style="font-size: 0.5rem;" onclick="removeSelectedFile(${index})"></button>
                                            `;
                            fileListContainer.appendChild(chip);
                        });
                    }

                    window.removeSelectedFile = function (index) {
                        const dt = new DataTransfer();
                        const files = Array.from(selectedFiles.files);
                        files.splice(index, 1);
                        files.forEach(f => dt.items.add(f));
                        selectedFiles = dt;
                        replyFileInput.files = selectedFiles.files;
                        renderFileList();
                    };

                    // 4. ЗАГРУЗКА ЧАТА
                    window.loadTicketChat = async function (ticketId) {
                        currentActiveTicketId = ticketId;
                        Array.from(document.querySelectorAll('.ticket-card')).forEach(c => c.classList.remove('active'));

                        const targetCard = document.getElementById(`ticket-item-${ticketId}`);
                        if (targetCard) targetCard.classList.add('active');

                        const adminReplyBadge = targetCard.querySelector('.badge.bg-warning');
                        if (adminReplyBadge) adminReplyBadge.remove();

                        try {
                            const response = await fetch(`/Support/GetDetails/${ticketId}`);
                            const data = await response.json();

                            createTicketCard.classList.add('d-none');
                            chatTicketCard.classList.remove('d-none');

                            document.getElementById('chatTitle').textContent = `Обращение №${data.ticketId}`;
                            document.getElementById('chatPhone').textContent = `Контакт: ${data.phone} | Создано: ${data.createdAt}`;

                            if (data.messages.length === 0) {
                                chatBoxContainer.innerHTML = '<div class="text-center text-muted small py-4">Диалог пуст.</div>';
                                return;
                            }

                            chatBoxContainer.innerHTML = data.messages.map(m => {
                                const bubbleClass = m.isAdminMessage ? 'msg-admin' : 'msg-student';
                                const nameStyle = m.isAdminMessage ? 'color: #dc3545;' : 'color: rgba(255,255,255,0.8);';

                                let filesHtml = '';
                                if (m.files && m.files.length > 0) {
                                    filesHtml = '<div class="mt-2 border-top pt-2 small font-monospace">' + m.files.map(f => `
                                                        <div class="d-flex align-items-center gap-1 mb-1">
                                                            <i class="bi bi-paperclip"></i> <a href="${f.url}" download="${f.name}" class="${m.isAdminMessage ? 'text-primary' : 'text-white'} fw-bold text-decoration-none text-truncate d-inline-block" style="max-width:200px;">${f.name}</a>
                                                        </div>
                                                    `).join('') + '</div>';
                                }

                                return `
                                                <div class="d-flex flex-column w-100">
                                                    <div class="msg-bubble ${bubbleClass}">
                                                        <div style="font-size:0.75rem; ${nameStyle}" class="fw-bold mb-1">${m.senderFio}</div>
                                                        <div style="font-size:0.9rem; white-space:pre-line;">${m.text}</div>
                                                        ${filesHtml}
                                                    </div>
                                                    <small class="text-muted mb-3 ${m.isAdminMessage ? 'ps-2' : 'text-end pe-2'}" style="font-size:0.7rem; margin-top:-8px;">${m.createdAt}</small>
                                                </div>`;
                            }).join('');

                            chatBoxContainer.scrollTop = chatBoxContainer.scrollHeight;

                            if (data.status === 1) {
                                studentReplyFormContainer.classList.add('d-none');
                                studentReplyLockedNotice.classList.remove('d-none');
                            } else {
                                studentReplyFormContainer.classList.remove('d-none');
                                studentReplyLockedNotice.classList.add('d-none');
                            }

                            if (window.updateStudentSupportBadge) await window.updateStudentSupportBadge();

                        } catch (err) {
                            showToast('Не удалось подгрузить историю диалога.', 'danger');
                        }
                    }

                    // 5. ОТВЕТ В ЧАТЕ
                    if (studentSubmitReplyBtn) {
                        studentSubmitReplyBtn.addEventListener('click', async function () {
                            const text = studentReplyText.value.trim();
                            if (!text && selectedFiles.files.length === 0) {
                                showToast('Пожалуйста, введите текст ответа или прикрепите файлы!', 'warning');
                                return;
                            }

                            const originalIcon = '<i class="bi bi-send-fill fs-5"></i>';
                            this.disabled = true;
                            this.innerHTML = '<span class="spinner-border spinner-border-sm text-white"></span>';

                            const formData = new FormData();
                            formData.append('ticketId', currentActiveTicketId);
                            formData.append('text', text);

                            // Отправляем файлы как replyFiles (как ждет бэкенд)
                            Array.from(selectedFiles.files).forEach(file => {
                                formData.append('replyFiles', file);
                            });

                            try {
                                const response = await fetch('/Support/SendAdminReply', { method: 'POST', body: formData });
                                const result = await response.json();

                                if (result.success) {
                                    studentReplyText.value = "";
                    
                                    selectedFiles = new DataTransfer();
                                    replyFileInput.value = "";
                                    renderFileList();

                                    this.disabled = false;
                                    this.innerHTML = originalIcon;
                                    await window.loadTicketChat(currentActiveTicketId);
                                } else {
                                    showToast(result.message, 'danger');
                                    this.disabled = false;
                                    this.innerHTML = originalIcon;
                                }
                            } catch (err) {
                                showToast('Ошибка сети при отправке ответа.', 'danger');
                                this.disabled = false;
                                this.innerHTML = originalIcon;
                            }
                        });
                    }

                    // 6. ВОЗВРАТ К ФОРМЕ
                    window.showCreateForm = function () {
                        Array.from(document.querySelectorAll('.ticket-card')).forEach(c => c.classList.remove('active'));
                        chatTicketCard.classList.add('d-none');
                        createTicketCard.classList.remove('d-none');
                        if (createForm) createForm.reset();
                        feedback.classList.add('d-none');
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Отправить обращение';
                    }
                </script>