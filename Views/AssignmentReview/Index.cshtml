@model IEnumerable<SdoApp.Models.StudentSubmission>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Проверка практических заданий";

    var pendingSubmissions = Model.Where(s => s.Status == SdoApp.Models.SubmissionStatus.OnReview).ToList();
    var reviewedSubmissions = Model.Where(s => s.Status != SdoApp.Models.SubmissionStatus.OnReview).ToList();
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    .submission-card {
        border-left: 4px solid #f6c23e;
        border-radius: 12px;
        transition: all 0.2s;
    }
    .submission-card.need-fix { border-left-color: #fd7e14; }
    .submission-card.completed { border-left-color: #198754; }

    /* Стили для чата (как в кабинете студента) */
    .chat-container {
        background-color: #f1f5f9;
        border-radius: 12px;
        padding: 16px;
        max-height: 400px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        border: 1px solid var(--brand-gray);
    }

    .chat-bubble {
        max-width: 85%;
        padding: 10px 14px;
        border-radius: 12px;
        position: relative;
        font-size: 0.9rem;
        line-height: 1.4;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    .chat-bubble.admin {
        align-self: flex-end;
        background-color: var(--brand-primary);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .chat-bubble.student {
        align-self: flex-start;
        background-color: #fff;
        color: #334155;
        border-bottom-left-radius: 4px;
        border: 1px solid var(--brand-gray);
    }

    .chat-sender { font-size: 0.7rem; font-weight: 700; margin-bottom: 4px; opacity: 0.8; }
    .chat-time { font-size: 0.65rem; text-align: right; margin-top: 6px; opacity: 0.7; }
    
    .chat-file-link {
        display: inline-flex; align-items: center; gap: 6px; margin-top: 8px;
        padding: 6px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none; transition: all 0.2s;
    }
    .chat-bubble.admin .chat-file-link { background: rgba(255,255,255,0.2); color: white; }
    .chat-bubble.admin .chat-file-link:hover { background: rgba(255,255,255,0.3); color: white; }
    .chat-bubble.student .chat-file-link { background: #f8fafc; color: var(--brand-primary); border: 1px solid var(--brand-gray); }
    .chat-bubble.student .chat-file-link:hover { background: #f1f5f9; }

    /* Стили для карточек в архиве */
    .archive-card {
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid var(--brand-gray);
        border-radius: 12px;
        background: #fff;
    }
    .archive-card:hover {
        border-color: var(--brand-primary);
        background-color: #f8fafc;
        transform: translateX(4px);
    }

    /* Уведомления */
    .toast-container-custom {
        position: fixed; top: 20px; right: 20px; z-index: 9999;
        display: flex; flex-direction: column; gap: 10px;
    }
    .custom-toast {
        min-width: 300px; max-width: 400px; background: white;
        border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        display: flex; align-items: center; padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }
    .custom-toast.success { border-left-color: #198754; }
    .custom-toast.danger { border-left-color: #dc3545; }
    .custom-toast.warning { border-left-color: #F59E0B; }

    @@keyframes slideInRight { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes fadeOutRight { from { transform: translateX(0); opacity: 1; } to { transform: translateX(120%); opacity: 0; } }
    
    .btn-brand { background-color: var(--brand-primary); color: white; border: none; transition: all 0.3s; }
    .btn-brand:hover { background-color: var(--brand-dark); color: white; box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3); }

    @@media (min-width: 992px) {
        .border-start-lg {
            border-left: 1px solid var(--brand-gray) !important;
        }
    }
</style>

<div id="toastContainer" class="toast-container-custom"></div>

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-clipboard-check text-primary fs-3"></i> Проверка заданий
        </h3>
        <small class="text-muted">Рецензирование, диалог со студентом и выставление оценок</small>
    </div>
</div>

<!-- НАВИГАЦИЯ ПО ВКЛАДКАМ -->
<ul class="nav nav-pills mb-4 gap-2" id="assignmentTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold px-4 py-2 rounded-3" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
            <i class="bi bi-hourglass-split me-1"></i> Ожидают проверки 
            @if(pendingSubmissions.Count > 0)
            {
                <span class="badge bg-danger ms-1 rounded-pill">@pendingSubmissions.Count</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-dark bg-white border px-4 py-2 rounded-3" id="reviewed-tab" data-bs-toggle="tab" data-bs-target="#reviewed" type="button" role="tab">
            <i class="bi bi-archive me-1"></i> Архив (@reviewedSubmissions.Count)
        </button>
    </li>
</ul>

<div class="tab-content" id="assignmentTabsContent">
    
    <!-- ============================================== -->
    <!-- ВКЛАДКА 1: ОЖИДАЮТ ПРОВЕРКИ (БЕЗ ИЗМЕНЕНИЙ)    -->
    <!-- ============================================== -->
    <div class="tab-pane fade show active" id="pending" role="tabpanel">
        <div class="d-flex flex-column gap-4" id="pendingContainer">
            @if (!pendingSubmissions.Any())
            {
                <div class="text-center py-5 bg-white border rounded-4 shadow-sm text-muted">
                    <i class="bi bi-emoji-smile text-success opacity-50 d-block mb-3" style="font-size: 4rem;"></i>
                    <h5 class="fw-bold text-dark">Все задания проверены!</h5>
                    <p class="small mb-0">На данный момент новых работ нет.</p>
                </div>
            }
            else
            {
                @foreach (var sub in pendingSubmissions)
                {
                    <div class="card bg-white submission-card border-0 shadow-sm" id="submission-block-@sub.Id">
                        <div class="card-body p-4">
                            <div class="row align-items-start g-4">
                                <div class="col-lg-7">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 mb-2 fw-bold" style="font-size: 0.65rem;">Ожидает проверки</span>
                                            <h5 class="fw-bold text-dark mb-1">
                                                <i class="bi bi-person-fill text-secondary me-1"></i> @sub.Student?.LastName @sub.Student?.FirstName
                                            </h5>
                                            <div class="small text-muted">
                                                <i class="bi bi-book me-1"></i> @sub.CourseMaterial?.Course?.Title | 
                                                <i class="bi bi-journal-text me-1"></i> @sub.CourseMaterial?.Title
                                            </div>
                                        </div>
                                    </div>

                                    <div class="chat-container">
                                        @foreach (var msg in sub.Messages.OrderBy(m => m.CreatedAt))
                                        {
                                            bool isStudent = msg.AuthorId == sub.StudentId;
                                            <div class="chat-bubble @(isStudent ? "student" : "admin")">
                                                <div class="chat-sender">@(isStudent ? "Слушатель" : "Вы (Преподаватель)")</div>
                                                <div>@msg.TextContent</div>
                                                @if (!string.IsNullOrEmpty(msg.FilePath))
                                                {
                                                    <a href="@msg.FilePath" class="chat-file-link" download>
                                                        <i class="bi bi-paperclip"></i> Скачать файл
                                                    </a>
                                                }
                                                <div class="chat-time">@msg.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-lg-5 border-start-lg">
                                    <form class="review-assignment-form" data-id="@sub.Id" enctype="multipart/form-data">
                                        <input type="hidden" name="submissionId" value="@sub.Id" />
                                        
                                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-reply-fill text-primary me-1"></i> Ваш ответ</h6>

                                        <div class="mb-3">
                                            <label class="form-label text-muted small fw-bold text-uppercase">Комментарий / Замечания <span class="text-danger">*</span></label>
                                            <textarea name="reviewText" class="form-control" rows="3" required placeholder="Напишите замечания или похвалу..."></textarea>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label text-muted small fw-bold text-uppercase">Прикрепить файл (Необязательно)</label>
                                            <input type="file" name="adminFile" class="form-control form-control-sm" />
                                            <div class="form-text small text-muted mt-1">Прикрепите методичку, пример или исправленный документ.</div>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label text-muted small fw-bold text-uppercase">Вердикт / Оценка <span class="text-danger">*</span></label>
                                            <select name="grade" class="form-select fw-bold text-dark">
                                                <option value="">Отправить на доработку (без оценки)</option>
                                                <option value="5">5 — Отлично</option>
                                                <option value="4">4 — Хорошо</option>
                                                <option value="3">3 — Удовлетворительно</option>
                                                <option value="2">2 — Неудовлетворительно</option>
                                            </select>
                                        </div>
                                        
                                        <button type="button" class="btn btn-brand w-100 fw-bold py-2 submit-review-btn shadow-sm rounded-3">
                                            <i class="bi bi-send-fill me-1"></i> Отправить ответ
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ============================================== -->
    <!-- ВКЛАДКА 2: АРХИВ ОБРАБОТАННЫХ                  -->
    <!-- ============================================== -->
    <div class="tab-pane fade" id="reviewed" role="tabpanel">
        <div class="d-flex flex-column gap-2">
            @if (!reviewedSubmissions.Any())
            {
                <div class="text-center py-5 bg-white border rounded-4 shadow-sm text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <h6 class="fw-bold">Архив пуст.</h6>
                </div>
            }
            else
            {
                @foreach (var sub in reviewedSubmissions)
                {
                    string statusColor = sub.Status == SdoApp.Models.SubmissionStatus.NeedFix ? "warning" : "success";
                    string statusIcon = sub.Status == SdoApp.Models.SubmissionStatus.NeedFix ? "arrow-counterclockwise" : "check-circle";
                    string statusText = sub.Status == SdoApp.Models.SubmissionStatus.NeedFix ? "На доработке" : $"Оценка: {sub.Grade}";
                    
                    // Безопасное склеивание ФИО (если отчества нет, пробел не будет висеть)
                    string fullName = string.Join(" ", new[] { sub.Student?.LastName, sub.Student?.FirstName, sub.Student?.MiddleName }.Where(s => !string.IsNullOrWhiteSpace(s)));

                    <div class="archive-card p-3 shadow-sm" onclick="openArchiveModal(@sub.Id)">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                            
                            <!-- Левая часть: Аватар, ФИО и Курс -->
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0 mt-1" style="width: 42px; height: 42px;">
                                    <i class="bi bi-person-fill text-primary fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1 d-flex flex-wrap align-items-center gap-2">
                                        <span class="text-muted fw-normal" style="font-size: 0.85rem;">Ответ:</span> @fullName
                                    </h6>
                                    <div class="text-muted small">
                                        <i class="bi bi-book me-1"></i> @sub.CourseMaterial?.Course?.Title 
                                        <span class="mx-1 opacity-50">|</span> 
                                        <i class="bi bi-journal-text me-1"></i> @sub.CourseMaterial?.Title
                                    </div>
                                </div>
                            </div>

                            <!-- Правая часть: Дата, Время и Статус -->
                            <div class="text-sm-end text-start w-100 w-sm-auto">
                                <div class="text-muted small fw-semibold mb-2">
                                    <i class="bi bi-clock me-1"></i> @sub.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </div>
                                <div class="d-flex align-items-center justify-content-sm-end justify-content-between gap-3">
                                    <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-@statusIcon me-1"></i> @statusText
                                    </span>
                                    <span class="small text-primary fw-bold text-nowrap" style="cursor: pointer;">
                                        Открыть чат <i class="bi bi-arrow-right"></i>
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Скрытый блок с HTML чата для модалки (без изменений) -->
                    <div id="archive-chat-data-@sub.Id" style="display: none;">
                        @foreach (var msg in sub.Messages.OrderBy(m => m.CreatedAt))
                        {
                            bool isStudent = msg.AuthorId == sub.StudentId;
                            <div class="chat-bubble @(isStudent ? "student" : "admin")">
                                <div class="chat-sender">@(isStudent ? "Слушатель" : "Вы (Преподаватель)")</div>
                                <div>@msg.TextContent</div>
                                @if (!string.IsNullOrEmpty(msg.FilePath))
                                {
                                    <a href="@msg.FilePath" class="chat-file-link" download>
                                        <i class="bi bi-paperclip"></i> Скачать файл
                                    </a>
                                }
                                <div class="chat-time">@msg.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО ДЛЯ ПРОСМОТРА АРХИВА -->
<div class="modal fade" id="archiveChatModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-light border-0 py-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark" id="archiveModalTitle">История диалога</h5>
                    <small class="text-muted" id="archiveModalSubtitle">Курс: —</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                
                <div class="alert alert-secondary border-0 d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-lock-fill fs-5"></i> 
                    <div>Это архивное обращение. Диалог закрыт, отправка новых сообщений невозможна.</div>
                </div>

                <!-- Контейнер, куда JS будет вставлять чат -->
                <div class="chat-container" id="archiveChatContainer"></div>

            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-light border fw-bold text-secondary rounded-3 px-4" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<script>
    // УВЕДОМЛЕНИЯ (для вкладки Ожидают проверки)
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `custom-toast ${type}`;
        let iconClass = 'bi-check-circle-fill text-success';
        if (type === 'danger') iconClass = 'bi-exclamation-triangle-fill text-danger';
        
        toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
        container.appendChild(toast);
        
        setTimeout(() => {
            toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }

    // ОТКРЫТИЕ АРХИВНОГО ЧАТА
    function openArchiveModal(submissionId) {
        // Находим скрытый блок с сообщениями
        const chatData = document.getElementById(`archive-chat-data-${submissionId}`);
        // Находим строку карточки, чтобы вытащить оттуда текст
        const card = document.querySelector(`.archive-card[onclick="openArchiveModal(${submissionId})"]`);
        
        if (chatData && card) {
            // Копируем HTML сообщений в модалку
            document.getElementById('archiveChatContainer').innerHTML = chatData.innerHTML;
            
            // Заполняем шапку модалки
            const titleText = card.querySelector('h6').innerText;
            const subtitleText = card.querySelector('.text-muted').innerText;
            
            document.getElementById('archiveModalTitle').innerText = titleText;
            document.getElementById('archiveModalSubtitle').innerText = subtitleText;
            
            // Открываем модалку
            new bootstrap.Modal(document.getElementById('archiveChatModal')).show();
            
            // Скроллим вниз, чтобы видеть последние сообщения
            setTimeout(() => {
                const container = document.getElementById('archiveChatContainer');
                container.scrollTop = container.scrollHeight;
            }, 200);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const pendingContainer = document.getElementById('pendingContainer');

        // Обработка отправки формы (вкладка Ожидают)
        if (pendingContainer) {
            pendingContainer.addEventListener('click', async function (e) {
                if (!e.target.classList.contains('submit-review-btn')) return;

                const button = e.target;
                const form = button.closest('.review-assignment-form');
                const reviewTextarea = form.querySelector('textarea[name="reviewText"]');
                const reviewText = reviewTextarea.value.trim();
                
                if (!reviewText) {
                    showToast('Пожалуйста, напишите комментарий!', 'warning');
                    reviewTextarea.focus();
                    return;
                }

                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Отправка...';

                const formData = new FormData(form);

                try {
                    const response = await fetch('/AssignmentReview/Review', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    const result = await response.json();
                    if (result.success) {
                        showToast('Ответ успешно отправлен!', 'success');
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast('Ошибка: ' + result.message, 'danger');
                        button.disabled = false;
                        button.innerHTML = '<i class="bi bi-send-fill me-1"></i> Отправить ответ';
                    }
                } catch (error) {
                    showToast('Сбой сети при отправке данных.', 'danger');
                    button.disabled = false;
                    button.innerHTML = '<i class="bi bi-send-fill me-1"></i> Отправить ответ';
                }
            });
        }

        // Сохранение вкладки
        const triggerTabList = document.querySelectorAll('#assignmentTabs button');
        triggerTabList.forEach(tabEl => {
            tabEl.addEventListener('shown.bs.tab', event => {
                localStorage.setItem('activeAssignmentTab', event.target.id);
            });
        });

        const activeTabId = localStorage.getItem('activeAssignmentTab');
        if (activeTabId) {
            const tabToActivate = document.getElementById(activeTabId);
            if (tabToActivate) {
                bootstrap.Tab.getOrCreateInstance(tabToActivate).show();
            }
        }
    });
</script>