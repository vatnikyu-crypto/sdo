@model IEnumerable<SdoApp.Models.StudentSubmission>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Проверка заданий";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    /* Список тикетов */
    .review-card {
        cursor: pointer; transition: all 0.2s ease; border: 1px solid var(--brand-gray);
        border-radius: 12px; background: #fff; padding: 16px;
    }
    .review-card:hover { background-color: #f8fafc; border-color: var(--brand-primary); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(79, 88, 157, 0.08); }
    .review-card.active { background-color: #f0f4ff; border-color: var(--brand-primary); box-shadow: inset 4px 0 0 var(--brand-primary); }
    
    .avatar-circle {
        width: 48px; height: 48px; border-radius: 50%;
        background: linear-gradient(135deg, #5b64ab 0%, #4F589D 100%);
        color: white; display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1.2rem; flex-shrink: 0; box-shadow: 0 2px 8px rgba(79, 88, 157, 0.25);
    }

    /* Окно чата */
    #reviewChatCard { height: calc(100vh - 150px); min-height: 600px; }
    .chat-box { background-color: #f4f6f9; overflow-y: auto; min-height: 0; }
    .msg-bubble { max-width: 85%; padding: 12px 16px; border-radius: 12px; margin-bottom: 10px; font-size: 0.9rem; }
    .msg-teacher { background-color: var(--brand-primary); color: white; margin-left: auto; border-bottom-right-radius: 2px; box-shadow: 0 2px 8px rgba(79, 88, 157, 0.2); }
    .msg-student { background-color: #fff; color: #333; margin-right: auto; border-bottom-left-radius: 2px; border: 1px solid var(--brand-gray); box-shadow: 0 2px 8px rgba(0,0,0,0.03); }

    .btn-brand { background-color: var(--brand-primary); color: white; border: none; transition: all 0.3s; }
    .btn-brand:hover { background-color: var(--brand-dark); color: white; }

    /* Панель оценки */
    .grade-panel {
        background: #f8fafc; border-top: 1px solid var(--brand-gray); padding: 15px;
    }

    /* === TOASTS === */
    .toast-container-custom {
        position: fixed; top: 20px; right: 20px; z-index: 9999;
        display: flex; flex-direction: column; gap: 10px;
    }
    .custom-toast {
        min-width: 300px; max-width: 400px; background: white;
        border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        display: flex; align-items: center; padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }
    .custom-toast.success { border-left-color: #198754; }
    .custom-toast.danger { border-left-color: #dc3545; }
    .custom-toast.warning { border-left-color: #F59E0B; }
    @@keyframes slideInRight { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes fadeOutRight { from { transform: translateX(0); opacity: 1; } to { transform: translateX(120%); opacity: 0; } }
</style>

<!-- Контейнер для уведомлений -->
<div id="toastContainer" class="toast-container-custom"></div>

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
        <i class="bi bi-clipboard-check text-primary fs-3"></i> Проверка заданий
    </h3>
</div>

<div class="row g-4 mb-5">
    <!-- ЛЕВАЯ КОЛОНКА: СПИСОК РАБОТ -->
    <div class="col-xl-5 col-lg-6">
        <div class="card bg-white border-0 shadow-sm p-4" style="border-radius: 16px; border: 1px solid var(--brand-gray) !important; height: calc(100vh - 150px); min-height: 600px;">
            <div class="input-group input-group-sm mb-3 rounded-3 overflow-hidden border bg-white shadow-sm">
                <span class="input-group-text bg-white text-muted border-0"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control border-0 shadow-none" placeholder="Поиск по студенту или заданию..." autocomplete="off" />
            </div>

            <div class="d-flex flex-column gap-2" id="submissionsList" style="overflow-y: auto; padding-right: 2px;">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-check2-all text-success opacity-50 d-block mb-3" style="font-size: 3rem;"></i>
                        <h6 class="fw-bold mt-2 mb-1 text-dark">Все задания проверены!</h6>
                    </div>
                }
                else
                {
                    foreach (var s in Model)
                    {
                        string statusText = s.Status == SdoApp.Models.SubmissionStatus.OnReview ? "На проверке" :
                                          s.Status == SdoApp.Models.SubmissionStatus.NeedFix ? "На доработке" : "Завершено";
                        
                        string statusClass = s.Status == SdoApp.Models.SubmissionStatus.OnReview ? "bg-warning text-dark" :
                                           s.Status == SdoApp.Models.SubmissionStatus.NeedFix ? "bg-danger" : "bg-success";

                        string firstLetter = s.Student?.LastName?.Substring(0, 1).ToUpper() ?? "?";

                        <div class="review-card" id="submission-card-@s.Id" data-id="@s.Id" onclick="loadSubmission(@s.Id)">
                            <div class="d-flex gap-3 align-items-center">
                                <div class="avatar-circle">@firstLetter</div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-bold text-dark text-truncate" style="font-size:0.95rem;">
                                            @s.Student?.LastName @s.Student?.FirstName
                                        </div>
                                        <span class="badge @statusClass" style="font-size:0.65rem;">@statusText</span>
                                    </div>
                                    <div class="text-muted small text-truncate mb-1">
                                        <i class="bi bi-journal-text me-1"></i> @s.CourseMaterial?.Title
                                    </div>
                                    @if (s.Grade.HasValue)
                                    {
                                        <div class="small fw-bold text-success"><i class="bi bi-star-fill me-1"></i> Оценка: @s.Grade</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: ЧАТ И ОЦЕНКА -->
    <div class="col-xl-7 col-lg-6">
        <!-- Заглушка -->
        <div class="card bg-white border-0 shadow-sm p-4 h-100 d-flex flex-column justify-content-center align-items-center text-center text-muted" id="placeholderCard" style="border-radius: 16px; border: 1px solid var(--brand-gray) !important; height: calc(100vh - 150px); min-height: 600px;">
            <i class="bi bi-chat-left-text text-secondary opacity-50" style="font-size: 4rem;"></i>
            <h5 class="fw-bold mt-3 text-dark">Работа не выбрана</h5>
            <p class="small mb-0">Выберите задание из списка слева, чтобы проверить его.</p>
        </div>

        <!-- Рабочая область -->
        <div class="card bg-white border-0 shadow-sm p-0 d-none d-flex flex-column" id="reviewChatCard" style="border-radius: 16px; border: 1px solid var(--brand-gray) !important; overflow: hidden;">
            
            <!-- Шапка -->
            <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold text-dark m-0" id="chatTitle">Задание</h5>
                    <small class="text-muted" id="chatSubtitle">Студент: —</small>
                </div>
                <div>
                    <span class="badge bg-warning text-dark" id="chatStatusBadge" style="font-size:0.8rem;">—</span>
                </div>
            </div>

            <!-- Чат -->
            <div class="chat-box flex-grow-1 p-4" id="chatContainer"></div>

            <!-- ПАНЕЛЬ ОЦЕНКИ И ОТПРАВКИ -->
            <div class="grade-panel">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <label class="fw-bold text-muted small text-uppercase">Оценка:</label>
                        <select id="gradeSelect" class="form-select form-select-sm fw-bold shadow-sm" style="width: 80px;">
                            <option value="">—</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-success fw-bold" onclick="saveGrade(false)">Сохранить балл</button>
                        <button type="button" class="btn btn-sm btn-success fw-bold" id="btnCloseTask" onclick="saveGrade(true)">Оценить и закрыть</button>
                        
                        <!-- НОВАЯ КНОПКА ДЛЯ ПЕРЕОТКРЫТИЯ -->
                        <button type="button" class="btn btn-sm btn-warning fw-bold d-none" id="btnReopenTask" onclick="reopenTask()">
                            <i class="bi bi-unlock-fill me-1"></i> Открыть заново
                        </button>
                    </div>
                </div>

                <!-- Форма отправки (скрывается при закрытии) -->
                <div id="replyFormContainer">
                    <div id="fileListContainer" class="d-flex flex-wrap gap-2 mb-2 d-none"></div>
                    <div class="d-flex align-items-end bg-white rounded-4 p-2 border shadow-sm gap-2">
                        <textarea id="replyText" class="form-control border-0 bg-transparent shadow-none p-2" rows="2" style="resize: none; max-height: 100px;" placeholder="Напишите ответ студенту..."></textarea>
                        <input type="file" id="replyFiles" class="d-none" multiple />
                        <label for="replyFiles" class="btn btn-light border-0 rounded-circle text-secondary flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; cursor: pointer;" title="Прикрепить файлы">
                            <i class="bi bi-paperclip fs-5"></i>
                        </label>
                        <button type="button" id="sendBtn" class="btn btn-brand rounded-circle flex-shrink-0 shadow-sm d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; padding: 0;" title="Отправить">
                            <i class="bi bi-send-fill fs-5"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // === ФУНКЦИЯ УВЕДОМЛЕНИЙ ===
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `custom-toast ${type}`;
        let iconClass = 'bi-check-circle-fill text-success';
        if (type === 'danger') iconClass = 'bi-exclamation-triangle-fill text-danger';
        if (type === 'warning') iconClass = 'bi-info-circle-fill text-warning';
        
        toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
        container.appendChild(toast);
        
        setTimeout(() => {
            toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }

    let currentSubmissionId = null;
    let selectedFiles = new DataTransfer();
    const fileInput = document.getElementById('replyFiles');
    const fileListContainer = document.getElementById('fileListContainer');

    // Поиск
    document.getElementById('searchInput').addEventListener('input', function() {
        const text = this.value.toLowerCase();
        document.querySelectorAll('.review-card').forEach(card => {
            card.style.display = card.textContent.toLowerCase().includes(text) ? 'block' : 'none';
        });
    });

    // Загрузка задания
    async function loadSubmission(id) {
        currentSubmissionId = id;
        document.querySelectorAll('.review-card').forEach(c => c.classList.remove('active'));
        document.getElementById(`submission-card-${id}`).classList.add('active');

        document.getElementById('placeholderCard').classList.add('d-none');
        document.getElementById('reviewChatCard').classList.remove('d-none');

        try {
            const res = await fetch(`/AssignmentReview/GetDetails/${id}`);
            const data = await res.json();

            document.getElementById('chatTitle').textContent = data.taskTitle;
            document.getElementById('chatSubtitle').textContent = `Студент: ${data.studentName} | Курс: ${data.courseTitle}`;
            
            const statusBadge = document.getElementById('chatStatusBadge');
            if (data.status === 2) { statusBadge.className = 'badge bg-success'; statusBadge.textContent = 'Завершено'; }
            else if (data.status === 1) { statusBadge.className = 'badge bg-danger'; statusBadge.textContent = 'На доработке'; }
            else { statusBadge.className = 'badge bg-warning text-dark'; statusBadge.textContent = 'На проверке'; }

            // Заполняем оценку
            document.getElementById('gradeSelect').value = data.grade || "";

            // Отрисовка чата
            const chatContainer = document.getElementById('chatContainer');
            if (data.messages.length === 0) {
                chatContainer.innerHTML = '<div class="text-center text-muted small py-4">Нет сообщений</div>';
            } else {
                chatContainer.innerHTML = data.messages.map(m => {
                    const bubbleClass = m.isStudent ? 'msg-student' : 'msg-teacher';
                    const nameStyle = m.isStudent ? 'color: #dc3545;' : 'color: rgba(255,255,255,0.8);';
                    
                    let filesHtml = '';
                    if (m.files.length > 0) {
                        filesHtml = '<div class="mt-2 border-top pt-2">' + m.files.map(f => `
                            <a href="${f.url}" download="${f.name}" class="d-inline-flex align-items-center gap-1 badge ${m.isStudent ? 'bg-light text-dark border' : 'bg-white bg-opacity-25 text-white'} me-1 mb-1 text-decoration-none">
                                <i class="bi bi-paperclip"></i> ${f.name}
                            </a>
                        `).join('') + '</div>';
                    }

                    return `
                    <div class="d-flex flex-column w-100">
                        <div class="msg-bubble ${bubbleClass}">
                            <div style="font-size:0.75rem; ${nameStyle}" class="fw-bold mb-1">${m.senderName}</div>
                            <div style="font-size:0.9rem; white-space:pre-line;">${m.text || ''}</div>
                            ${filesHtml}
                        </div>
                        <small class="text-muted mb-3 ${m.isStudent ? 'ps-2' : 'text-end pe-2'}" style="font-size:0.7rem; margin-top:-8px;">${m.createdAt}</small>
                    </div>`;
                }).join('');
            }
            chatContainer.scrollTop = chatContainer.scrollHeight;

            // Блокировка формы и показ кнопок
            const replyForm = document.getElementById('replyFormContainer');
            const btnClose = document.getElementById('btnCloseTask');
            const btnReopen = document.getElementById('btnReopenTask');

            if (data.status === 2) { // ЗАВЕРШЕНО
                replyForm.style.opacity = '0.5';
                replyForm.style.pointerEvents = 'none';
                replyForm.querySelector('textarea').placeholder = "Задание закрыто.";
                btnClose.classList.add('d-none');
                btnReopen.classList.remove('d-none');
            } else {
                replyForm.style.opacity = '1';
                replyForm.style.pointerEvents = 'auto';
                replyForm.querySelector('textarea').placeholder = "Напишите ответ студенту...";
                btnClose.classList.remove('d-none');
                btnReopen.classList.add('d-none');
            }

        } catch (e) {
            console.error(e);
            showToast('Ошибка загрузки задания', 'danger');
        }
    }

    // Файлы
    fileInput.addEventListener('change', function () {
        const newFiles = Array.from(this.files);
        for (let file of newFiles) {
            if (selectedFiles.files.length >= 3) { showToast('Максимум 3 файла', 'warning'); break; }
            selectedFiles.items.add(file);
        }
        if (Array.from(selectedFiles.files).reduce((s, f) => s + f.size, 0) > 75 * 1024 * 1024) {
            showToast('Общий вес более 75 МБ!', 'danger'); selectedFiles = new DataTransfer();
        }
        this.files = selectedFiles.files;
        renderFiles();
    });

    function renderFiles() {
        fileListContainer.innerHTML = '';
        if (selectedFiles.files.length === 0) { fileListContainer.classList.add('d-none'); return; }
        fileListContainer.classList.remove('d-none');
        Array.from(selectedFiles.files).forEach((file, idx) => {
            fileListContainer.innerHTML += `
                <div class="badge bg-white text-dark border px-2 py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-primary"></i> ${file.name}
                    <button type="button" class="btn-close ms-1" style="font-size:0.5rem;" onclick="removeFile(${idx})"></button>
                </div>`;
        });
    }
    window.removeFile = function(idx) {
        const dt = new DataTransfer();
        Array.from(selectedFiles.files).filter((_, i) => i !== idx).forEach(f => dt.items.add(f));
        selectedFiles = dt; fileInput.files = selectedFiles.files; renderFiles();
    };

    // Отправка сообщения
    document.getElementById('sendBtn').addEventListener('click', async function() {
        const text = document.getElementById('replyText').value.trim();
        if (!text && selectedFiles.files.length === 0) {
            showToast('Введите текст или прикрепите файл', 'warning');
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm text-white"></span>';

        const formData = new FormData();
        formData.append('submissionId', currentSubmissionId);
        formData.append('text', text);
        Array.from(selectedFiles.files).forEach(f => formData.append('files', f));

        try {
            const res = await fetch('/AssignmentReview/SendMessage', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                document.getElementById('replyText').value = "";
                selectedFiles = new DataTransfer(); fileInput.value = ""; renderFiles();
                showToast('Сообщение отправлено!', 'success');
                loadSubmission(currentSubmissionId); // Перезагружаем чат
            } else { showToast(data.message, 'danger'); }
        } catch { showToast('Ошибка сети', 'danger'); }
        finally { this.disabled = false; this.innerHTML = '<i class="bi bi-send-fill fs-5"></i>'; }
    });

    // Сохранение оценки
    async function saveGrade(closeChat) {
        const grade = document.getElementById('gradeSelect').value;
        if (!grade) {
            showToast('Сначала выберите оценку', 'warning');
            return;
        }

        const formData = new FormData();
        formData.append('submissionId', currentSubmissionId);
        formData.append('grade', grade);
        formData.append('closeChat', closeChat);
        formData.append('reopenTask', false);

        try {
            const res = await fetch('/AssignmentReview/SetGrade', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                showToast(closeChat ? 'Задание закрыто с оценкой!' : 'Оценка обновлена!', 'success');
                setTimeout(() => window.location.reload(), 1000); 
            } else { showToast(data.message, 'danger'); }
        } catch { showToast('Ошибка сети', 'danger'); }
    }

    // Переоткрытие задания
    async function reopenTask() {
        const formData = new FormData();
        formData.append('submissionId', currentSubmissionId);
        formData.append('grade', '0'); // Заглушка
        formData.append('closeChat', false);
        formData.append('reopenTask', true);

        try {
            const res = await fetch('/AssignmentReview/SetGrade', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                showToast('Задание снова открыто для обсуждения!', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else { showToast(data.message, 'danger'); }
        } catch { showToast('Ошибка сети', 'danger'); }
    }
</script>