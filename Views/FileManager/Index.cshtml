@model SdoApp.Models.ViewModels.FileManagerViewModel
@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Управление файлами";
}

<style>
    .nav-tabs .nav-link { border: none; color: #6c757d; font-weight: 600; padding: 12px 20px; }
    .nav-tabs .nav-link.active { color: var(--brand-primary); border-bottom: 3px solid var(--brand-primary); background: transparent; }
    .table-custom th { font-size: 0.8rem; text-transform: uppercase; color: #6c757d; }
    .file-icon { font-size: 1.5rem; color: var(--brand-primary); }
    
    /* === СТИЛИ ДЛЯ УВЕДОМЛЕНИЙ (TOASTS) === */
    .toast-container-custom {
        position: fixed; top: 20px; right: 20px; z-index: 9999;
        display: flex; flex-direction: column; gap: 10px;
    }
    .custom-toast {
        min-width: 300px; max-width: 400px; background: white;
        border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        display: flex; align-items: center; padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }
    .custom-toast.success { border-left-color: #198754; }
    .custom-toast.danger { border-left-color: #dc3545; }
    @@keyframes slideInRight { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes fadeOutRight { from { transform: translateX(0); opacity: 1; } to { transform: translateX(120%); opacity: 0; } }
</style>

<div id="toastContainer" class="toast-container-custom"></div>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-hdd-network text-primary fs-3"></i> Управление файлами
        </h3>
        <span class="badge bg-secondary fs-6">Всего файлов: @Model.TotalItems</span>
    </div>

    <!-- Вкладки -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "support" ? "active" : "")" href="?tab=support&search=@Model.SearchString">Техподдержка</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "submissions" ? "active" : "")" href="?tab=submissions&search=@Model.SearchString">Задания</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "group_courses" ? "active" : "")" href="?tab=group_courses&search=@Model.SearchString">Файлы курсов</a>
        </li>
    </ul>

    <!-- Поиск -->
    <form method="get" class="mb-4 d-flex gap-2">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        <div class="input-group shadow-sm rounded-3 overflow-hidden border" style="max-width: 400px;">
            <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="search" value="@Model.SearchString" class="form-control border-0 shadow-none" placeholder="Поиск по файлу, ФИО или заданию..." />
            <button type="submit" class="btn btn-primary fw-bold px-3">Найти</button>
            @if (!string.IsNullOrEmpty(Model.SearchString))
            {
                <a href="?tab=@Model.ActiveTab" class="btn btn-light border px-2"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>

    <!-- Таблица -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">Тип</th>
                        <th>Имя файла</th>
                        <th>Привязка</th>
                        <th style="width: 150px;">Дата</th>
                        <th class="text-end pe-4" style="width: 130px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-2 d-block mb-2 opacity-50"></i>
                                Файлы не найдены
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr id="file-row-@item.Id">
                                <td class="text-center"><i class="bi bi-file-earmark-arrow-down file-icon"></i></td>
                                <td class="fw-bold text-dark">@item.FileName</td>
                                <td class="text-muted small">@item.ContextInfo</td>
                                <td class="text-muted small">@item.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="@item.FilePath" download="@item.FileName" class="btn btn-sm btn-outline-primary rounded-3" title="Скачать">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <!-- Вызываем модалку, а не confirm -->
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3" onclick="prepareDeleteFile('@Model.ActiveTab', @item.Id, '@item.FileName')" title="Удалить">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?tab=@Model.ActiveTab&search=@Model.SearchString&page=@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- МОДАЛЬНОЕ ОКНО УДАЛЕНИЯ -->
<div class="modal fade" id="deleteFileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
            <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-danger"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Удаление файла</h5>
            <p class="text-muted small mb-2">Вы действительно хотите навсегда удалить файл:</p>
            <p id="deleteFileNameText" class="fw-bold text-danger mb-4 fs-5" style="word-break: break-all;"></p>
            <div class="d-flex gap-2 justify-content-center">
                <button type="button" class="btn btn-light border fw-bold w-50 rounded-3" data-bs-dismiss="modal">Отмена</button>
                <button id="confirmDeleteFileBtn" type="button" class="btn btn-danger fw-bold w-50 rounded-3">Удалить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Функция показа красивых уведомлений
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `custom-toast ${type}`;
            const iconClass = type === 'success' ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';
            toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // 2. Подготовка к удалению (открытие модалки)
        let fileIdToDelete = null;
        let fileTabToDelete = null;

        function prepareDeleteFile(tab, id, fileName) {
            fileIdToDelete = id;
            fileTabToDelete = tab;
            document.getElementById('deleteFileNameText').textContent = fileName;
            new bootstrap.Modal(document.getElementById('deleteFileModal')).show();
        }

        // 3. Само удаление по кнопке в модалке
        document.getElementById('confirmDeleteFileBtn').addEventListener('click', async function () {
            if (!fileIdToDelete || !fileTabToDelete) return;

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            const formData = new FormData();
            formData.append('tab', fileTabToDelete);
            formData.append('id', fileIdToDelete);

            try {
                const response = await fetch('/FileManager/DeleteFile', { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('deleteFileModal')).hide();
                    showToast('Файл успешно удален', 'success');
                    
                    // Красиво скрываем строку
                    const row = document.getElementById(`file-row-${fileIdToDelete}`);
                    if (row) {
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    showToast('Ошибка: ' + result.message, 'danger');
                }
            } catch (e) {
                showToast('Ошибка сети при удалении', 'danger');
            } finally {
                this.disabled = false;
                this.innerHTML = 'Удалить';
                fileIdToDelete = null;
                fileTabToDelete = null;
            }
        });
    </script>
}