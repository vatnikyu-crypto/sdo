                                                        <script>
                                                            // ==========================================
                                                            // 0. УВЕДОМЛЕНИЯ И ПРЕДПРОСМОТР
                                                            // ==========================================
                                                            function showToast(message, type = 'success') {
                                                                const container = document.getElementById('toastContainer');
                                                                const toast = document.createElement('div');
                                                                toast.className = `custom-toast ${type}`;
                                                                const iconClass = type === 'success' ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';
                                                                toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem;">${message}</div>`;
                                                                container.appendChild(toast);
                                                                setTimeout(() => { toast.style.animation = 'fadeOutRight 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 3500);
                                                            }

                                                            async function copyMaterialLink(btn) {
                                                                const fileUrl = btn.getAttribute('data-file-url');
                                                                if (!fileUrl) return;
                                                                try {
                                                                    await navigator.clipboard.writeText(fileUrl);
                                                                    const icon = btn.querySelector('i');
                                                                    const originalClass = icon.className;
                                                                    icon.className = 'bi bi-check2 text-success';
                                                                    setTimeout(() => { icon.className = originalClass; }, 1500);
                                                                    showToast('Ссылка скопирована', 'success');
                                                                } catch (e) { showToast('Не удалось скопировать', 'danger'); }
                                                            }

                                                            // ==========================================
                                                            // ИНИЦИАЛИЗАЦИЯ QUILL
                                                            // ==========================================
                                                            const quillOptions = {
                                                                theme: 'snow',
                                                                modules: {
                                                                    toolbar: [
                                                                        [{ 'header': [1, 2, 3, 4, 5, 6, false] }], ['bold', 'italic', 'underline', 'strike'],
                                                                        [{ 'color': [] }, { 'background': [] }], [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                                                                        ['link', 'image', 'video'], ['clean']
                                                                    ]
                                                                }
                                                            };

                                                            const addQuill = new Quill('#addQuillEditor', quillOptions);
                                                            const editQuill = new Quill('#editQuillEditor', quillOptions);

                                                            async function togglePreview(id, event) {
                                                                if (event && (event.target.closest('button') || event.target.closest('a') || event.target.closest('.drag-handle'))) {
                                                                    return;
                                                                }

                                                                const container = document.getElementById(`preview-content-${id}`);
                                                                if (container.classList.contains('expanded')) {
                                                                    container.classList.remove('expanded');
                                                                    return;
                                                                }
                                                                document.querySelectorAll('.preview-container.expanded').forEach(el => el.classList.remove('expanded'));

                                                                container.classList.add('expanded');
                                                                container.innerHTML = '<div class="text-center p-4"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Загрузка...</div>';

                                                                try {
                                                                    const response = await fetch(`/CourseMaterials/GetMaterialData/${id}?groupId=@ViewBag.GroupId`);
                                                                    if (!response.ok) throw new Error('Ошибка');
                                                                    const rawData = await response.json();
                                                                    container.innerHTML = '';

                                                                    const data = {};
                                                                    for (let key in rawData) { data[key.toLowerCase()] = rawData[key]; }

                                                                    const mType = parseInt(data.type);
                                                                    const fileUrl = data.fileurl || "";
                                                                    const textContent = data.textcontent || "";

                                                                    if (mType === 0) {
                                                                        container.innerHTML = `<div class="p-3 border bg-white rounded shadow-sm text-dark">${textContent || "Текст пуст."}</div>`;
                                                                    } else if (mType === 1) {
                                                                        container.innerHTML = fileUrl ? `<iframe src="${fileUrl}" width="100%" height="600px" style="border:none; border-radius:6px;"></iframe>` : `<div class="alert alert-warning">Файл не найден.</div>`;
                                                                    } else if (mType === 2) {
                                                                        container.innerHTML = fileUrl ? `<video src="${fileUrl}" controls width="100%" class="rounded shadow-sm" style="max-height:450px; background:#000;"></video>` : `<div class="alert alert-warning">Видео не найдено.</div>`;
                                                                    } else if (mType === 3) {
                                                                        container.innerHTML = fileUrl ? `<div class="text-center bg-white p-2 border rounded shadow-sm"><img src="${fileUrl}" class="img-fluid rounded" style="max-height:500px;" /></div>` : `<div class="alert alert-warning">Картинка не найдена.</div>`;
                                                                    } else if (mType === 4) {
                                                                        container.innerHTML = `<div class="alert alert-primary border-0 mb-0 small shadow-sm">Это блок тестирования. Используйте кнопку <b>"Вопросы"</b> для наполнения.</div>`;
                                                                    } else if (mType === 5) {
                                                                        let filesHtml = "";
                                                                        if (data.files && data.files.length > 0) {
                                                                            filesHtml = `<div class="d-flex flex-column gap-2 mt-3">` + data.files.map(f => `
                                                                                                                                        <a href="${f.url}" download="${f.name}" class="btn btn-sm btn-outline-secondary fw-bold rounded-3 text-start text-truncate" style="max-width: 300px;">
                                                                                                                                            <i class="bi bi-download me-1"></i> ${f.name}
                                                                                                                                        </a>
                                                                                                                                    `).join('') + `</div>`;
                                                                        }
                                                                        container.innerHTML = `
                                                                                                                                    <div class="p-3 border bg-white rounded shadow-sm">
                                                                                                                                        <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-clipboard me-1"></i> Инструкция:</h6>
                                                                                                                                        <p class="text-dark mb-3" style="white-space: pre-line;">${textContent || "Инструкция не указана."}</p>
                                                                                                                                        ${filesHtml}
                                                                                                                                    </div>`;
                                                                    } else if (mType === 6) {
                                                                        container.innerHTML = fileUrl ? `<div class="border rounded shadow-sm bg-white overflow-hidden" style="height: 700px;"><iframe src="${fileUrl}" width="100%" height="100%" style="border:none;" allowfullscreen></iframe></div>` : `<div class="alert alert-warning">SCORM-пакет не найден.</div>`;
                                                                    } else {
                                                                        container.innerHTML = `<div class="alert alert-secondary">Неизвестный тип материала.</div>`;
                                                                    }
                                                                } catch (err) {
                                                                    container.innerHTML = '<div class="text-danger p-3 fw-bold"><i class="bi bi-x-circle me-1"></i> Ошибка загрузки данных.</div>';
                                                                }
                                                            }

                                                            // ==========================================
                                                            // ГЕНЕРАЦИЯ HTML ДЛЯ НОВЫХ ЭЛЕМЕНТОВ
                                                            // ==========================================
                                                            function generateThemeHtml(t) {
                                                                return `
                                                                                                                            <div class="theme-card" id="theme-card-${t.id}">
                                                                                                                                <div class="theme-header">
                                                                                                                                    <div class="theme-title-zone" data-bs-toggle="collapse" data-bs-target="#theme-collapse-${t.id}" aria-expanded="false">
                                                                                                                                        <i class="bi bi-grip-vertical fs-4 drag-handle" onclick="event.stopPropagation();" title="Перетащить тему"></i>
                                                                                                                                        <i class="bi bi-folder2-open text-primary fs-4"></i>
                                                                                                                                        <h5 class="fw-bold text-dark m-0">${t.title}</h5>
                                                                                                                                        <span class="badge bg-secondary rounded-pill theme-materials-count" style="font-size: 0.7rem;">0</span>
                                                                                                                                    </div>
                                                                                                                                                        <div class="d-flex gap-2 align-items-center">
                                                                                <div class="d-flex flex-column gap-1 me-2">
                                                                                    <button class="btn btn-sm btn-light border-0 p-0 px-1" onclick="changeThemeOrder(${t.id}, 'up')" title="Вверх"><i class="bi bi-chevron-up text-muted"></i></button>
                                                                                    <button class="btn btn-sm btn-light border-0 p-0 px-1" onclick="changeThemeOrder(${t.id}, 'down')" title="Вниз"><i class="bi bi-chevron-down text-muted"></i></button>
                                                                                </div>
                                                                                <button class="btn btn-sm btn-outline-success fw-bold" title="Добавить материал в эту тему" onclick="prepareAddMaterial(${t.id})" data-bs-toggle="modal" data-bs-target="#addMaterialModal"><i class="bi bi-plus-lg"></i></button>
                                                                                <button class="btn btn-sm btn-light border text-secondary" title="Редактировать тему" onclick="prepareEditTheme(${t.id}, '${t.title}')" data-bs-toggle="modal" data-bs-target="#editThemeModal"><i class="bi bi-pencil"></i></button>
                                                                                <button class="btn btn-sm btn-light border text-danger" title="Удалить тему" onclick="prepareDeleteTheme(${t.id})" data-bs-toggle="modal" data-bs-target="#deleteThemeModal"><i class="bi bi-trash3"></i></button>
                                                                            </div>
                                                                                                                                </div>
                                                                                                                                <div class="collapse" id="theme-collapse-${t.id}">
                                                                                                                                    <div class="p-3 bg-white">
                                                                                                                                        <div class="text-muted small text-center py-3 fst-italic empty-theme-msg">В этой теме пока нет материалов.</div>
                                                                                                                                        <div class="materials-container" data-theme-id="${t.id}" style="min-height: 20px;"></div>
                                                                                                                                    </div>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                        `;
                                                            }

                                                            function generateMaterialHtml(m) {
                                                                const typeNames = ["Лекция", "PDF-документ", "Видео", "Изображение", "Тест", "Задание", "SCORM-курс"];
                                                                let typeName = typeNames[m.type] || "Неизвестно";
                                                                let testBadges = "";
                                                                let testBtn = "";

                                                                if (m.type === 4) {
                                                                    testBadges = `
                                                                                                                                <span class="test-info-badge"><i class="bi bi-bullseye"></i> ${m.testKind === 0 ? 'Промежуточный' : m.testKind === 1 ? 'Итоговый' : 'Тренажер'}</span>
                                                                                                                                <span class="test-info-badge"><i class="bi bi-clock"></i> ${m.timeLimit > 0 ? m.timeLimit + ' мин' : 'Без лимита'}</span>
                                                                                                                                <span class="test-info-badge"><i class="bi bi-graph-up"></i> ${m.passPercentage}%</span>
                                                                                                                                <span class="test-info-badge"><i class="bi bi-shuffle"></i> ${m.shuffleQuestions ? 'Да' : 'Нет'}</span>
                                                                                                                            `;
                                                                    testBtn = `<a href="/TestConstructor/Index?testId=${m.id}" class="btn btn-sm btn-outline-success fw-bold px-3" title="Вопросы"><i class="bi bi-list-check"></i> Вопросы</a>`;
                                                                }

                                                                return `
                                                                                                                            <div class="material-card" id="material-item-${m.id}">
                                                                                                                                <div class="p-3" onclick="togglePreview(${m.id}, event)">
                                                                                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                                                                                        <div class="d-flex align-items-center gap-3">
                                                                                                                                            <i class="bi bi-grip-vertical fs-5 drag-handle" onclick="event.stopPropagation();" title="Перетащить"></i>
                                                                                                                                            <div class="d-flex flex-column gap-1" onclick="event.stopPropagation();">
                                                                                                                                                <button class="btn btn-sm btn-light border-0 p-1" onclick="changeOrder(${m.id}, 'up')" title="Вверх"><i class="bi bi-chevron-up text-muted"></i></button>
                                                                                                                                                <button class="btn btn-sm btn-light border-0 p-1" onclick="changeOrder(${m.id}, 'down')" title="Вниз"><i class="bi bi-chevron-down text-muted"></i></button>
                                                                                                                                            </div>
                                                                                                                                            <div>
                                                                                                                                                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                                                                                                                    <span class="badge bg-secondary type-badge text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">${typeName}</span>
                                                                                                                                                    ${testBadges}
                                                                                                                                                </div>
                                                                                                                                                <h6 class="fw-bold text-dark mb-0">${m.title}</h6>
                                                                                                                                            </div>
                                                                                                                                        </div>
                                                                                                                                        <div class="d-flex gap-2" onclick="event.stopPropagation();">
                                                                                                                                            ${testBtn}
                                                                                                                                            <button class="btn btn-sm btn-light border text-secondary" onclick="prepareEditMaterial(${m.id})" data-bs-toggle="modal" data-bs-target="#editMaterialModal" title="Редактировать"><i class="bi bi-pencil"></i></button>
                                                                                                                                            <button class="btn btn-sm btn-light border text-danger" onclick="prepareDeleteMaterial(${m.id}, '${m.title}')" data-bs-toggle="modal" data-bs-target="#deleteMaterialModal" title="Удалить"><i class="bi bi-trash3"></i></button>
                                                                                                                                        </div>
                                                                                                                                    </div>
                                                                                                                                    <div class="preview-container" id="preview-content-${m.id}"></div>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                        `;
                                                            }

                                                            // ==========================================
                                                            // 1. УПРАВЛЕНИЕ ТЕМАМИ
                                                            // ==========================================
                                                            async function submitCreateTheme() {
                                                                const title = document.getElementById('newThemeTitle').value.trim();
                                                                if (!title) return showToast('Введите название темы!', 'danger');
                                                                const params = new URLSearchParams();
                                                                params.append('courseId', '@Model.Id');
                                                                params.append('title', title);
                                                                try {
                                                                    const response = await fetch('/CourseMaterials/CreateTheme', { method: 'POST', body: params });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        showToast('Тема создана!', 'success');
                
                                                                        const container = document.getElementById('themesContainer');
                                                                        const emptyState = document.getElementById('emptyCourseState');
                                                                        if (emptyState) emptyState.remove();

                                                                        container.insertAdjacentHTML('beforeend', generateThemeHtml(result));
                
                                                                        bootstrap.Modal.getInstance(document.getElementById('addThemeModal')).hide();
                                                                        document.getElementById('newThemeTitle').value = '';
                
                                                                        initSortable();
                                                                    }
                                                                    else { showToast(result.message, 'danger'); }
                                                                } catch { showToast('Ошибка сети', 'danger'); }
                                                            }

                                                            let themeIdToDelete = null;
                                                            function prepareDeleteTheme(id) { themeIdToDelete = id; }

                                                            document.getElementById('confirmDeleteThemeBtn').addEventListener('click', async function () {
                                                                this.disabled = true;
                                                                try {
                                                                    const response = await fetch(`/CourseMaterials/DeleteTheme/${themeIdToDelete}`, { method: 'POST' });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        showToast('Тема удалена. Материалы перенесены в "Без темы".', 'success');
                
                                                                        const themeEl = document.getElementById(`theme-card-${themeIdToDelete}`);
                                                                        if (themeEl) {
                                                                            const materials = Array.from(themeEl.querySelectorAll('.material-card'));
                                                                            if (materials.length > 0) {
                                                                                let orphanContainer = document.querySelector('.materials-container[data-theme-id=""]');
                                                                                let orphanThemeCard = document.getElementById('theme-card-none');
                        
                                                                                if (!orphanContainer) {
                                                                                    const themesContainer = document.getElementById('themesContainer');
                                                                                    const orphanHtml = `
                                                                                                                                                <div class="theme-card border-warning" id="theme-card-none">
                                                                                                                                                    <div class="theme-header bg-warning bg-opacity-10">
                                                                                                                                                        <div class="theme-title-zone" data-bs-toggle="collapse" data-bs-target="#theme-collapse-none" aria-expanded="true">
                                                                                                                                                            <i class="bi bi-inbox text-warning fs-4"></i>
                                                                                                                                                            <h5 class="fw-bold text-dark m-0">Материалы без темы</h5>
                                                                                                                                                            <span class="badge bg-secondary rounded-pill theme-materials-count" style="font-size: 0.7rem;">0</span>
                                                                                                                                                        </div>
                                                                                                                                                        <div class="d-flex gap-2 align-items-center">
                                                                                                                                        <!-- НОВАЯ КНОПКА "+" ДЛЯ БЛОКА БЕЗ ТЕМЫ -->
                                                                                                                                        <button class="btn btn-sm btn-outline-success fw-bold" title="Добавить материал без темы" onclick="prepareAddMaterial('')" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                                                                                                                                            <i class="bi bi-plus-lg"></i>
                                                                                                                                        </button>
                                                                                                                                    </div>
                                                                                                                                                    </div>
                                                                                                                                                    <div class="collapse show" id="theme-collapse-none">
                                                                                                                                                        <div class="p-3 bg-white">
                                                                                                                                                            <div class="text-muted small text-center py-3 fst-italic empty-theme-msg" style="display:none;">В этом разделе пока нет материалов.</div>
                                                                                                                                                            <div class="materials-container" data-theme-id="" style="min-height: 20px;"></div>
                                                                                                                                                        </div>
                                                                                                                                                    </div>
                                                                                                                                                </div>
                                                                                                                                            `;
                                                                                    themesContainer.insertAdjacentHTML('beforeend', orphanHtml);
                                                                                    orphanContainer = document.querySelector('.materials-container[data-theme-id=""]');
                                                                                    orphanThemeCard = document.getElementById('theme-card-none');
                                                                                }
                        
                                                                                materials.forEach(m => orphanContainer.appendChild(m));
                        
                                                                                const emptyMsg = orphanContainer.previousElementSibling;
                                                                                if (emptyMsg) emptyMsg.style.display = 'none';
                                                                                const countBadge = orphanThemeCard.querySelector('.theme-materials-count');
                                                                                if (countBadge) countBadge.textContent = orphanContainer.querySelectorAll('.material-card').length;
                                                                            }
                                                                            themeEl.remove();
                                                                        }
                
                                                                        bootstrap.Modal.getInstance(document.getElementById('deleteThemeModal')).hide();
                                                                        initSortable();
                                                                        saveThemeStructure();
                                                                        saveMaterialStructure();
                                                                    }
                                                                    else { this.disabled = false; }
                                                                } catch { this.disabled = false; showToast('Ошибка сети', 'danger'); }
                                                            });

                                                            function prepareEditTheme(id, title) {
                                                                document.getElementById('editThemeId').value = id;
                                                                document.getElementById('editThemeTitle').value = title;
                                                            }

                                                            async function submitEditTheme() {
                                                                const id = document.getElementById('editThemeId').value;
                                                                const title = document.getElementById('editThemeTitle').value.trim();
                                                                if (!title) return showToast('Введите название темы!', 'danger');
                                                                const params = new URLSearchParams();
                                                                params.append('id', id);
                                                                params.append('title', title);
                                                                try {
                                                                    const response = await fetch('/CourseMaterials/EditTheme', { method: 'POST', body: params });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        showToast('Тема обновлена!', 'success');
                                                                        const themeCard = document.getElementById(`theme-card-${id}`);
                                                                        if (themeCard) {
                                                                            themeCard.querySelector('.theme-title-zone h5').textContent = title;
                                                                        }
                                                                        bootstrap.Modal.getInstance(document.getElementById('editThemeModal')).hide();
                                                                    }
                                                                    else { showToast(result.message, 'danger'); }
                                                                } catch { showToast('Ошибка сети', 'danger'); }
                                                            }

                                                            // ==========================================
                                                            // ПЕРЕМЕЩЕНИЕ СТРЕЛКАМИ
                                                            // ==========================================
                                                            async function changeThemeOrder(id, direction) {
                                                                const params = new URLSearchParams();
                                                                params.append("id", id);
                                                                params.append("direction", direction);
                                                                try {
                                                                    const response = await fetch('/CourseMaterials/ChangeThemeOrder', { method: 'POST', body: params });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        const el = document.getElementById(`theme-card-${id}`);
                                                                        if (direction === 'up' && el.previousElementSibling) {
                                                                            el.parentNode.insertBefore(el, el.previousElementSibling);
                                                                        } else if (direction === 'down' && el.nextElementSibling) {
                                                                            el.parentNode.insertBefore(el.nextElementSibling, el);
                                                                        }
                                                                    } else {
                                                                        showToast(result.message, 'danger');
                                                                    }
                                                                } catch { showToast('Ошибка сети', 'danger'); }
                                                            }

                                                            async function changeOrder(id, direction) {
                                                                const params = new URLSearchParams();
                                                                params.append("id", id);
                                                                params.append("direction", direction);
                                                                try {
                                                                    const response = await fetch('/CourseMaterials/ChangeOrder', { method: 'POST', body: params });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        const el = document.getElementById(`material-item-${id}`);
                                                                        if (direction === 'up' && el.previousElementSibling) {
                                                                            el.parentNode.insertBefore(el, el.previousElementSibling);
                                                                        } else if (direction === 'down' && el.nextElementSibling) {
                                                                            el.parentNode.insertBefore(el.nextElementSibling, el);
                                                                        }
                                                                    } else {
                                                                        showToast(result.message, 'danger');
                                                                    }
                                                                } catch { showToast('Ошибка сети', 'danger'); }
                                                            }

                                                            // ==========================================
                                                            // 2. СОЗДАНИЕ МАТЕРИАЛА
                                                            // ==========================================
                                                            let addAssignmentFiles = new DataTransfer();
    
                                                            document.getElementById("materialType").addEventListener("change", function () {
                                                                const val = this.value;
                                                                const textBlock = document.getElementById("textBlock");
                                                                const fileBlock = document.getElementById("fileBlock");
                                                                const fileLabel = document.getElementById("fileLabel");
                                                                const fileInput = document.getElementById("uploadedFileInput");
                                                                const testSettingsBlock = document.getElementById("testSettingsBlock");
                                                                const externalLinkBlock = document.getElementById("externalLinkBlock");
                                                                const externalToggle = document.getElementById("useExternalLinkAdd");
                                                                const externalContainer = document.getElementById("externalLinkInputContainerAdd");
                                                                const externalUrlInput = document.getElementById("externalFileUrlAdd");
                                                                const assignmentFilesBlock = document.getElementById("assignmentFilesBlock");

                                                                textBlock.classList.add("d-none");
                                                                fileBlock.classList.add("d-none");
                                                                testSettingsBlock.classList.add("d-none");
                                                                externalLinkBlock.classList.add("d-none");
                                                                assignmentFilesBlock.classList.add("d-none");
                                                                fileInput.required = false;
                                                                fileInput.value = "";
                                                                externalToggle.checked = false;
                                                                externalContainer.classList.add("d-none");
                                                                externalUrlInput.value = '';
                                                                externalUrlInput.required = false;

                                                                if (val === "0") {
                                                                    textBlock.classList.remove("d-none");
                                                                }
                                                                else if (val === "1" || val === "2" || val === "3") {
                                                                    fileBlock.classList.remove("d-none");
                                                                    fileInput.required = true;
                                                                    if (val === "1") { fileLabel.innerHTML = "ВЫБЕРИТЕ PDF <span class='text-danger'>*</span>"; fileInput.accept = ".pdf"; }
                                                                    else if (val === "2") { fileLabel.innerHTML = "ВЫБЕРИТЕ ВИДЕО <span class='text-danger'>*</span>"; fileInput.accept = "video/mp4, video/webm"; }
                                                                    else { fileLabel.innerHTML = "ВЫБЕРИТЕ ИЗОБРАЖЕНИЕ <span class='text-danger'>*</span>"; fileInput.accept = ".jpg,.jpeg,.png,.webp"; }
                                                                    externalLinkBlock.classList.remove("d-none");
                                                                }
                                                                else if (val === "4") { testSettingsBlock.classList.remove("d-none"); }
                                                                else if (val === "5") {
                                                                    textBlock.classList.remove("d-none");
                                                                    assignmentFilesBlock.classList.remove("d-none");
                                                                }
                                                                else if (val === "6") {
                                                                    fileBlock.classList.remove("d-none");
                                                                    fileInput.required = true;
                                                                    fileLabel.innerHTML = "ВЫБЕРИТЕ SCORM-АРХИВ <span class='text-danger'>*</span>";
                                                                    fileInput.accept = ".zip, application/zip";
                                                                }
                                                            });

                                                            document.getElementById('useExternalLinkAdd').addEventListener('change', function () {
                                                                const fileBlock = document.getElementById("fileBlock");
                                                                const fileInput = document.getElementById("uploadedFileInput");
                                                                const container = document.getElementById("externalLinkInputContainerAdd");
                                                                const urlInput = document.getElementById("externalFileUrlAdd");
                                                                if (this.checked) {
                                                                    fileBlock.classList.add('d-none'); fileInput.required = false; fileInput.value = '';
                                                                    container.classList.remove('d-none'); urlInput.required = true;
                                                                } else {
                                                                    fileBlock.classList.remove('d-none'); fileInput.required = true;
                                                                    container.classList.add('d-none'); urlInput.required = false; urlInput.value = '';
                                                                }
                                                            });

                                                            document.getElementById('enableTimeLimit').addEventListener('change', function () {
                                                                const container = document.getElementById('timeLimitInputContainer');
                                                                if (this.checked) { container.classList.remove('d-none'); container.classList.add('d-flex'); }
                                                                else { container.classList.add('d-none'); container.classList.remove('d-flex'); }
                                                            });

                                                            document.getElementById('assignmentFilesInput').addEventListener('change', function () {
                                                                const newFiles = Array.from(this.files);
                                                                for (let file of newFiles) {
                                                                    if (addAssignmentFiles.files.length >= 3) { showToast('Максимум 3 файла', 'warning'); break; }
                                                                    addAssignmentFiles.items.add(file);
                                                                }
                                                                if (Array.from(addAssignmentFiles.files).reduce((s, f) => s + f.size, 0) > 75 * 1024 * 1024) {
                                                                    showToast('Общий вес более 75 МБ!', 'danger'); addAssignmentFiles = new DataTransfer();
                                                                }
                                                                this.files = addAssignmentFiles.files;
                                                                renderAddFiles();
                                                            });

                                                            function renderAddFiles() {
                                                                const container = document.getElementById('addAssignmentFilesList');
                                                                container.innerHTML = '';
                                                                if (addAssignmentFiles.files.length === 0) { container.classList.add('d-none'); return; }
                                                                container.classList.remove('d-none');
                                                                Array.from(addAssignmentFiles.files).forEach((file, idx) => {
                                                                    container.innerHTML += `
                                                                                                                                <div class="badge bg-light text-dark border px-2 py-2 d-flex align-items-center gap-2">
                                                                                                                                    <i class="bi bi-file-earmark-text text-primary"></i> ${file.name}
                                                                                                                                    <button type="button" class="btn-close ms-1" style="font-size:0.5rem;" onclick="removeAddFile(${idx})"></button>
                                                                                                                                </div>`;
                                                                });
                                                            }
                                                            window.removeAddFile = function (idx) {
                                                                const dt = new DataTransfer();
                                                                Array.from(addAssignmentFiles.files).filter((_, i) => i !== idx).forEach(f => dt.items.add(f));
                                                                addAssignmentFiles = dt; document.getElementById('assignmentFilesInput').files = addAssignmentFiles.files; renderAddFiles();
                                                            };

                                                            document.getElementById('submitMaterialBtn').addEventListener('click', async function () {
                                                                const form = document.getElementById('addMaterialForm');
                                                                if (!form.checkValidity()) { form.reportValidity(); return; }

                                                                document.getElementById('addTextContentHidden').value = addQuill.root.innerHTML;
                                                                if (!document.getElementById('enableTimeLimit').checked) {
                                                                    document.getElementById('timeLimit').value = "0";
                                                                }

                                                                this.disabled = true;
                                                                this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Сохранение...';
                                                                try {
                                                                    const response = await fetch('/CourseMaterials/Create', { method: 'POST', body: new FormData(form) });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        showToast('Материал добавлен!', 'success');
                
                                                                        const targetThemeId = result.themeId ? result.themeId.toString() : "";
                                                                        const container = document.querySelector(`.materials-container[data-theme-id="${targetThemeId}"]`);
                
                                                                        if (container) {
                                                                            const emptyMsg = container.previousElementSibling;
                                                                            if (emptyMsg && emptyMsg.classList.contains('empty-theme-msg')) {
                                                                                emptyMsg.style.display = 'none';
                                                                            }
                                                                            container.insertAdjacentHTML('beforeend', generateMaterialHtml(result));
                    
                                                                            const themeCard = container.closest('.theme-card');
                                                                            if (themeCard) {
                                                                                const collapseEl = themeCard.querySelector('.collapse');
                                                                                if (collapseEl && !collapseEl.classList.contains('show')) {
                                                                                    new bootstrap.Collapse(collapseEl, { toggle: true });
                                                                                }
                                                                                const countBadge = themeCard.querySelector('.theme-materials-count');
                                                                                if (countBadge) countBadge.textContent = container.querySelectorAll('.material-card').length;
                                                                            }
                                                                        }

                                                                        bootstrap.Modal.getInstance(document.getElementById('addMaterialModal')).hide();
                                                                        document.getElementById('addMaterialForm').reset();
                                                                        addQuill.root.innerHTML = '';
                                                                        addAssignmentFiles = new DataTransfer();
                                                                        renderAddFiles();
                
                                                                        initSortable();
                                                                        saveMaterialStructure(); // Обновляем порядок на сервере
                                                                    }
                                                                    else { showToast(result.message, 'danger'); this.disabled = false; this.innerHTML = 'Сохранить'; }
                                                                } catch { showToast('Ошибка сети', 'danger'); this.disabled = false; this.innerHTML = 'Сохранить'; }
                                                            });

                                                            // ==========================================
                                                            // 3. РЕДАКТИРОВАНИЕ МАТЕРИАЛА
                                                            // ==========================================
                                                            let editAssignmentFiles = new DataTransfer();

                                                            async function prepareEditMaterial(id) {
                                                                const form = document.getElementById("editMaterialForm");
                                                                form.reset();
                                                                document.getElementById("editTextBlock").classList.add("d-none");
                                                                document.getElementById("editFileBlock").classList.add("d-none");
                                                                document.getElementById("editTestSettingsBlock").classList.add("d-none");
                                                                document.getElementById("editExternalLinkBlock").classList.add("d-none");
                                                                document.getElementById("editAssignmentFilesBlock").classList.add("d-none");

                                                                document.getElementById('useExternalLinkEdit').checked = false;
                                                                document.getElementById('externalLinkInputContainerEdit').classList.add('d-none');
                                                                document.getElementById('externalFileUrlEdit').value = '';
                                                                document.getElementById('externalFileUrlEdit').required = false;
                                                                document.getElementById('editUploadedFileInput').required = false;

                                                                document.getElementById("existingAssignmentFilesList").innerHTML = "";
                                                                document.getElementById("editAssignmentFilesList").innerHTML = "";
                                                                document.getElementById("editAssignmentFilesList").classList.add("d-none");
                                                                editAssignmentFiles = new DataTransfer();
                                                                document.getElementById('editAssignmentFilesInput').value = "";

                                                                try {
                                                                    const response = await fetch(`/CourseMaterials/GetMaterialData/${id}?groupId=@ViewBag.GroupId`);
                                                                    const data = await response.json();

                                                                    document.getElementById("editMaterialId").value = data.id;
                                                                    document.getElementById("editMaterialTitle").value = data.title;
                                                                    document.getElementById("editMaterialThemeId").value = data.themeId || "";

                                                                    const types = ["Лекция", "PDF", "Видео", "Картинка", "Тест", "Задание", "SCORM-пакет"];
                                                                    document.getElementById("editMaterialTypeLabel").value = types[data.type] || "Неизвестно";

                                                                    if (data.type === 0) {
                                                                        document.getElementById("editTextBlock").classList.remove("d-none");
                                                                        editQuill.root.innerHTML = data.textContent || "";
                                                                    }
                                                                    else if (data.type === 1 || data.type === 2 || data.type === 3) {
                                                                        document.getElementById("editFileBlock").classList.remove("d-none");
                                                                        document.getElementById("editExternalLinkBlock").classList.remove("d-none");

                                                                        if (data.type === 1) document.getElementById("editUploadedFileInput").accept = ".pdf";
                                                                        else if (data.type === 2) document.getElementById("editUploadedFileInput").accept = "video/mp4, video/webm";
                                                                        else document.getElementById("editUploadedFileInput").accept = ".jpg,.jpeg,.png,.webp";

                                                                        const toggle = document.getElementById('useExternalLinkEdit');
                                                                        const urlContainer = document.getElementById('externalLinkInputContainerEdit');
                                                                        const urlInput = document.getElementById('externalFileUrlEdit');
                                                                        const fileBlockEl = document.getElementById('editFileBlock');
                                                                        const fileInputEl = document.getElementById('editUploadedFileInput');

                                                                        if (data.isExternal) {
                                                                            toggle.checked = true; urlContainer.classList.remove('d-none'); urlInput.value = data.fileUrl || ''; urlInput.required = true;
                                                                            fileBlockEl.classList.add('d-none'); fileInputEl.required = false;
                                                                        } else {
                                                                            toggle.checked = false; urlContainer.classList.add('d-none'); urlInput.value = ''; urlInput.required = false;
                                                                            fileBlockEl.classList.remove('d-none');
                                                                        }
                                                                    }
                                                                    else if (data.type === 4) {
                                                                        document.getElementById("editTestSettingsBlock").classList.remove("d-none");
                                                                        document.getElementById("editTestKind").value = data.testKind;
                                                                        document.getElementById("editPassPercentage").value = data.passPercentage;
                                                                        document.getElementById("editQuestionsCountToUse").value = data.questionsCountToUse;

                                                                        const timeLimitCheck = document.getElementById("editEnableTimeLimit");
                                                                        const timeLimitContainer = document.getElementById("editTimeLimitInputContainer");
                                                                        if (data.timeLimit > 0) {
                                                                            timeLimitCheck.checked = true;
                                                                            timeLimitContainer.classList.remove("d-none"); timeLimitContainer.classList.add("d-flex");
                                                                            document.getElementById("editTimeLimit").value = data.timeLimit;
                                                                        } else {
                                                                            timeLimitCheck.checked = false;
                                                                            timeLimitContainer.classList.add("d-none"); timeLimitContainer.classList.remove("d-flex");
                                                                            document.getElementById("editTimeLimit").value = "";
                                                                        }
                                                                        document.getElementById("editShuffleQuestions").checked = data.shuffleQuestions;
                                                                    }
                                                                    else if (data.type === 5) {
                                                                        document.getElementById("editTextBlock").classList.remove("d-none");
                                                                        document.getElementById("editAssignmentFilesBlock").classList.remove("d-none");
                                                                        editQuill.root.innerHTML = data.textContent || "";
                
                                                                        if (data.files && data.files.length > 0) {
                                                                            data.files.forEach(f => {
                                                                                document.getElementById("existingAssignmentFilesList").innerHTML += `
                                                                                                                                            <div class="badge bg-light text-dark border px-2 py-2 d-flex align-items-center gap-2" id="existing-file-${f.id}">
                                                                                                                                                <input type="hidden" name="keptFileIds" value="${f.id}" />
                                                                                                                                                <i class="bi bi-paperclip"></i> ${f.name}
                                                                                                                                                <button type="button" class="btn-close ms-1" style="font-size:0.5rem;" onclick="document.getElementById('existing-file-${f.id}').remove()"></button>
                                                                                                                                            </div>`;
                                                                            });
                                                                        }
                                                                    }
                                                                    else if (data.type === 6) {
                                                                        document.getElementById("editFileBlock").classList.remove("d-none");
                                                                        document.getElementById("editUploadedFileInput").accept = ".zip, application/zip";
                                                                    }
                                                                } catch { showToast('Ошибка загрузки данных.', 'danger'); }
                                                            }

                                                            document.getElementById('editAssignmentFilesInput').addEventListener('change', function () {
                                                                const newFiles = Array.from(this.files);
                                                                const keptCount = document.querySelectorAll('#existingAssignmentFilesList input[name="keptFileIds"]').length;

                                                                for (let file of newFiles) {
                                                                    if (keptCount + editAssignmentFiles.files.length >= 3) {
                                                                        showToast('Максимум 3 файла (с учётом уже загруженных)', 'warning');
                                                                        break;
                                                                    }
                                                                    editAssignmentFiles.items.add(file);
                                                                }

                                                                if (Array.from(editAssignmentFiles.files).reduce((s, f) => s + f.size, 0) > 75 * 1024 * 1024) {
                                                                    showToast('Общий вес новых файлов более 75 МБ!', 'danger');
                                                                    editAssignmentFiles = new DataTransfer();
                                                                }

                                                                this.files = editAssignmentFiles.files;
                                                                renderEditFiles();
                                                            });

                                                            function renderEditFiles() {
                                                                const container = document.getElementById('editAssignmentFilesList');
                                                                container.innerHTML = '';
                                                                if (editAssignmentFiles.files.length === 0) { container.classList.add('d-none'); return; }
                                                                container.classList.remove('d-none');
                                                                Array.from(editAssignmentFiles.files).forEach((file, idx) => {
                                                                    container.innerHTML += `
                                                                                                                                <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-2 d-flex align-items-center gap-2">
                                                                                                                                    <i class="bi bi-file-earmark-plus"></i> ${file.name}
                                                                                                                                    <button type="button" class="btn-close ms-1" style="font-size:0.5rem;" onclick="removeEditFile(${idx})"></button>
                                                                                                                                </div>`;
                                                                });
                                                            }

                                                            window.removeEditFile = function (idx) {
                                                                const dt = new DataTransfer();
                                                                Array.from(editAssignmentFiles.files).filter((_, i) => i !== idx).forEach(f => dt.items.add(f));
                                                                editAssignmentFiles = dt;
                                                                document.getElementById('editAssignmentFilesInput').files = editAssignmentFiles.files;
                                                                renderEditFiles();
                                                            };

                                                            document.getElementById('useExternalLinkEdit').addEventListener('change', function () {
                                                                const fileBlock = document.getElementById("editFileBlock");
                                                                const fileInput = document.getElementById("editUploadedFileInput");
                                                                const container = document.getElementById("externalLinkInputContainerEdit");
                                                                const urlInput = document.getElementById("externalFileUrlEdit");
                                                                if (this.checked) {
                                                                    fileBlock.classList.add('d-none'); fileInput.required = false; fileInput.value = '';
                                                                    container.classList.remove('d-none'); urlInput.required = true;
                                                                } else {
                                                                    fileBlock.classList.remove('d-none'); fileInput.required = false;
                                                                    container.classList.add('d-none'); urlInput.required = false; urlInput.value = '';
                                                                }
                                                            });

                                                            document.getElementById('editEnableTimeLimit').addEventListener('change', function () {
                                                                const container = document.getElementById('editTimeLimitInputContainer');
                                                                if (this.checked) { container.classList.remove('d-none'); container.classList.add('d-flex'); }
                                                                else { container.classList.add('d-none'); container.classList.remove('d-flex'); }
                                                            });

                                                            document.getElementById('submitEditMaterialBtn').addEventListener("click", async function () {
                                                                const form = document.getElementById("editMaterialForm");
                                                                document.getElementById('editTextContentHidden').value = editQuill.root.innerHTML;
                                                                if (!document.getElementById('editEnableTimeLimit').checked) {
                                                                    document.getElementById('editTimeLimit').value = "0";
                                                                }

                                                                this.disabled = true;
                                                                this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Сохранение...';
                                                                try {
                                                                    const response = await fetch('/CourseMaterials/Edit', { method: 'POST', body: new FormData(form) });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        showToast('Изменения сохранены!', 'success');
                                                                        const materialId = document.getElementById('editMaterialId').value;
                                                                        const newTitle = document.getElementById('editMaterialTitle').value;
                
                                                                        const card = document.getElementById(`material-item-${materialId}`);
                                                                        if (card) {
                                                                            card.querySelector('h6').textContent = newTitle;
                                                                        }
                
                                                                        bootstrap.Modal.getInstance(document.getElementById('editMaterialModal')).hide();
                                                                    }
                                                                    else { showToast(result.message, 'danger'); this.disabled = false; this.innerHTML = 'Сохранить'; }
                                                                } catch { showToast('Ошибка сети', 'danger'); this.disabled = false; this.innerHTML = 'Сохранить'; }
                                                            });

                                                            // ==========================================
                                                            // 4. УДАЛЕНИЕ МАТЕРИАЛОВ (БЕЗ ПЕРЕЗАГРУЗКИ)
                                                            // ==========================================
                                                            let idToDelete = null;
                                                            function prepareDeleteMaterial(id, label) { idToDelete = id; document.getElementById("deleteMaterialNameText").textContent = label; }

                                                            document.getElementById("confirmDeleteMaterialBtn").addEventListener("click", async function () {
                                                                this.disabled = true;
                                                                try {
                                                                    const response = await fetch(`/CourseMaterials/Delete/${idToDelete}`, { method: 'POST' });
                                                                    const result = await response.json();
                                                                    if (result.success) {
                                                                        showToast('Материал удален!', 'success');
                
                                                                        const el = document.getElementById(`material-item-${idToDelete}`);
                                                                        if (el) {
                                                                            const container = el.closest('.materials-container');
                                                                            el.remove();
                    
                                                                            if (container) {
                                                                                const emptyMsg = container.previousElementSibling;
                                                                                if (emptyMsg && emptyMsg.classList.contains('empty-theme-msg')) {
                                                                                    const hasItems = container.querySelectorAll('.material-card').length > 0;
                                                                                    emptyMsg.style.display = hasItems ? 'none' : '';
                                                                                }
                        
                                                                                const themeCard = container.closest('.theme-card');
                                                                                if (themeCard) {
                                                                                    const countBadge = themeCard.querySelector('.theme-materials-count');
                                                                                    if (countBadge) {
                                                                                        countBadge.textContent = container.querySelectorAll('.material-card').length;
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                        bootstrap.Modal.getInstance(document.getElementById('deleteMaterialModal')).hide();
                                                                        initSortable();
                                                                        saveMaterialStructure(); // Обновляем порядок на сервере
                                                                    } else {
                                                                        showToast(result.message, 'danger');
                                                                    }
                                                                } catch {
                                                                    showToast('Ошибка сети', 'danger');
                                                                } finally {
                                                                    this.disabled = false;
                                                                }
                                                            });

                                                            // ==========================================
                                                            // 5. СКАЧИВАНИЕ МАТЕРИАЛА
                                                            // ==========================================
                                                            async function downloadMaterial(id, btn) {
                                                                const originalHtml = btn.innerHTML;
                                                                btn.disabled = true;
                                                                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                                                                try {
                                                                    const response = await fetch(`/CourseMaterials/DownloadMaterial/${id}`);
                                                                    if (!response.ok) throw new Error('Ошибка сервера');
                                                                    const blob = await response.blob();
                                                                    let fileName = `material_${id}`;
                                                                    const cd = response.headers.get('Content-Disposition') || '';
            
                                                                    const utf8Match = cd.match(/filename\*=UTF-8''([^;]+)/i);
                                                                    if (utf8Match && utf8Match[1]) fileName = decodeURIComponent(utf8Match[1]);
                                                                    else {
                                                                        const simpleMatch = cd.match(/filename="?([^";]+)"?/i);
                                                                        if (simpleMatch && simpleMatch[1]) fileName = simpleMatch[1];
                                                                    }

                                                                    const url = URL.createObjectURL(blob);
                                                                    const a = document.createElement('a');
                                                                    a.href = url; a.download = fileName;
                                                                    document.body.appendChild(a); a.click(); document.body.removeChild(a);
                                                                    URL.revokeObjectURL(url);
                                                                    if (typeof showToast === 'function') showToast('Скачивание началось!', 'success');
                                                                } catch (error) {
                                                                    if (typeof showToast === 'function') showToast('Не удалось скачать файл.', 'danger');
                                                                } finally {
                                                                    btn.disabled = false;
                                                                    btn.innerHTML = originalHtml;
                                                                }
                                                            }

                                                            // ==========================================
                                                            // 6. DRAG AND DROP (ПЕРЕТАСКИВАНИЕ И АВТОСОХРАНЕНИЕ)
                                                            // ==========================================
                                                            function initSortable() {
                                                                document.querySelectorAll('.materials-container').forEach(el => {
                                                                    if (el.sortableInstance) el.sortableInstance.destroy();
                                                                });
                                                                const themesContainer = document.getElementById('themesContainer');
                                                                if (themesContainer && themesContainer.sortableInstance) themesContainer.sortableInstance.destroy();

                                                                if (themesContainer) {
                                                                    themesContainer.sortableInstance = new Sortable(themesContainer, {
                                                                        handle: '.drag-handle',
                                                                        animation: 150,
                                                                        ghostClass: 'sortable-ghost',
                                                                        onEnd: function () {
                                                                            saveThemeStructure();
                                                                        }
                                                                    });
                                                                }

                                                                document.querySelectorAll('.materials-container').forEach(container => {
                                                                    container.sortableInstance = new Sortable(container, {
                                                                        group: 'shared-materials',
                                                                        handle: '.drag-handle',
                                                                        animation: 150,
                                                                        ghostClass: 'sortable-ghost',
                                                                        onEnd: function (evt) {
                                                                            const targetEmptyMsg = evt.to.previousElementSibling;
                                                                            if (targetEmptyMsg && targetEmptyMsg.classList.contains('empty-theme-msg')) {
                                                                                targetEmptyMsg.style.display = evt.to.querySelectorAll('.material-card').length > 0 ? 'none' : '';
                                                                            }
                                                                            if (evt.from !== evt.to) {
                                                                                const sourceEmptyMsg = evt.from.previousElementSibling;
                                                                                if (sourceEmptyMsg && sourceEmptyMsg.classList.contains('empty-theme-msg')) {
                                                                                    sourceEmptyMsg.style.display = evt.from.querySelectorAll('.material-card').length > 0 ? 'none' : '';
                                                                                }
                        
                                                                                // Обновляем счетчики в обоих темах
                                                                                const targetTheme = evt.to.closest('.theme-card');
                                                                                if (targetTheme) {
                                                                                    const targetCount = targetTheme.querySelector('.theme-materials-count');
                                                                                    if (targetCount) targetCount.textContent = evt.to.querySelectorAll('.material-card').length;
                                                                                }
                                                                                const sourceTheme = evt.from.closest('.theme-card');
                                                                                if (sourceTheme) {
                                                                                    const sourceCount = sourceTheme.querySelector('.theme-materials-count');
                                                                                    if (sourceCount) sourceCount.textContent = evt.from.querySelectorAll('.material-card').length;
                                                                                }
                                                                            }
                                                                            saveMaterialStructure();
                                                                        }
                                                                    });
                                                                });
                                                            }

                                                            async function saveThemeStructure() {
                                                                const items = [];
                                                                const themes = document.querySelectorAll('#themesContainer > .theme-card');
                                                                themes.forEach((el, index) => {
                                                                    const id = el.id.replace('theme-card-', '');
                                                                    if (id && id !== 'none') {
                                                                        items.push({ id: parseInt(id), order: index + 1 });
                                                                    }
                                                                });

                                                                try {
                                                                    const response = await fetch('/CourseMaterials/UpdateThemeStructure', {
                                                                        method: 'POST',
                                                                        headers: { 'Content-Type': 'application/json' },
                                                                        body: JSON.stringify(items)
                                                                    });
                                                                    const result = await response.json();
                                                                    if (result.success) showToast('Порядок тем сохранен!', 'success');
                                                                    else showToast('Ошибка: ' + result.message, 'danger');
                                                                } catch { showToast('Ошибка сети при сохранении тем.', 'danger'); }
                                                            }

                                                            async function saveMaterialStructure() {
                                                                const items = [];
                                                                document.querySelectorAll('.materials-container').forEach(container => {
                                                                    const themeIdAttr = container.getAttribute('data-theme-id');
                                                                    const themeId = themeIdAttr ? parseInt(themeIdAttr) : null;

                                                                    Array.from(container.querySelectorAll('.material-card')).forEach((el, index) => {
                                                                        const materialId = parseInt(el.id.replace('material-item-', ''));
                                                                        items.push({
                                                                            id: materialId,
                                                                            themeId: themeId,
                                                                            order: index + 1
                                                                        });
                                                                    });
                                                                });

                                                                try {
                                                                    const response = await fetch('/CourseMaterials/UpdateStructure', {
                                                                        method: 'POST',
                                                                        headers: { 'Content-Type': 'application/json' },
                                                                        body: JSON.stringify(items)
                                                                    });
                                                                    const result = await response.json();
                                                                    if (result.success) { /* Не спамим тостами при каждом перетаскивании */ }
                                                                    else showToast('Ошибка: ' + result.message, 'danger');
                                                                } catch { showToast('Ошибка сети при сохранении.', 'danger'); }
                                                            }

                                                            // Функция для выбора темы при клике на "+"
                                                            function prepareAddMaterial(themeId) {
                                                                const select = document.getElementById('newMaterialThemeId');
                                                                if (select) {
                                                                    select.value = themeId;
                                                                }
                                                            }

                                                            document.addEventListener("DOMContentLoaded", function () {
                                                                initSortable();
                                                            });
                                                        </script>