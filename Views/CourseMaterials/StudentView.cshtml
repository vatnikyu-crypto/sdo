                                    chatHtml += `</div>`;

                                    if (state.status === "OnReview") {
                                        area.innerHTML = chatHtml + `<div class="alert alert-info border small m-0 fw-bold"><i class="bi bi-hourglass-split me-1"></i> Работа успешно доставлена и ожидает проверки преподавателем.</div>`;
