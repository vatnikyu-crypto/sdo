                                    let chatHtml = `<div class="border rounded p-3 mb-3 bg-light small" style="max-height: 250px; overflow-y: auto;">
                                                        <div class="fw-bold text-muted mb-2"><i class="bi bi-chat-dots-fill me-1"></i> Ваш диалог с преподавателем:</div>`;

                                    state.messages.forEach(msg => {
                                        chatHtml += `
                                            <div class="mb-2 p-2 rounded ${msg.isStudent ? 'chat-bubble-student ms-2' : 'chat-bubble-teacher me-2'}">
                                                <div class="d-flex justify-content-between text-muted" style="font-size:0.7rem;">
                                                    <span><b>${msg.isStudent ? 'Вы (Слушатель)' : 'Преподаватель'}</b></span>
                                                    <span>${msg.date}</span>
                                                </div>
                                                <div class="mt-1 text-dark">${msg.text}</div>
                                                ${msg.file ? `<div class="mt-1"><a href="${msg.file}" class="text-decoration-none text-primary fw-bold" download><i class="bi bi-paperclip"></i> Отправленный_файл</a></div>` : ''}
