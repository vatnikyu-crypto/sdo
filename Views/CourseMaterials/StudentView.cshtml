                                    else if (state.status === "NeedFix") {
                                        area.innerHTML = chatHtml + `<div class="alert alert-warning border small m-0"><i class="bi bi-arrow-counterclockwise me-1"></i> <b>Задание возвращено на доработку!</b> Изучите комментарий преподавателя выше и пришлите исправленный вариант.</div>`;
