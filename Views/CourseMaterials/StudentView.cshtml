                                        actionBtn.classList.remove('d-none');
                                    }
                                    else if (state.status === "Completed") {
                                        area.innerHTML = chatHtml + `
                                            <div class="alert alert-success border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 m-0">
                                                <span><i class="bi bi-check-circle-fill me-1"></i> <b>Проверка завершена!</b> Задание закрыто для редактирования.</span>
                                                <h4 class="m-0 fw-bold bg-white text-success px-3 py-1 rounded border shadow-sm text-center">Балл: ${state.grade}</h4>
                                            </div>`;
                                        actionBtn.classList.add('d-none');
                                    }
                                });
                        }
                        else if (mType === 4) { // Тестирование
                            const kinds = ["Промежуточное тестирование", "Итоговый экзамен курса", "Обучающий тренажер"];
                            const currentKindText = kinds[data.testkind] || "Тестирование";
                            const headerColors = ["#4e73df", "#e74a3b", "#f6c23e"];
                            const currentColor = headerColors[data.testkind] || "#4e73df";

                            bodyContainer.innerHTML = `
                                <div class="card border-0 mb-0">
                                    <div class="p-3 p-md-4 rounded-3 text-white mb-4 shadow-sm" style="background: linear-gradient(135deg, ${currentColor} 0%, #3a3b45 100%);">
                                        <span class="badge bg-white text-dark fw-bold text-uppercase mb-2" style="font-size:0.7rem;">Контроль знаний</span>
                                        <p class="lead small opacity-75 mt-1 mb-0">${currentKindText}</p>
                                    </div>

                                    <h5 class="fw-bold text-dark mb-3 fs-6 fs-md-5"><i class="bi bi-sliders me-1"></i> Параметры и регламент прохождения:</h5>
                                    <div class="test-info-grid mb-4">
                                        <div class="test-info-item">
                                            <i class="bi bi-clock-history fs-4 text-primary"></i>
                                            <div class="text-muted small fw-bold text-uppercase mt-1" style="font-size:0.65rem;">Время</div>
                                            <h5 class="fw-bold text-dark m-0 mt-1 fs-6 fs-md-5">${data.timelimit > 0 ? `${data.timelimit} мин.` : "Без лимита"}</h5>
                                        </div>
                                        <div class="test-info-item">
                                            <i class="bi bi-trophy fs-4 text-success"></i>
                                            <div class="text-muted small fw-bold text-uppercase mt-1" style="font-size:0.65rem;">Порог</div>
                                            <h5 class="fw-bold text-success m-0 mt-1 fs-6 fs-md-5">${data.passpercentage}% верных</h5>
                                        </div>
                                    </div>

                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-clock-history me-1"></i> Ваши предыдущие попытки:</h6>
                                    <div class="table-responsive bg-white border rounded mb-4 shadow-sm">
                                        <table class="table table-hover table-striped mb-0 text-dark align-middle small" style="min-width: 400px;">
                                            <thead class="table-light text-secondary fw-bold">
                                                <tr>
                                                    <th>Дата старта</th>
                                                    <th>Результат</th>
                                                    <th>Статус</th>
                                                    <th class="text-center">Действие</th>
                                                </tr>
                                            </thead>
                                            <tbody id="testAttemptsTableBody">
                                                <tr><td colspan="4" class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Загрузка...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="text-center mt-2" id="testActionContainer"></div>
                                </div>
                            `;

                            fetch(`/StudentTest/GetTestState?materialId=${id}&groupId=@ViewBag.GroupId`)
                                .then(res => res.json())
                                .then(state => {
                                    const tbody = document.getElementById('testAttemptsTableBody');
                                    const actionContainer = document.getElementById('testActionContainer');

                                    if (!state.success) {
                                        tbody.innerHTML = `<tr><td colspan="4" class="text-center text-danger py-3">Не удалось загрузить историю.</td></tr>`;
                                        return;
                                    }

                                    if (state.history.length === 0) {
                                        tbody.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-3">Вы еще не проходили этот тест.</td></tr>`;
                                    } else {
                                        let rowsHtml = "";
                                        state.history.forEach(item => {
                                            let badgeClass = "bg-secondary";
                                            if (item.statusEnum === "Passed") badgeClass = "bg-success";
                                            if (item.statusEnum === "Failed") badgeClass = "bg-danger";
                                            if (item.statusEnum === "InProgress") badgeClass = "bg-info text-dark";

                                            rowsHtml += `
                                                <tr>
                                                    <td class="fw-mono text-nowrap" style="font-size:0.75rem;">${item.date}</td>
                                                    <td class="fw-bold" style="font-size:0.75rem;">${item.statusEnum === "InProgress" ? "—" : item.score}</td>
                                                    <td><span class="badge ${badgeClass}" style="font-size:0.65rem;">${item.status}</span></td>
                                                    <td class="text-center">
                                                        <div class="d-flex gap-1 justify-content-center flex-wrap">
                                                            <a href="/StudentTest/Result?attemptId=${item.id}" class="btn btn-xs btn-outline-primary fw-bold py-0.5 px-2" style="font-size: 0.75rem;" title="Подробнее">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                            <a href="/StudentTest/DownloadResult?attemptId=${item.id}" class="btn btn-xs btn-outline-success fw-bold py-0.5 px-2" style="font-size: 0.75rem;" title="Скачать">
                                                                <i class="bi bi-download"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>`;
                                        });
                                        tbody.innerHTML = rowsHtml;
                                    }

                                    const cleanTitle = data.title.replace(/'/g, "\\'");
                                    if (state.canContinue) {
                                        actionContainer.innerHTML = `
                                            <button onclick="confirmAndStartTest(${id}, '${cleanTitle}')" class="btn btn-primary fw-bold px-4 py-3 shadow-sm border-0 d-inline-flex align-items-center gap-2 w-100 justify-content-center" style="border-radius:30px; font-size:1rem; background: linear-gradient(45deg, #4e73df, #224abe);">
                                                <i class="bi bi-play-fill fs-5"></i> ПРОДОЛЖИТЬ ТЕСТ
                                            </button>
                                            ${state.remainingSeconds > 0 ? `<small class="text-danger d-block mt-2 fw-bold"><i class="bi bi-hourglass-split"></i> Таймер тикает на сервере!</small>` : ""}
                                        `;
                                    } else {
                                        actionContainer.innerHTML = `
                                            <button onclick="confirmAndStartTest(${id}, '${cleanTitle}')" class="btn btn-success fw-bold px-4 py-3 shadow shadow-sm d-inline-flex align-items-center gap-2 w-100 justify-content-center" style="border-radius:30px; font-size:1rem;">
                                                <i class="bi bi-rocket-takeoff fs-5"></i> ЗАПУСТИТЬ ТЕСТ
                                            </button>
                                        `;
                                    }
                                });
                        }
                        else if (mType === 6) { // SCORM
                            bodyContainer.innerHTML = `
                                <div class="shadow rounded-3 overflow-hidden w-100 bg-white flex-grow-1" style="min-height: 70vh;">
                                    <iframe src="${fileUrl}" width="100%" height="100%" style="border:none; min-height: 70vh;" allowfullscreen></iframe>
                                </div>`;
                        }
                    } catch (err) {
                        bodyContainer.innerHTML = '<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> Не удалось отобразить контент элемента.</div>';
                    }
                }

                // ==========================================
                // 2. ОТРИСОВКА PDF
                // ==========================================
                async function renderPdfAsScrollableImages(pdfUrl) {
                    const viewerContainer = document.getElementById('pdfViewerContainer');
                    if (!pdfUrl) {
                        viewerContainer.innerHTML = '<div class="alert alert-warning m-2">Файл документа отсутствует.</div>';
                        return;
                    }

                    try {
                        const absoluteUrl = window.location.origin + pdfUrl;
                        const loadingTask = pdfjsLib.getDocument({
                            url: absoluteUrl, disableRange: true, disableAutoFetch: true, withCredentials: true
                        });

                        const pdf = await loadingTask.promise;
                        viewerContainer.innerHTML = '';

                        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                            const page = await pdf.getPage(pageNum);
                            const viewport = page.getViewport({ scale: 1.5 });
                            const canvas = document.createElement('canvas');
                            canvas.className = 'pdf-page-canvas mb-3 shadow-sm';
                            canvas.height = viewport.height;
                            canvas.width = viewport.width;
                            viewerContainer.appendChild(canvas);
                            const context = canvas.getContext('2d');
                            await page.render({ canvasContext: context, viewport: viewport }).promise;
                        }
                    } catch (error) {
                        console.error("Критическая ошибка рендера PDF.mjs:", error);
                        viewerContainer.innerHTML = '<div class="alert alert-danger m-2"><i class="bi bi-exclamation-triangle-fill me-2"></i> Ошибка отрисовки документа.</div>';
                    }
                }

                // ==========================================
                // 3. АВТОЗАГРУЗКА ПЕРВОГО МАТЕРИАЛА
                // ==========================================
                document.addEventListener("DOMContentLoaded", function () {
                    const activeIdFromServer = parseInt("@(ViewBag.ActiveId ?? 0)") || 0;

                    if (activeIdFromServer > 0) {
                        const targetBtn = document.querySelector(`.material-item-btn[data-id="${activeIdFromServer}"]`);
                        if (targetBtn) {
                            const parentCollapse = targetBtn.closest('.collapse');
                            if (parentCollapse && !parentCollapse.classList.contains('show')) {
                                new bootstrap.Collapse(parentCollapse, { toggle: true });
                            }
                            targetBtn.click();
                            targetBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return;
                        }
                    }
        
                    const firstBtn = document.querySelector('.material-item-btn');
                    if (firstBtn) {
                        firstBtn.click();
                    } else {
                        document.getElementById('mainContentWindow').innerHTML =
                            '<div class="text-center text-muted my-auto py-5"><h5>В программе курса пока нет материалов.</h5></div>';
                    }
                });

                // ==========================================
                // 4. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
                // ==========================================
                function openAssignmentModal(id) {
                    document.getElementById("assignmentMaterialId").value = id;
                    new bootstrap.Modal(document.getElementById('submitAssignmentModal')).show();
                }

                // ОБРАБОТЧИК СДАЧИ ПРАКТИКИ С ПРОВЕРКОЙ (ФАЙЛ ИЛИ ТЕКСТ) И ОШИБОК JSON
                document.getElementById("confirmSubmitAssignmentBtn").addEventListener("click", async function () {
                    const button = this;
                    const form = document.getElementById('studentAssignmentForm');
                    const materialId = document.getElementById("assignmentMaterialId").value;

                    if (!form.checkValidity()) { form.reportValidity(); return; }
        
                    const comment = form.querySelector('textarea[name="studentComment"]').value.trim();
                    const file = form.querySelector('input[name="submissionFile"]').files[0];
        
                    // Проверяем, что введен хотя бы текст или прикреплен файл
                    if (!comment && !file) {
                        showToast("Пожалуйста, напишите ответ или прикрепите файл!", "warning");
                        return;
                    }

                    button.disabled = true;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Отправка...';

                    const formData = new FormData(form);
                    formData.append("groupId", "@ViewBag.GroupId");

                    try {
                        const response = await fetch('/CourseMaterials/SubmitAssignment', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        // Проверка, что сервер вернул именно JSON, а не HTML (страницу ошибки 500/413)
                        const contentType = response.headers.get("content-type");
                        if (!contentType || !contentType.includes("application/json")) {
                            throw new Error(`Сервер вернул ошибку (${response.status}). Возможно, файл слишком большой.`);
                        }

                        const result = await response.json();

                        if (result.success) {
                            showToast("Работа успешно отправлена на проверку!", "success");
                            form.reset();
                            bootstrap.Modal.getInstance(document.getElementById('submitAssignmentModal')).hide();
                            document.querySelector(`.material-item-btn[data-id="${materialId}"]`).click();
                        } else {
                            showToast("Ошибка: " + result.message, "danger");
                        }
                    } catch (error) {
                        showToast("Не удалось отправить. " + error.message, "danger");
                        console.error("Ошибка отправки:", error);
                    } finally {
                        button.disabled = false;
                        button.innerHTML = 'Отправить на проверку';
                    }
                });

                let testToStartId = 0;

                function confirmAndStartTest(testId, testTitle) {
                    testToStartId = testId;
                    document.getElementById('modalTestTitle').textContent = `«${testTitle}»`;
                    new bootstrap.Modal(document.getElementById('startTestConfirmModal')).show();
                }

                document.getElementById('confirmStartTestBtn').addEventListener('click', function () {
                    if (testToStartId > 0) {
                        window.location.href = `/StudentTest/Take?testId=${testToStartId}&groupId=@ViewBag.GroupId`;
                    }
                });

                function toggleTheaterMode() {
                    const contentArea = document.querySelector('.course-content-area');
        
                    if (!document.fullscreenElement) {
                        if (contentArea.requestFullscreen) contentArea.requestFullscreen();
                        else if (contentArea.webkitRequestFullscreen) contentArea.webkitRequestFullscreen();
                        else if (contentArea.msRequestFullscreen) contentArea.msRequestFullscreen();
                    } else {
                        if (document.exitFullscreen) document.exitFullscreen();
                        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                        else if (document.msExitFullscreen) document.msExitFullscreen();
                    }
                }

                function updateFullscreenButton() {
                    const toggleBtn = document.querySelector('.fullscreen-toggle-btn');
                    if (document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement) {
                        toggleBtn.innerHTML = '<i class="bi bi-fullscreen-exit"></i> <span>Свернуть</span>';
                        toggleBtn.classList.remove('btn-outline-secondary');
                        toggleBtn.classList.add('btn-primary');
                    } else {
                        toggleBtn.innerHTML = '<i class="bi bi-fullscreen"></i> <span>На весь экран</span>';
                        toggleBtn.classList.remove('btn-primary');
                        toggleBtn.classList.add('btn-outline-secondary');
                    }
                }

                document.addEventListener('fullscreenchange', updateFullscreenButton);
                document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
                document.addEventListener('MSFullscreenChange', updateFullscreenButton);

                function openImageFullscreen(src) {
                    document.getElementById('imageLightboxOverlay').classList.add('show');
                    document.getElementById('lightboxTargetImage').src = src;
                    document.body.style.overflow = 'hidden';
                }

                function closeImageFullscreen() {
                    document.getElementById('imageLightboxOverlay').classList.remove('show');
                    document.body.style.overflow = '';
                }
            </script>