@model IEnumerable<SdoApp.Models.KnowledgeBaseDocument>
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "База нормативных документов";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    .kb-card {
        border: 1px solid var(--brand-gray);
        border-radius: 12px;
        transition: all 0.25s ease-in-out;
        background: #fff;
    }
    
    .kb-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(79, 88, 157, 0.08) !important;
        border-color: var(--brand-primary);
    }

    .category-btn {
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 20px;
        border: 1px solid var(--brand-gray);
        background: #fff;
        color: #475569;
    }

    .category-btn:hover {
        background: #f8fafc;
        border-color: var(--brand-primary);
    }

    /* Активное состояние кнопки фильтра */
    .category-btn.active {
        background: var(--brand-primary) !important;
        color: #fff !important;
        border-color: var(--brand-primary) !important;
        box-shadow: 0 2px 8px rgba(79, 88, 157, 0.3);
    }

    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }

    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    /* Иконки файлов */
    .file-icon-wrapper {
        width: 60px;
        height: 60px;
        min-width: 60px;
        background: #f8fafc;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--brand-gray);
    }

    /* === ПАГИНАЦИЯ === */
    #kbPaginationButtons {
        gap: 4px;
    }

    #kbPaginationButtons .page-link {
        color: var(--brand-primary) !important;
        background-color: #ffffff !important;
        border: 1px solid var(--brand-gray) !important;
        font-weight: 700;
        min-width: 38px;
        text-align: center;
        border-radius: 6px !important;
        margin: 0 2px;
        transition: all 0.2s;
    }

    #kbPaginationButtons .page-link:hover {
        background-color: #f0f4ff !important;
        color: var(--brand-dark) !important;
        border-color: var(--brand-primary) !important;
    }

    #kbPaginationButtons .page-item.active .page-link {
        background-color: var(--brand-primary) !important;
        border-color: var(--brand-primary) !important;
        color: #ffffff !important;
        box-shadow: 0 2px 8px rgba(79, 88, 157, 0.35);
    }

    #kbPaginationButtons .page-item.disabled .page-link {
        color: #cbd5e1 !important;
        background-color: #f8f9fa !important;
        border-color: var(--brand-gray) !important;
    }
</style>

<!-- 1. ВЕРХНЯЯ ШАПКА -->
<div class="mb-4 mt-2">
    <a href="javascript:history.back()" class="text-decoration-none text-muted small d-flex align-items-center gap-1 mb-2 fw-semibold">
        <i class="bi bi-arrow-left"></i> Назад
    </a>
    <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-book-half text-primary fs-3"></i> База знаний СДО
    </h3>
</div>

<div class="row g-4">
    <!-- ЛЕВАЯ КОЛОНКА: ПОИСК И ФИЛЬТРЫ -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm p-3" style="border-radius: 12px; border: 1px solid var(--brand-gray) !important;">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-funnel text-primary me-1"></i> Фильтры</h6>
            
            <!-- Поиск -->
            <div class="mb-4">
                <div class="input-group input-group-sm rounded-3 overflow-hidden border bg-white shadow-sm">
                    <span class="input-group-text bg-white text-muted border-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="kbCardSearchInput" class="form-control border-0 shadow-none" 
                           placeholder="Шифр или название..." autocomplete="off" />
                </div>
            </div>

            <!-- Категории -->
            <div class="d-flex flex-column gap-2">
                <button class="btn category-btn active text-start px-3 py-2" data-category="all">
                    <i class="bi bi-globe2 me-2"></i> Все направления
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Промышленная безопасность">
                    Промышленная безопасность
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Энергетическая безопасность">
                    Энергетическая безопасность
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Охрана труда">
                    Охрана труда
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Пожарная безопасность">
                    Пожарная безопасность
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Экологическая безопасность">
                    Экологическая безопасность
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Гражданская оборона и защита от ЧС">
                    Гражданская оборона и ЧС
                </button>
                <button class="btn category-btn text-start px-3 py-2" data-category="Внутренние регламенты и инструкции">
                    Внутренние регламенты
                </button>
            </div>
        </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: КАРТОЧКИ ДОКУМЕНТОВ -->
    <div class="col-lg-9">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted" id="studentEmptyState">
                <i class="bi bi-folder-x text-secondary opacity-50 d-block mb-3" style="font-size: 4rem;"></i>
                <h5 class="fw-bold mt-2 text-dark">База знаний временно пуста</h5>
                <p class="small">Администратор еще не загрузил справочные документы.</p>
            </div>
        }
        else
        {
            <!-- Панель над карточками (выбор количества элементов) -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2 small text-muted fw-bold">
                    <span>Показать по:</span>
                    <select id="kbPageSizeSelect" class="form-select form-select-sm rounded-3 shadow-none border" style="width: 80px;">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <div class="row g-3" id="kbCardsContainer">
                @foreach (var d in Model)
                {
                    // Определяем иконку и цвет в зависимости от расширения
                    string iconClass = "bi-file-earmark";
                    string iconColor = "text-secondary";
                    
                    if (d.FileExtension == ".pdf") { iconClass = "bi-file-earmark-pdf"; iconColor = "text-danger"; }
                    else if (d.FileExtension == ".doc" || d.FileExtension == ".docx") { iconClass = "bi-file-earmark-word"; iconColor = "text-primary"; }
                    else if (d.FileExtension == ".xls" || d.FileExtension == ".xlsx") { iconClass = "bi-file-earmark-excel"; iconColor = "text-success"; }
                    else if (d.FileExtension == ".zip" || d.FileExtension == ".rar") { iconClass = "bi-file-earmark-zip"; iconColor = "text-warning"; }

                    <div class="col-xl-6 kb-card-item" 
                         data-number="@d.DocumentNumber.ToLower()" 
                         data-title="@d.Title.ToLower()" 
                         data-category="@d.Category">
                        <div class="kb-card h-100 p-3 shadow-sm">
                            <div class="d-flex align-items-start gap-3">
                                <!-- Иконка файла -->
                                <div class="file-icon-wrapper">
                                    <i class="bi @iconClass @iconColor" style="font-size: 1.8rem;"></i>
                                </div>
                                
                                <!-- Информация -->
                                <div class="overflow-hidden flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="badge bg-light text-secondary border" style="font-size:0.65rem;">@d.Category</span>
                                    </div>
                                    <div class="fw-bold text-secondary small tracking-wide text-uppercase mb-1" style="font-size: 0.7rem;">@d.DocumentNumber</div>
                                    <h6 class="fw-bold text-dark mb-2" style="font-size:0.95rem; line-height:1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@d.Title">
                                        @d.Title
                                    </h6>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top flex-wrap gap-2">
                                        <span class="text-muted" style="font-size:0.75rem;">
                                            <i class="bi bi-calendar3 me-1"></i> Ред: <strong>@d.DocumentRevisionDate?.ToString("dd.MM.yyyy")</strong>
                                        </span>
                                        <a href="@d.FilePath" download="@d.Title@d.FileExtension" 
                                           class="btn btn-sm btn-brand fw-bold px-3 d-flex align-items-center gap-1 rounded-3 shadow-sm">
                                            <i class="bi bi-download"></i> Скачать <small style="font-size:0.7rem;">(@d.FileSizeMb МБ)</small>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                
                <!-- Заглушка для живого поиска, если ничего не найдено -->
                <div class="col-12 text-center py-5 text-muted d-none" id="searchEmptyState">
                    <i class="bi bi-search text-secondary opacity-50 d-block mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold mt-2 text-dark">Ничего не найдено</h5>
                    <p class="small">Попробуйте изменить поисковый запрос или выбрать другое направление.</p>
                </div>
            </div>

            <!-- ПАГИНАЦИЯ ВНИЗУ -->
            <div class="d-flex justify-content-between align-items-center px-1 mt-4 mb-5">
                <div id="kbPaginationInfo" class="small text-muted fw-bold">Показано 0-0 из 0 документов</div>
                <nav>
                    <ul id="kbPaginationButtons" class="pagination pagination-sm m-0">
                        <!-- Генерируется через JS -->
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById('kbCardSearchInput');
        const cardsContainer = document.getElementById('kbCardsContainer');
        const cardItems = Array.from(document.querySelectorAll('.kb-card-item'));
        const categoryButtons = document.querySelectorAll('.category-btn');
        const searchEmptyState = document.getElementById('searchEmptyState');
        const pageSizeSelect = document.getElementById('kbPageSizeSelect');
        
        if (!cardsContainer) return; // Если БЗ пуста, скрипт не нужен

        // === 1. ВОССТАНОВЛЕНИЕ СОСТОЯНИЯ ИЗ LOCALSTORAGE ===
        let currentPage = 1;
        let pageSize = parseInt(localStorage.getItem('kb_pageSize') || '10');
        let activeCategory = localStorage.getItem('kb_category') || "all";
        let filteredItems = [];

        // Ставим сохраненный размер страницы
        if (pageSizeSelect) pageSizeSelect.value = pageSize;

        // Ставим сохраненный поисковый запрос
        const savedSearch = localStorage.getItem('kb_search');
        if (savedSearch) searchInput.value = savedSearch;

        // Ставим активную категорию
        categoryButtons.forEach(btn => {
            if (btn.getAttribute('data-category') === activeCategory) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });

        // === 2. ФУНКЦИЯ ФИЛЬТРАЦИИ И ПАГИНАЦИИ ===
        function applyFiltersAndPaginate() {
            const searchText = searchInput.value.trim().toLowerCase();

            // Сохраняем в LocalStorage
            localStorage.setItem('kb_search', searchInput.value);
            localStorage.setItem('kb_category', activeCategory);
            localStorage.setItem('kb_pageSize', pageSize);

            // Фильтруем
            filteredItems = cardItems.filter(card => {
                const num = card.getAttribute('data-number') || "";
                const title = card.getAttribute('data-title') || "";
                const category = card.getAttribute('data-category') || "";

                const matchesSearch = searchText.length === 0 || num.includes(searchText) || title.includes(searchText);
                const matchesCategory = activeCategory === "all" || category === activeCategory;

                return matchesSearch && matchesCategory;
            });

            // Пагинация
            const totalItems = filteredItems.length;
            const totalPages = Math.ceil(totalItems / pageSize);
            
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalItems);

            // Скрываем все, показываем нужные
            cardItems.forEach(c => c.classList.add('d-none'));
            filteredItems.slice(startIndex, endIndex).forEach(c => c.classList.remove('d-none'));

            // Обновляем текст
            const info = document.getElementById('kbPaginationInfo');
            if (info) {
                info.textContent = totalItems === 0 ? 'Показано 0-0 из 0' : `Показано ${startIndex + 1}-${endIndex} из ${totalItems} документов`;
            }

            // Рисуем кнопки
            renderPagination(totalPages);

            // Показываем заглушку "Ничего не найдено"
            if (searchEmptyState) {
                if (totalItems === 0 && cardItems.length > 0) {
                    searchEmptyState.classList.remove('d-none');
                } else {
                    searchEmptyState.classList.add('d-none');
                }
            }
        }

        function renderPagination(totalPages) {
            const container = document.getElementById('kbPaginationButtons');
            if (!container) return;
            
            container.innerHTML = '';
            if (totalPages <= 1) return;

            // Назад
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<span class="page-link" style="cursor:pointer;"><i class="bi bi-chevron-left"></i></span>`;
            if (currentPage > 1) {
                prevLi.addEventListener('click', () => { currentPage--; applyFiltersAndPaginate(); });
            }
            container.appendChild(prevLi);

            // Номера страниц
            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${currentPage === i ? 'active' : ''}`;
                li.innerHTML = `<span class="page-link" style="cursor:pointer;">${i}</span>`;
                li.addEventListener('click', () => { currentPage = i; applyFiltersAndPaginate(); });
                container.appendChild(li);
            }

            // Вперед
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
            nextLi.innerHTML = `<span class="page-link" style="cursor:pointer;"><i class="bi bi-chevron-right"></i></span>`;
            if (currentPage < totalPages) {
                nextLi.addEventListener('click', () => { currentPage++; applyFiltersAndPaginate(); });
            }
            container.appendChild(nextLi);
        }

        // === 3. ОБРАБОТЧИКИ СОБЫТИЙ ===
        searchInput.addEventListener('input', () => { currentPage = 1; applyFiltersAndPaginate(); });

        categoryButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                categoryButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                activeCategory = this.getAttribute('data-category');
                currentPage = 1;
                applyFiltersAndPaginate();
            });
        });

        if (pageSizeSelect) {
            pageSizeSelect.addEventListener('change', function() {
                pageSize = parseInt(this.value);
                currentPage = 1;
                applyFiltersAndPaginate();
            });
        }

        // Запуск при загрузке
        applyFiltersAndPaginate();
    });
</script>