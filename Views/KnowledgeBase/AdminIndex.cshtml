@model IEnumerable<SdoApp.Models.KnowledgeBaseDocument>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "База знаний";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-accent: #F59E0B;
        --brand-gray: #e2e8f0;
    }

    .fade-out {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    /* Стили таблицы */
    .table-custom th {
        font-weight: 600;
        color: #6c757d;
        border-bottom: 2px solid var(--brand-gray);
        padding: 15px 12px;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }
    
    .table-custom td {
        padding: 12px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f3f5;
    }

    .table-custom tbody tr { transition: all 0.2s; }
    .table-custom tbody tr:hover { background-color: #f8f9fa; }

    /* Кнопки действий в таблице */
    .btn-action {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s;
    }
    .btn-action-download { background-color: #f0fdf4; color: #198754; border: 1px solid #d1e7dd; }
    .btn-action-download:hover { background-color: #198754; color: white; border-color: #198754; }
    
    .btn-action-edit { background-color: #f0f4ff; color: var(--brand-primary); border: 1px solid #dce4ff; }
    .btn-action-edit:hover { background-color: var(--brand-primary); color: white; border-color: var(--brand-primary); }
    
    .btn-action-delete { background-color: #fff0f0; color: #dc3545; border: 1px solid #ffd6d6; }
    .btn-action-delete:hover { background-color: #dc3545; color: white; border-color: #dc3545; }

    /* Фирменная кнопка */
    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }
    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    /* Стили для полей в модалках */
    .modal-input {
        background-color: #f8fafc;
        border: 1px solid var(--brand-gray);
        border-radius: 8px;
        padding: 10px 12px;
    }
    .modal-input:focus {
        background-color: #fff;
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 0.2rem rgba(79, 88, 157, 0.15);
    }

    /* Пагинация */
    .pagination .page-item.active .page-link {
        background-color: var(--brand-primary);
        border-color: var(--brand-primary);
    }
    .pagination .page-link { color: var(--brand-primary); }
</style>

<!-- 1. ВЕРХНЯЯ ШАПКА -->
<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <div>
        <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
            <i class="bi bi-book text-primary"></i> База знаний
        </h3>
    </div>
    <div>
        <button class="btn btn-brand px-4 py-2 fw-bold d-flex align-items-center gap-2 rounded-3" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
            <i class="bi bi-plus-lg"></i> Загрузить документ
        </button>
    </div>
</div>

<!-- 2. ИНСТРУМЕНТЫ ФИЛЬТРАЦИИ И ПОИСКА -->
<div class="row g-3 align-items-center mb-3">
    <div class="col-sm-auto d-flex align-items-center gap-2 small text-muted fw-bold">
        <span>Показать по:</span>
        <select id="kbPageSizeSelect" class="form-select form-select-sm rounded-3 shadow-none" style="width: 80px;">
            <option value="10" selected>10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
    </div>
    <div class="col-sm ms-auto" style="max-width: 450px;">
        <div class="input-group input-group-sm rounded-3 overflow-hidden border">
            <span class="input-group-text bg-white text-muted border-0"><i class="bi bi-search"></i></span>
            <input type="text" id="kbTableSearchInput" class="form-control border-0 shadow-none"
                   placeholder="Поиск по шифру, названию или категории..." autocomplete="off" />
        </div>
    </div>
</div>

<!-- 3. ТАБЛИЦА ДОКУМЕНТОВ -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
    <div class="table-responsive">
        <table class="table table-custom table-hover m-0" id="kbMainTable">
            <thead class="bg-light">
                <tr>
                    <th style="width: 60px;" class="text-center">Тип</th>
                    <th style="width: 160px;">Номер</th>
                    <th>Наименование документа</th>
                    <th style="width: 220px;">Категория</th>
                    <th style="width: 120px;">Редакция</th>
                    <th style="width: 90px;">Размер</th>
                    <th style="width: 140px;" class="text-end pe-4">Действия</th>
                </tr>
            </thead>
            <tbody class="text-dark" id="kbTableBody">
                @if (!Model.Any())
                {
                    <tr id="noDocsRow">
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h5 class="fw-bold mt-2 text-dark">База знаний пуста</h5>
                            <p class="small mb-0">Загрузите первый документ с помощью кнопки выше.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model)
                    {
                        // Логика выбора иконки и её цвета в зависимости от расширения файла
                        string iconClass = "bi-file-earmark";
                        string iconColor = "text-secondary";
                        
                        if (d.FileExtension == ".pdf") { iconClass = "bi-file-earmark-pdf"; iconColor = "text-danger"; }
                        else if (d.FileExtension == ".doc" || d.FileExtension == ".docx") { iconClass = "bi-file-earmark-word"; iconColor = "text-primary"; }
                        else if (d.FileExtension == ".xls" || d.FileExtension == ".xlsx") { iconClass = "bi-file-earmark-excel"; iconColor = "text-success"; }

                        <tr class="kb-table-row" id="doc-row-@d.Id" data-id="@d.Id">
                            <td class="text-center">
                                <i class="bi @iconClass @iconColor fs-4" title="@d.FileExtension"></i>
                            </td>
                            <td class="fw-bold text-secondary kb-cell-number">@d.DocumentNumber</td>
                            <td class="fw-bold text-dark kb-cell-title">@d.Title</td>
                            <td>
                                <span class="badge bg-light text-secondary border kb-cell-category px-3 py-2 rounded-pill">@d.Category</span>
                            </td>
                            <td class="text-muted small">@d.DocumentRevisionDate?.ToString("dd.MM.yyyy")</td>
                            <td class="text-muted small fw-bold">@d.FileSizeMb МБ</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <!-- Кнопка Скачать -->
                                    <a href="@d.FilePath" download="@d.Title@d.FileExtension"
                                       class="btn btn-action btn-action-download" title="Скачать файл">
                                        <i class="bi bi-download"></i>
                                    </a>
                                    
                                    <!-- Кнопка Редактировать -->
                                    <button type="button" class="btn btn-action btn-action-edit" title="Редактировать" 
                                            data-bs-toggle="modal" data-bs-target="#editDocModal"
                                            onclick="prepareEditDoc(@d.Id, '@(d.DocumentNumber?.Replace("'", "\\'").Replace("\"", "&quot;"))', '@(d.Title?.Replace("'", "\\'").Replace("\"", "&quot;"))', '@d.Category', '@d.DocumentRevisionDate?.ToString("yyyy-MM-dd")')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    
                                    <!-- Кнопка Удалить -->
                                    <button type="button" class="btn btn-action btn-action-delete" title="Удалить" 
                                            data-bs-toggle="modal" data-bs-target="#deleteDocModal"
                                            onclick="prepareDeleteDoc(@d.Id, '@d.DocumentNumber')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 4. СТРОКА НАВИГАЦИИ -->
<div class="d-flex justify-content-between align-items-center px-1 mb-5">
    <div id="kbPaginationInfo" class="small text-muted fw-bold">Показано 0-0 из 0 документов</div>
    <nav>
        <ul id="kbPaginationButtons" class="pagination pagination-sm m-0">
            <!-- Генерируется через JS -->
        </ul>
    </nav>
</div>

<!-- МОДАЛЬНОЕ ОКНО 1: ЗАГРУЗКА ДОКУМЕНТА -->
<div class="modal fade" id="uploadDocModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-light border-0 py-3" style="border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-cloud-arrow-up text-primary"></i> Добавление документа
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="uploadDocForm" autocomplete="off" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">НОМЕР <span class="text-danger">*</span></label>
                            <input name="documentNumber" id="newDocNumber" type="text" class="form-control modal-input fw-bold" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">КАТЕГОРИЯ</label>
                            <select name="category" id="newDocCategory" class="form-select modal-input">
                                <option value="Промышленная безопасность">Промышленная безопасность</option>
                                <option value="Энергетическая безопасность">Энергетическая безопасность</option>
                                <option value="Охрана труда" selected>Охрана труда</option>
                                <option value="Пожарная безопасность">Пожарная безопасность</option>
                                <option value="Экологическая безопасность">Экологическая безопасность</option>
                                <option value="Гражданская оборона и защита от ЧС">Гражданская оборона и защита от ЧС</option>
                                <option value="Безопасность на транспорте">Безопасность на транспорте</option>
                                <option value="Управленческая безопасность">Управленческая безопасность</option>
                                <option value="Информационная безопасность">Информационная безопасность</option>
                                <option value="Антитеррористическая безопасность">Антитеррористическая безопасность</option>
                                <option value="Внутренние регламенты и инструкции">Внутренние регламенты и инструкции</option>
                                <option value="Общие документы">Общие документы</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">ПОЛНОЕ НАИМЕНОВАНИЕ <span class="text-danger">*</span></label>
                        <input name="title" id="newDocTitle" type="text" class="form-control modal-input" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">ДАТА РЕДАКЦИИ</label>
                            <input name="revisionDate" id="newDocRevisionDate" type="date" class="form-control modal-input" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">ФАЙЛ ДОКУМЕНТА <span class="text-danger">*</span></label>
                            <input name="docFile" id="newDocFile" type="file" class="form-control modal-input" required />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0 py-3" style="border-radius: 0 0 16px 16px;">
                <button type="button" class="btn btn-light px-4 fw-bold border text-secondary rounded-3" data-bs-dismiss="modal">Отмена</button>
                <button id="submitUploadDocBtn" type="button" class="btn btn-brand px-4 fw-bold rounded-3">
                    <i class="bi bi-upload me-1"></i> Загрузить файл
                </button>
            </div>
        </div>
    </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО 2: РЕДАКТИРОВАНИЕ -->
<div class="modal fade" id="editDocModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-light border-0 py-3" style="border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i> Редактирование параметров
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editDocForm" autocomplete="off" enctype="multipart/form-data">
                    <input type="hidden" id="editDocId" name="id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">НОМЕР <span class="text-danger">*</span></label>
                            <input name="documentNumber" id="editDocNumber" type="text" class="form-control modal-input fw-bold" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">КАТЕГОРИЯ</label>
                            <select name="category" id="editDocCategory" class="form-select modal-input">
                                <option value="Промышленная безопасность">Промышленная безопасность</option>
                                <option value="Энергетическая безопасность">Энергетическая безопасность</option>
                                <option value="Охрана труда">Охрана труда</option>
                                <option value="Пожарная безопасность">Пожарная безопасность</option>
                                <option value="Экологическая безопасность">Экологическая безопасность</option>
                                <option value="Гражданская оборона и защита от ЧС">Гражданская оборона и защита от ЧС</option>
                                <option value="Безопасность на транспорте">Безопасность на транспорте</option>
                                <option value="Управленческая безопасность">Управленческая безопасность</option>
                                <option value="Информационная безопасность">Информационная безопасность</option>
                                <option value="Антитеррористическая безопасность">Антитеррористическая безопасность</option>
                                <option value="Внутренние регламенты и инструкции">Внутренние регламенты и инструкции</option>
                                <option value="Общие документы">Общие документы</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">ПОЛНОЕ НАИМЕНОВАНИЕ <span class="text-danger">*</span></label>
                        <input name="title" id="editDocTitle" type="text" class="form-control modal-input" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">ДАТА РЕДАКЦИИ</label>
                            <input name="revisionDate" id="editDocRevisionDate" type="date" class="form-control modal-input" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small fw-bold">ЗАМЕНИТЬ ФАЙЛ (НЕОБЯЗАТЕЛЬНО)</label>
                            <input name="docFile" id="editDocFile" type="file" class="form-control modal-input" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0 py-3" style="border-radius: 0 0 16px 16px;">
                <button type="button" class="btn btn-light px-4 fw-bold border text-secondary rounded-3" data-bs-dismiss="modal">Отмена</button>
                <button id="submitEditDocBtn" type="button" class="btn btn-brand px-4 fw-bold rounded-3">
                    <i class="bi bi-check-lg me-1"></i> Сохранить изменения
                </button>
            </div>
        </div>
    </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО 3: УДАЛЕНИЕ -->
<div class="modal fade" id="deleteDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-body p-4 text-center">
                <div class="text-danger mb-3 d-flex justify-content-center">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark mb-2">Удаление документа</h5>
                <p class="text-muted small mb-2">Вы действительно хотите безвозвратно удалить файл документа из СДО?</p>
                <p id="deleteDocNameText" class="fw-bold text-dark mb-4 fs-5"></p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light px-4 fw-bold border text-secondary w-50 rounded-3" data-bs-dismiss="modal">Отмена</button>
                    <button id="confirmDeleteDocBtn" type="button" class="btn btn-danger px-4 fw-bold w-50 rounded-3">Удалить</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- СКРИПТЫ (Без изменений логики, только рабочая часть) -->
<script>
    let currentKbPage = 1;
    const kbTableBody = document.getElementById('kbTableBody');
    const kbPageSizeSelect = document.getElementById('kbPageSizeSelect');
    const kbSearchInput = document.getElementById('kbTableSearchInput');
    let kbPageSize = parseInt(kbPageSizeSelect.value);

    function updateKbTable() {
        const rows = Array.from(kbTableBody.querySelectorAll('.kb-table-row'));
        const searchText = kbSearchInput.value.trim().toLowerCase();

        let filteredRows = rows;
        if (searchText.length > 0) {
            filteredRows = rows.filter(row => {
                const num = row.querySelector('.kb-cell-number')?.textContent?.toLowerCase() ?? "";
                const title = row.querySelector('.kb-cell-title')?.textContent?.toLowerCase() ?? "";
                const category = row.querySelector('.kb-cell-category')?.textContent?.toLowerCase() ?? "";
                return num.includes(searchText) || title.includes(searchText) || category.includes(searchText);
            });
        }

        const totalRows = filteredRows.length;

        if (totalRows === 0) {
            rows.forEach(r => r.style.display = 'none');
            document.getElementById('kbPaginationInfo').textContent = 'Показано 0-0 из 0 документов';
            document.getElementById('kbPaginationButtons').innerHTML = '';
            return;
        }

        const totalPages = Math.ceil(totalRows / kbPageSize);
        if (currentKbPage > totalPages) currentKbPage = totalPages;
        if (currentKbPage < 1) currentKbPage = 1;

        const startIndex = (currentKbPage - 1) * kbPageSize;
        const endIndex = Math.min(startIndex + kbPageSize, totalRows);

        rows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((row, index) => {
            if (index >= startIndex && index < endIndex) {
                row.style.display = '';
            }
        });

        document.getElementById('kbPaginationInfo').textContent = `Показано ${startIndex + 1}-${endIndex} из ${totalRows} документов`;

        const buttonsContainer = document.getElementById('kbPaginationButtons');
        buttonsContainer.innerHTML = '';

        const prevLi = document.createElement('li');
        prevLi.className = `page-item ${currentKbPage === 1 ? 'disabled' : ''}`;
        prevLi.innerHTML = `<span class="page-link" style="cursor:pointer;"><i class="bi bi-chevron-left"></i></span>`;
        if (currentKbPage > 1) {
            prevLi.addEventListener('click', () => { currentKbPage--; updateKbTable(); });
        }
        buttonsContainer.appendChild(prevLi);

        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement('li');
            li.className = `page-item ${currentKbPage === i ? 'active' : ''}`;
            li.innerHTML = `<span class="page-link" style="cursor:pointer;">${i}</span>`;
            li.addEventListener('click', () => { currentKbPage = i; updateKbTable(); });
            buttonsContainer.appendChild(li);
        }

        const nextLi = document.createElement('li');
        nextLi.className = `page-item ${currentKbPage === totalPages ? 'disabled' : ''}`;
        nextLi.innerHTML = `<span class="page-link" style="cursor:pointer;"><i class="bi bi-chevron-right"></i></span>`;
        if (currentKbPage < totalPages) {
            nextLi.addEventListener('click', () => { currentKbPage++; updateKbTable(); });
        }
        buttonsContainer.appendChild(nextLi);
    }

    // --- AJAX ЗАГРУЗКА ---
    document.getElementById('submitUploadDocBtn').addEventListener('click', async function () {
        const numInput = document.getElementById('newDocNumber');
        const titleInput = document.getElementById('newDocTitle');
        const fileInput = document.getElementById('newDocFile');
        const categorySelect = document.getElementById('newDocCategory');
        const revisionInput = document.getElementById('newDocRevisionDate');

        if (!numInput.value.trim() || !titleInput.value.trim() || fileInput.files.length === 0) {
            alert('Пожалуйста, заполните обязательные поля и выберите файл!');
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Загрузка...';

        const formData = new FormData();
        formData.append('documentNumber', numInput.value.trim());
        formData.append('title', titleInput.value.trim());
        formData.append('category', categorySelect.value);
        formData.append('revisionDate', revisionInput.value);
        formData.append('docFile', fileInput.files[0]);

        try {
            const response = await fetch('/KnowledgeBase/Create', { method: 'POST', body: formData });
            const result = await response.json();
            if (result.success) {
                document.querySelector('#uploadDocModal [data-bs-dismiss="modal"]').click();
                document.getElementById('uploadDocForm').reset();
                window.location.reload();
            } else {
                alert('Внимание: ' + result.message);
                this.disabled = false; this.innerHTML = '<i class="bi bi-upload me-1"></i> Загрузить файл';
            }
        } catch (err) {
            alert('Ошибка сети при загрузке документа.');
            this.disabled = false; this.innerHTML = '<i class="bi bi-upload me-1"></i> Загрузить файл';
        }
    });

    // --- AJAX УДАЛЕНИЕ ---
    let docIdToDelete = null;
    function prepareDeleteDoc(id, docNumber) {
        docIdToDelete = id;
        document.getElementById('deleteDocNameText').textContent = 'Номер: ' + docNumber;
    }

    document.getElementById('confirmDeleteDocBtn').addEventListener('click', async function () {
        if (!docIdToDelete) return;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
            const response = await fetch(`/KnowledgeBase/Delete/${docIdToDelete}`, { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                document.querySelector('#deleteDocModal [data-bs-dismiss="modal"]').click();
                const row = document.getElementById(`doc-row-${docIdToDelete}`);
                if (row) {
                    row.classList.add('fade-out');
                    setTimeout(() => { row.remove(); window.location.reload(); }, 300);
                }
            } else {
                alert(result.message);
                this.disabled = false;
                this.textContent = 'Удалить';
            }
        } catch (err) {
            alert('Сбой сети при удалении файла.');
            this.disabled = false;
            this.textContent = 'Удалить';
        }
    });

    kbSearchInput.addEventListener('input', () => { currentKbPage = 1; updateKbTable(); });
    kbPageSizeSelect.addEventListener('change', function () { kbPageSize = parseInt(this.value); currentKbPage = 1; updateKbTable(); });
    document.addEventListener("DOMContentLoaded", updateKbTable);

    // --- AJAX РЕДАКТИРОВАНИЕ ---
    function prepareEditDoc(id, docNumber, title, category, revisionDate) {
        document.getElementById('editDocId').value = id;
        document.getElementById('editDocNumber').value = docNumber;
        document.getElementById('editDocTitle').value = title;
        document.getElementById('editDocCategory').value = category;
        document.getElementById('editDocFile').value = ""; 
        
        if (revisionDate) {
            document.getElementById('editDocRevisionDate').value = revisionDate;
        } else {
            document.getElementById('editDocRevisionDate').value = "";
        }
    }

    document.getElementById('submitEditDocBtn').addEventListener('click', async function () {
        const idInput = document.getElementById('editDocId');
        const numInput = document.getElementById('editDocNumber');
        const titleInput = document.getElementById('editDocTitle');
        const fileInput = document.getElementById('editDocFile');
        const categorySelect = document.getElementById('editDocCategory');
        const revisionInput = document.getElementById('editDocRevisionDate');

        if (!numInput.value.trim() || !titleInput.value.trim()) {
            alert('Пожалуйста, заполните обязательные текстовые поля!');
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Сохранение...';

        const formData = new FormData();
        formData.append('id', idInput.value);
        formData.append('documentNumber', numInput.value.trim());
        formData.append('title', titleInput.value.trim());
        formData.append('category', categorySelect.value);
        formData.append('revisionDate', revisionInput.value);

        if (fileInput.files.length > 0) {
            formData.append('docFile', fileInput.files[0]);
        }

        try {
            const response = await fetch('/KnowledgeBase/Edit', { method: 'POST', body: formData });
            const result = await response.json();
            if (result.success) {
                document.querySelector('#editDocModal [data-bs-dismiss="modal"]').click();
                window.location.reload();
            } else {
                alert('Внимание: ' + result.message);
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-check-lg me-1"></i> Сохранить изменения';
            }
        } catch (err) {
            alert('Ошибка сети при обновлении параметров документа.');
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-check-lg me-1"></i> Сохранить изменения';
        }
    });
</script>