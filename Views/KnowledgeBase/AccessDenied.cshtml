@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Доступ ограничен";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    .access-denied-card {
        border-radius: 16px;
        border: 1px solid var(--brand-gray);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        background-color: #fff;
        max-width: 550px;
        margin: 0 auto;
        padding: 40px 30px;
    }

    .icon-wrapper {
        width: 90px;
        height: 90px;
        background-color: #fee2e2;
        color: #dc3545;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.15);
    }

    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }

    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }
</style>

<div class="container py-5 mt-5 text-center">
    <div class="access-denied-card">
        
        <!-- Иконка -->
        <div class="icon-wrapper">
            <i class="bi bi-shield-lock-fill" style="font-size: 3rem;"></i>
        </div>

        <!-- Заголовок -->
        <h4 class="fw-bold text-dark mb-3">Доступ к Базе знаний ограничен</h4>
        
        <!-- Текст -->
        <p class="text-muted small mb-4" style="line-height: 1.6;">
            Извините, но просматривать и скачивать нормативные документы могут только слушатели СДО, 
            проходящие обучение в данный момент. Срок действия ваших учебных допусков истек или еще не начался.
        </p>

        <!-- Разделитель и кнопка -->
        <div class="border-top pt-4 mt-4">
            <p class="small text-secondary mb-4">
                Для продления доступа или по вопросам обучения свяжитесь с технической поддержкой.
            </p>
            <a href="/Dashboard/Student" class="btn btn-brand px-4 py-2 fw-bold rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Вернуться к моим курсам
            </a>
        </div>
    </div>
</div>