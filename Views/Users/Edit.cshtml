@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редактирование слушателя";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
        --brand-bg: #f8fafc;
    }

    .card-custom {
        background: white;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 15px 10px 42px;
        border: 1px solid var(--brand-gray);
        background-color: var(--brand-bg);
        transition: all 0.3s;
        font-size: 0.95rem;
        color: #333;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 0.2rem rgba(79, 88, 157, 0.15);
        background-color: #fff;
    }

    .form-control[readonly] {
        background-color: #eef2f7;
        color: #6c757d;
        cursor: not-allowed;
    }

    .input-icon-wrapper {
        position: relative;
    }

    .input-icon-wrapper .bi {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0aabf;
        font-size: 1rem;
        z-index: 10;
        pointer-events: none;
    }

    /* Поле пароля (без иконки, но с кнопками) */
    .password-field {
        border-radius: 10px;
        padding: 10px 15px;
        border: 1px solid var(--brand-gray);
        background-color: var(--brand-bg);
        transition: all 0.3s;
    }

    .password-field:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 0.2rem rgba(79, 88, 157, 0.15);
        background-color: #fff;
    }

    .btn-outline-brand {
        border: 1px solid var(--brand-gray);
        color: var(--brand-primary);
        background: white;
        transition: all 0.2s;
    }

    .btn-outline-brand:hover {
        background: var(--brand-primary);
        color: white;
        border-color: var(--brand-primary);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--brand-primary);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--brand-gray);
    }

    .section-title i {
        font-size: 1.2rem;
    }

    .section-title.auth-section {
        color: #6c757d;
    }

    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
        border-radius: 10px;
    }

    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    .validation-error {
        background-color: #fff5f5;
        border-left: 4px solid #dc3545;
        color: #842029;
        border-radius: 8px;
    }

    /* Стилизация TomSelect под общий стиль */
    .ts-control {
        border-radius: 10px !important;
        padding: 10px 15px 10px 42px !important;
        border: 1px solid var(--brand-gray) !important;
        background-color: var(--brand-bg) !important;
        min-height: 44px;
    }

    .ts-control.focus {
        border-color: var(--brand-primary) !important;
        box-shadow: 0 0 0 0.2rem rgba(79, 88, 157, 0.15) !important;
        background-color: #fff !important;
    }
</style>

<!-- НАВИГАЦИОННАЯ ШАПКА -->
<div class="mb-4 mt-2">
    <a href="/Users/Index" class="text-decoration-none text-muted small d-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i> Назад к списку
    </a>
    <h3 class="fw-bold text-dark m-0">Редактирование профиля</h3>
    <small class="text-muted">Изменение персональных данных слушателя курсов</small>
</div>

<!-- КАРТОЧКА С ФОРМОЙ -->
<div class="card card-custom p-4 mb-5" style="max-width: 900px;">
    <form asp-action="Edit" asp-controller="Users" method="post">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-error p-3 mb-4 d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                <div>
                    <strong class="d-block mb-1">Ошибка при сохранении:</strong>
                    <div asp-validation-summary="All" class="m-0 p-0" style="list-style-type: none;"></div>
                </div>
            </div>
        }

        <!-- СЕКЦИЯ 0: ДАННЫЕ АВТОРИЗАЦИИ -->
        <div class="section-title auth-section">
            <i class="bi bi-shield-lock"></i> Данные авторизации
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ЛОГИН (НЕИЗМЕНЯЕМЫЙ)</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person-badge"></i>
                    <input type="text" class="form-control" value="@ViewBag.Login" readonly />
                </div>
            </div>
            <div class="col-md-8">
                <label class="form-label text-muted small fw-bold">ПАРОЛЬ <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input id="passwordInput" name="Password" type="password" class="password-field flex-grow-1"
                           required value="@ViewBag.Password" placeholder="Введите или сгенерируйте" autocomplete="off"
                           style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                    <button class="btn btn-outline-brand d-flex align-items-center" type="button" id="togglePasswordBtn"
                            title="Показать/Скрыть пароль">
                        <i class="bi bi-eye-slash" id="eyeIcon"></i>
                    </button>
                    <button class="btn btn-outline-brand d-flex align-items-center" type="button"
                            id="generatePasswordBtn" title="Сгенерировать новый пароль"
                            style="border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="form-text small text-muted mt-1" style="font-size: 0.75rem;">
                    Нажмите <i class="bi bi-arrow-clockwise"></i> для генерации нового 10-символьного пароля.
                </div>
            </div>
        </div>

        <!-- СЕКЦИЯ 1: ЛИЧНЫЕ ДАННЫЕ -->
        <div class="section-title mt-4">
            <i class="bi bi-person-vcard"></i> Личные данные
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ФАМИЛИЯ <span class="text-danger">*</span></label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person"></i>
                    <input name="LastName" type="text" placeholder="Фамилия" class="form-control" required
                           autocomplete="off" value="@ViewBag.LastName" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ИМЯ <span class="text-danger">*</span></label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person"></i>
                    <input name="FirstName" placeholder="Имя" type="text" class="form-control" required
                           autocomplete="off" value="@ViewBag.FirstName" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ОТЧЕСТВО</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person"></i>
                    <input name="MiddleName" placeholder="Отчество" type="text" class="form-control" autocomplete="off"
                           value="@ViewBag.MiddleName" />
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ПОЛ <span class="text-danger">*</span></label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-gender-ambiguous"></i>
                    <select name="Gender" class="form-select">
                        <option value="0" selected="@(ViewBag.Gender == 0 ? "selected" : null)">Мужской</option>
                        <option value="1" selected="@(ViewBag.Gender == 1 ? "selected" : null)">Женский</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ДАТА РОЖДЕНИЯ</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-calendar-event"></i>
                    <input name="BirthDate" type="date" class="form-control" value="@ViewBag.BirthDate" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">СНИЛС</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-card-text"></i>
                    <input name="Snils" type="text" class="form-control" placeholder="999-999-999 99" autocomplete="off"
                           value="@ViewBag.Snils" />
                </div>
            </div>
        </div>

        <!-- СЕКЦИЯ 2: ОРГАНИЗАЦИЯ -->
        <div class="section-title mt-4">
            <i class="bi bi-building"></i> Организация и должность
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">КОМПАНИЯ (ПОИСК ПО БАЗЕ)</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-building"></i>
                    <select id="companySelect" name="CompanyName" placeholder="Начните вводить название..."></select>
                </div>
                <div class="form-text small text-muted mt-1" style="font-size: 0.75rem;">
                    Начните вводить название, чтобы найти компанию. Если её нет — введите полное название и нажмите
                    Enter.
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">ПОДРАЗДЕЛЕНИЕ / ОТДЕЛЕНИЕ</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-diagram-3"></i>
                    <input name="Department" type="text" class="form-control" placeholder="Подразделение"
                           autocomplete="off" value="@ViewBag.Department" />
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">ДОЛЖНОСТЬ</label>
            <div class="input-icon-wrapper">
                <i class="bi bi-briefcase"></i>
                <input name="Position" type="text" placeholder="Должность" class="form-control" autocomplete="off"
                       value="@ViewBag.Position" />
            </div>
        </div>

        <!-- КНОПКИ УПРАВЛЕНИЯ -->
        <div class="d-flex gap-2 pt-2 border-top">
            <button type="submit" class="btn btn-brand px-4 py-2 fw-bold d-flex align-items-center gap-2 mt-3">
                <i class="bi bi-check-lg fs-5"></i> Сохранить изменения
            </button>
            <a href="/Users/Index" class="btn btn-light px-4 py-2 fw-bold border text-secondary rounded-3 mt-3">
                Отмена
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ==========================================
        // 1. ПОКАЗ / СКРЫТИЕ ПАРОЛЯ
        // ==========================================
        const passwordInput = document.getElementById('passwordInput');
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const eyeIcon = document.getElementById('eyeIcon');

        togglePasswordBtn.addEventListener('click', function () {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('bi-eye-slash');
                eyeIcon.classList.add('bi-eye');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('bi-eye');
                eyeIcon.classList.add('bi-eye-slash');
            }
        });

        // ==========================================
        // 2. ГЕНЕРАЦИЯ ПАРОЛЯ
        // ==========================================
        document.getElementById('generatePasswordBtn').addEventListener('click', function () {
            const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
            let newPassword = "";
            for (let i = 0; i < 10; i++) {
                newPassword += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            passwordInput.value = newPassword;
            // Показываем пароль, чтобы админ его видел
            passwordInput.type = 'text';
            eyeIcon.classList.remove('bi-eye-slash');
            eyeIcon.classList.add('bi-eye');
        });

        // ==========================================
        // 3. TOM SELECT ДЛЯ КОМПАНИЙ
        // ==========================================
        const companySelect = new TomSelect("#companySelect", {
            valueField: 'name',
            labelField: 'name',
            searchField: ['name', 'inn'],
            maxItems: 1,
            create: false,       // Запрещаем создавать новые компании
            createOnBlur: false, // Отключаем создание по потере фокуса
            persist: false,
            load: function (query, callback) {
                if (!query.length) return callback();
                fetch(`/Users/SearchCompanies?term=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(json => callback(json))
                    .catch(() => callback());
            },
            render: {
                option: function (item, escape) {
                    return `<div>
                                    <span class="fw-bold text-dark">${escape(item.name)}</span>
                                    ${item.inn ? `<div class="text-muted small" style="font-size: 0.75rem;">ИНН: ${escape(item.inn)}</div>` : ''}
                                </div>`;
                },
                item: function (item, escape) {
                    return `<div>${escape(item.name)}</div>`;
                },
                no_results: function (data, escape) {
                    // Изменили текст: теперь просто сообщаем, что ничего не найдено
                    return `<div class="p-2 text-muted small">Совпадений не найдено.</div>`;
                }
            }
        });

        // Восстанавливаем текущее значение компании (если есть)
        @if (!string.IsNullOrEmpty(ViewBag.CompanyName as string))
            {
                <text>
                        companySelect.addOption({name: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.CompanyName as string))' });
                        companySelect.addItem('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.CompanyName as string))');
                </text>
        }
    </script>
}