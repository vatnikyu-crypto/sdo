@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редактирование слушателя";
}

<div class="mb-3 mt-2">
    <a href="/Users/Index" class="text-decoration-none text-muted small d-flex align-items-center gap-1">
        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd"
                  d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
        </svg>
        Назад к списку
    </a>
    <h2 class="fw-bold text-dark mt-2 m-0">Редактирование профиля</h2>
    <small class="text-muted">Изменение персональных данных слушателя курсов</small>
</div>

<div class="card card-custom p-4 bg-white border-0 shadow-sm mb-4" style="max-width: 850px; border-radius: 12px;">
    <form asp-action="Edit" asp-controller="Users" method="post">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 small py-2 mb-4" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <!-- ДАННЫЕ АВТОРИЗАЦИИ (ЛОГИН + УПРАВЛЕНИЕ ПАРОЛЕМ) -->
        <h5 class="text-secondary mb-3 fw-bold small text-uppercase tracking-wider">Данные авторизации</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ЛОГИН (НЕИЗМЕНЯЕМЫЙ)</label>
                <input type="text" class="form-control bg-light text-muted" value="@ViewBag.Login" readonly />
            </div>
            <div class="col-md-5">
                <label class="form-label text-muted small fw-bold">ПАРОЛЬ <span class="text-danger">*</span></label>
                <div class="input-group">
                    <!-- Поле пароля (по умолчанию тип password скрывает символы за точки) -->
                    <input id="passwordInput" name="Password" type="password" class="form-control" required
                           value="@ViewBag.Password" placeholder="Введите или сгенерируйте" autocomplete="off" />

                    <!-- Кнопка Глаз (Показать/Скрыть) -->
                    <button class="btn btn-outline-secondary d-flex align-items-center" type="button"
                            id="togglePasswordBtn" title="Показать/Скрыть пароль">
                        <svg id="eyeIcon" xmlns="http://w3.org" width="16" height="16" fill="currentColor"
                             viewBox="0 0 16 16">
                            <path
                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 4 8 4s3.88.668 5.168 1.957A13 13 0 0 1 14.828 8a13 13 0 0 1-1.66 2.043C11.879 11.332 10.119 12 8 12s-3.88-.668-5.168-1.957A13 13 0 0 1 1.173 8" />
                            <path
                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                        </svg>
                    </button>

                    <!-- Кнопка Круговые стрелки (Сгенерировать) -->
                    <button class="btn btn-outline-primary d-flex align-items-center" type="button"
                            id="generatePasswordBtn" title="Сгенерировать новый пароль">
                        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd"
                                  d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                            <path
                            d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <h5 class="text-primary mb-3 fw-bold small text-uppercase tracking-wider">1. Личные данные</h5>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ФАМИЛИЯ <span class="text-danger">*</span></label>
                <input name="LastName" type="text" class="form-control" required autocomplete="off"
                       value="@ViewBag.LastName" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ИМЯ <span class="text-danger">*</span></label>
                <input name="FirstName" type="text" class="form-control" required autocomplete="off"
                       value="@ViewBag.FirstName" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ОТЧЕСТВО</label>
                <input name="MiddleName" type="text" class="form-control" autocomplete="off"
                       value="@ViewBag.MiddleName" />
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ПОЛ <span class="text-danger">*</span></label>
                <select name="Gender" class="form-select">
                    <option value="0" selected="@(ViewBag.Gender == 0 ? "selected" : null)">Мужской</option>
                    <option value="1" selected="@(ViewBag.Gender == 1 ? "selected" : null)">Женский</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">ДАТА РОЖДЕНИЯ</label>
                <input name="BirthDate" type="date" class="form-control" value="@ViewBag.BirthDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold">СНИЛС</label>
                <input name="Snils" type="text" class="form-control" placeholder="123-456-789 01" autocomplete="off"
                       value="@ViewBag.Snils" />
            </div>
        </div>
        <h5 class="text-primary mb-3 fw-bold small text-uppercase tracking-wider">2. Организация</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6 position-relative">
                <label class="form-label text-muted small fw-bold">КОМПАНИЯ (ЖИВОЙ ПОИСК ПО БД) <span
                    class="text-danger">*</span></label>
                    <input id="companySearchInput" name="CompanyName" type="text" class="form-control"
                           placeholder="Начните вводить название..." required autocomplete="off"
                           value="@ViewBag.CompanyName" />

                    <div id="companyDropdownMenu" class="dropdown-menu w-100 shadow-sm border mt-1"
                         style="display: none; max-height: 200px; overflow-y: auto;">
                        <!-- Результаты поиска LIKE -->
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">ПОДРАЗДЕЛЕНИЕ / ОТДЕЛЕНИЕ</label>
                    <input name="Department" type="text" class="form-control" placeholder="Например, Отдел логистики"
                           autocomplete="off" value="@ViewBag.Department" />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold">ДОЛЖНОСТЬ</label>
                    <input name="Position" type="text" class="form-control"
                           autocomplete="off" value="@ViewBag.Position" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow-sm">Сохранить изменения</button>
                <a href="/Users/Index" class="btn btn-light px-4 py-2 fw-bold border text-secondary">Отмена</a>
            </div>
        </form>
    </div>

    <!-- ИНТЕРAКТИВНЫЙ СКРИПТ ДЛЯ ПАРОЛЯ И ЖИВОГО ПОИСКА -->
    <script>
        const passwordInput = document.getElementById('passwordInput');
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const generatePasswordBtn = document.getElementById('generatePasswordBtn');
        const eyeIcon = document.getElementById('eyeIcon');

        // 1. ЛОГИКА КНОПКИ ГЛАЗА: Переключение типа поля (password <-> text)
        togglePasswordBtn.addEventListener('click', function () {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                // Меняем иконку глаза на перечеркнутый глаз с помощью изменения SVG пути
                eyeIcon.innerHTML = `<path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a12 12 0 0 0-2.79.388l.77.77c.646-.145 1.345-.218 2.02-.218 4.12 0 6.88 2.332 8.168 4.443A13 13 0 0 1 14.828 8c-.642 1.055-1.573 2.053-2.613 2.871l.744.744ZM8 3.5a.5.5 0 0 0-.5.5v1.1a1 1 0 0 1-1-1V4a.5.5 0 0 0-1 0v.5a2 2 0 0 0 2 2h.5a.5.5 0 0 0 0-1H8a1 1 0 0 1-1-1V4a.5.5 0 0 0 .5-.5ZM1.173 8a13 13 0 0 0 1.66 2.043C4.12 11.332 5.88 12 8 12c1.68 0 3.19-.445 4.364-1.157l.79.79c-1.39.873-3.1 1.367-5.154 1.367-5 0-8-5.5-8-5.5s.939-1.721 2.641-3.238l.732.732A13 13 0 0 0 1.173 8Z"/>
                                     <path d="M5.5 8a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0ZM4.5 8a3.5 3.5 0 1 0 7 0 3.5 3.5 0 0 0-7 0Z"/>
                                     <line x1="1" y1="1" x2="15" y2="15" stroke="currentColor" stroke-width="1.5"/>`;
            } else {
                passwordInput.type = 'password';
                // Возвращаем стандартный открытый глаз
                eyeIcon.innerHTML = `<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 4 8 4s3.88.668 5.168 1.957A13 13 0 0 1 14.828 8a13 13 0 0 1-1.66 2.043C11.879 11.332 10.119 12 8 12s-3.88-.668-5.168-1.957A13 13 0 0 1 1.173 8"/>
                                     <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>`;
            }
        });

        // 2. ЛОГИКА КНОПКИ ГЕНЕРАЦИИ: Мгновенное создание нового 10-значного пароля
        generatePasswordBtn.addEventListener('click', function () {
            const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
            let newPassword = "";
            for (let i = 0; i < 10; i++) {
                newPassword += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            passwordInput.value = newPassword;

            // Автоматически переключаем тип поля в text, чтобы админ сразу видел сгенерированный пароль
            passwordInput.type = 'text';
        });

        // 3. ЖИВОЙ ПОИСК КОМПАНИИ ПО БД
        const searchInput = document.getElementById('companySearchInput');
        const dropdownMenu = document.getElementById('companyDropdownMenu');

        searchInput.addEventListener('input', async function () {
            const text = this.value.trim();
            if (text.length < 1) { dropdownMenu.style.display = 'none'; return; }

            try {
                const response = await fetch(`/Users/SearchCompanies?term=${encodeURIComponent(text)}`);
                const companies = await response.json();
                dropdownMenu.innerHTML = '';

                if (companies.length === 0) {
                    const noResult = document.createElement('span');
                    noResult.className = 'dropdown-item text-muted small';
                    noResult.textContent = 'Ничего не найдено';
                    dropdownMenu.appendChild(noResult);
                } else {
                    companies.forEach(company => {
                        const item = document.createElement('a');
                        item.className = 'dropdown-item small py-2';
                        item.href = '#';
                        item.textContent = company.name;

                        item.addEventListener('click', function (e) {
                            e.preventDefault();
                            searchInput.value = company.name;
                            dropdownMenu.style.display = 'none';
                        });
                        dropdownMenu.appendChild(item);
                    });
                }
                dropdownMenu.style.display = 'block';
            } catch (error) { console.error(error); }
        });

        document.addEventListener('click', function (e) {
            if (e.target !== searchInput && e.target !== dropdownMenu) { dropdownMenu.style.display = 'none'; }
        });
    </script>
