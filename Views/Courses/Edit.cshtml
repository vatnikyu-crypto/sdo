@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редактирование учебного курса";
}

<!-- НАВИГАЦИОННАЯ ШАПКА -->
<div class="mb-3 mt-2">
    <a href="/Courses/Index" class="text-decoration-none text-muted small d-flex align-items-center gap-1">
        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Назад к курсам
    </a>
    <h2 class="fw-bold text-dark mt-2 m-0">Редактирование курса</h2>
    <small class="text-muted">Изменение названия, описания или маркетинговой обложки курса</small>
</div>

<!-- КАРТОЧКА С ФОРМОЙ -->
<div class="card card-custom p-4 bg-white border-0 shadow-sm mb-4" style="max-width: 700px; border-radius: 12px;">
    <!-- Передаем ID курса в параметрах роута формы -->
    <form href="/Courses/Edit/@ViewBag.Id" method="post" enctype="multipart/form-data">
        
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 small py-2 mb-4" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <!-- НАЗВАНИЕ КУРСА -->
        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">НАЗВАНИЕ КУРСА <span class="text-danger">*</span></label>
<input name="Title" type="text" class="form-control" required autocomplete="off" value="@ViewBag.CourseTitle" />        </div>

        <!-- ОПИСАНИЕ КУРСА -->
        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">КРАТКОЕ ОПИСАНИЕ</label>
            <textarea name="Description" class="form-control" rows="4" autocomplete="off">@ViewBag.Description</textarea>
        </div>
        <!-- ВЫБОР И ИНТЕРAКТИВНЫЙ ПРЕДПРОСМОТР КАРТИНКИ -->
        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">ОБЛОЖКА КУРСА (ИЗОБРАЖЕНИЕ)</label>
            <input type="file" name="imageFile" id="courseImageFileInput" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <div class="form-text text-muted small">Оставьте поле пустым, если не хотите менять текущую обложку. Разрешены: .jpg, .png, .webp.</div>
            
            <!-- Блок предпросмотра (при редактировании он сразу показывает ТЕКУЩУЮ обложку из базы) -->
            <div class="mt-3 text-start" id="previewImageContainer">
                <p class="text-muted small fw-bold mb-1" id="previewLabelText">ТЕКУЩАЯ ОБЛОЖКА КУРСА:</p>
                <div style="width: 240px; height: 135px; border-radius: 8px; overflow: hidden; background-color: #eaecf4;">
                    <img id="courseImagePreview" src="@ViewBag.ImageUrl" alt="Предпросмотр обложки" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
            </div>
        </div>

        <!-- КНОПКИ УПРАВЛЕНИЯ -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow-sm">Сохранить изменения</button>
            <a href="/Courses/Index" class="btn btn-light px-4 py-2 fw-bold border text-secondary">Отмена</a>
        </div>
    </form>
</div>

<!-- СKРИПТ ДЛЯ ЖИВОЙ СМЕНЫ ПРЕДПРОСМОТРА КАРТИНКИ -->
<script>
    const fileInput = document.getElementById('courseImageFileInput');
    const previewLabelText = document.getElementById('previewLabelText');
    const previewImage = document.getElementById('courseImagePreview');

    fileInput.addEventListener('change', function() {
        const file = this.files;
        
        if (file) {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                // Меняем текст надписи, чтобы админ понял, что видит новый файл до сохранения
                previewLabelText.innerHTML = '<span class="text-success">✨ ВЫБРАНА НОВАЯ ОБЛОЖКА (ЕЩЕ НЕ СОХРАНЕНА):</span>';
            }
            
            reader.readAsDataURL(file);
        }
    });
</script>
