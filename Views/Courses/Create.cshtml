@{
    Layout = "_AdminLayout"; // Изучаем админский Layout с боковым меню
    ViewData["Title"] = "Создание учебного курса";
}

<!-- НАВИГАЦИОННАЯ ШАПКА -->
<div class="mb-3 mt-2">
    <a href="/Courses/Index" class="text-decoration-none text-muted small d-flex align-items-center gap-1">
        <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Назад к курсам
    </a>
    <h2 class="fw-bold text-dark mt-2 m-0">Новый курс</h2>
    <small class="text-muted">Регистрация карточки курса и загрузка маркетинговой обложки</small>
</div>

<!-- КАРТОЧКА С ФОРМОЙ -->
<div class="card card-custom p-4 bg-white border-0 shadow-sm mb-4" style="max-width: 700px; border-radius: 12px;">
    <!-- Критически важно: enctype позволяет отправлять файлы (картинки) через форму -->
    <form asp-action="Create" asp-controller="Courses" method="post" enctype="multipart/form-data">
        
        <!-- Вывод серверных ошибок валидации -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 small py-2 mb-4" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <!-- НАЗВАНИЕ КУРСА -->
        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">НАЗВАНИЕ КУРСА <span class="text-danger">*</span></label>
            <input name="Title" type="text" class="form-control" required 
                   placeholder="Например: Безопасность на высоте при строительных работах" autocomplete="off"/>
        </div>

        <!-- ОПИСАНИЕ КУРСА -->
        <div class="mb-3">
            <label class="form-label text-muted small fw-bold">КРАТКОЕ ОПИСАНИЕ</label>
            <textarea name="Description" class="form-control" rows="4" 
                      placeholder="Опишите, для кого предназначен этот курс, какие навыки получат слушатели..." autocomplete="off">@ViewBag.Description</textarea>
        </div>
        <!-- ВЫБОР И ПРЕДПРОСМОТР КАРТИНКИ -->
        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">ОБЛОЖКА КУРСА (ИЗОБРАЖЕНИЕ)</label>
            <input type="file" name="imageFile" id="courseImageFileInput" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <div class="form-text text-muted small">Рекомендуемый формат: 16:9 (.jpg, .png, .webp). Если файл не выбран, система установит стандартную обложку.</div>
            
            <!-- Скрытый по умолчанию блок для отображения выбранной картинки -->
            <div class="mt-3 text-start d-none" id="previewImageContainer">
                <p class="text-muted small fw-bold mb-1">ПРЕДПРОСМОТР ОБЛОЖКИ:</p>
                <div style="width: 240px; height: 135px; border-radius: 8px; overflow: hidden; background-color: #eaecf4;">
                    <img id="courseImagePreview" src="#" alt="Предпросмотр" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
            </div>
        </div>

        <!-- КНОПКИ УПРАВЛЕНИЯ -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success px-4 py-2 fw-bold shadow-sm">Создать карточку курса</button>
            <a href="/Courses/Index" class="btn btn-light px-4 py-2 fw-bold border text-secondary">Отмена</a>
        </div>
    </form>
</div>

<!-- JAVASCRIPT ДЛЯ ИНТЕРAКТИВНОГО ПРЕДПРОСМОТРА ОБЛОЖКИ -->
<script>
    const fileInput = document.getElementById('courseImageFileInput');
    const previewContainer = document.getElementById('previewImageContainer');
    const previewImage = document.getElementById('courseImagePreview');

    fileInput.addEventListener('change', function() {
        const file = this.files[0];
        
        if (file) {
            const reader = new FileReader();
            
            // Как только файл прочитан браузером локально, подставляем его в src картинки
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove('d-none'); // Показываем блок предпросмотра
            }
            
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add('d-none'); // Скрываем блок, если выбор отменен
        }
    });
</script>
