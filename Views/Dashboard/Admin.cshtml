@{
    // Подключаем персональный шаблон
    Layout = "_AdminLayout";
    ViewData["Title"] = "Кабинет Администратора";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-accent: #F59E0B;
    }

    /* Приветственный баннер */
    .hero-banner {
        background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-dark) 100%);
        border-radius: 16px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(79, 88, 157, 0.2);
    }

    /* Декоративные круги на баннере */
    .hero-banner::before,
    .hero-banner::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
    }

    .hero-banner::before {
        width: 200px;
        height: 200px;
        top: -50px;
        right: -50px;
    }

    .hero-banner::after {
        width: 300px;
        height: 300px;
        bottom: -100px;
        right: 10%;
    }

    /* Карточки быстрого доступа */
    .quick-link-card {
        border: 1px solid var(--brand-gray);
        border-radius: 16px;
        background: #ffffff;
        transition: all 0.3s ease;
        text-decoration: none;
        display: block;
        color: inherit;
    }

    .quick-link-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
        border-color: var(--brand-primary);
    }

    /* Иконки в карточках */
    .icon-box {
        width: 55px;
        height: 55px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .icon-users {
        background: #e0e7ff;
        color: #4338ca;
    }

    .icon-courses {
        background: #dcfce7;
        color: #15803d;
    }

    .icon-groups {
        background: #fef3c7;
        color: #b45309;
    }

    .icon-companies {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .quick-link-card h5 {
        font-weight: 700;
        margin-bottom: 0.3rem;
        color: #333;
    }

    .quick-link-card p {
        font-size: 0.85rem;
        color: #777;
        margin: 0;
    }
</style>

<!-- 1. ПРИВЕТСТВЕННЫЙ БАННЕР -->
<div class="hero-banner p-4 p-md-5 mb-4 mt-2">
    <div class="row align-items-center position-relative" style="z-index: 1;">
        <div class="col-md-8">
            <span class="badge bg-white text-primary mb-3 px-3 py-2 rounded-pill fw-bold"
                  style="letter-spacing: 0.5px;">АДМИНИСТРАТОР</span>
            <h1 class="fw-bold mb-2">Добро пожаловать! 👋</h1>
            <p class="fs-5 mb-0 opacity-75">Вы находитесь в рабочей области управления системой дистанционного обучения.
                Выберите нужный раздел ниже или используйте меню слева.</p>
            </div>
            <div class="col-md-4 text-center d-none d-md-block">
                <i class="bi bi-person-workspace" style="font-size: 7rem; opacity: 0.2;"></i>
            </div>
        </div>
    </div>

    <!-- 2. КАРТОЧКИ БЫСТРОГО ДОСТУПА -->
    <h5 class="fw-bold text-dark mb-3">Быстрый доступ</h5>
    <div class="row g-4 mb-4">
    
        <!-- Карточка: Пользователи -->
        <div class="col-md-6 col-xl-3">
            <a href="/Users/Index" class="quick-link-card p-4 h-100">
                <div class="icon-box icon-users">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h5>Пользователи</h5>
                <p>Управление учетными записями обучающихся и сотрудников</p>
            </a>
        </div>

        <!-- Карточка: Курсы -->
        <div class="col-md-6 col-xl-3">
            <a href="/Courses/Index" class="quick-link-card p-4 h-100">
                <div class="icon-box icon-courses">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <h5>Учебные курсы</h5>
                <p>Создание и редактирование программ обучения</p>
            </a>
        </div>

        <!-- Карточка: Группы -->
        <div class="col-md-6 col-xl-3">
            <a href="/Groups/Index" class="quick-link-card p-4 h-100">
                <div class="icon-box icon-groups">
                    <i class="bi bi-collection-fill"></i>
                </div>
                <h5>Учебные группы</h5>
                <p>Формирование групп, привязка курсов и выдача доступов</p>
            </a>
        </div>

        <!-- Карточка: Компании -->
        <div class="col-md-6 col-xl-3">
            <a href="/Companies/Index" class="quick-link-card p-4 h-100">
                <div class="icon-box icon-companies">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <h5>Компании</h5>
                <p>Справочник компаний</p>
            </a>
        </div>

    </div>

    <!-- 3. СИСТЕМНАЯ ИНФОРМАЦИЯ -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <!-- Иконка (flex-shrink-0 запрещает ей сжиматься) -->
                        <div class="text-primary fs-4 flex-shrink-0 mt-1">
                            <i class="bi bi-info-circle-fill"></i>
                        </div>
                        <!-- Текст (flex-grow-1 заставляет его занять всё оставшееся место) -->
                        <div class="flex-grow-1">
                            <span class="fw-bold text-dark d-block mb-1">Совет:</span>
                            <span class="text-muted small" style="line-height: 1.5;">
                                Не забывайте регулярно проверять раздел «Отчетность» и «Проверка заданий», чтобы быть в
                                курсе успеваемости обучающихся.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>