@model SdoApp.Models.ViewModels.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Панель управления";
}

<div class="mb-4 mt-2">
    <h3 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
        <i class="bi bi-speedometer2 text-primary fs-3"></i> Рабочий стол администратора
    </h3>
    <p class="text-muted small mb-0">Сводка по активности системы на @DateTime.Now.ToString("dd MMMM yyyy") г.</p>
</div>

<!-- 1. КАРТОЧКИ KPI (Верхний ряд) -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-4">
    <!-- Студенты -->
    <div class="col">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #4e73df !important; border-radius: 12px; overflow: hidden;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Студенты</h6>
                    <h3 class="m-0 fw-bold text-dark">@Model.TotalStudents</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Задания на проверку -->
    <div class="col">
        <a href="/AssignmentReview/Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #f6c23e !important; border-radius: 12px; overflow: hidden;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Ждут проверки</h6>
                        <h3 class="m-0 fw-bold text-dark">@Model.PendingAssignmentsCount</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 56px; height: 56px;">
                        <i class="bi bi-inbox-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Тикеты поддержки -->
    <div class="col">
        <a href="/Support/AdminIndex" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #e74a3b !important; border-radius: 12px; overflow: hidden;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Тикеты ОТКРЫТЫ</h6>
                        <h3 class="m-0 fw-bold text-dark">@Model.OpenTicketsCount</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 56px; height: 56px;">
                        <i class="bi bi-tools fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Курсы -->
    <div class="col">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #1cc88a !important; border-radius: 12px; overflow: hidden;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Активные курсы</h6>
                    <h3 class="m-0 fw-bold text-dark">@Model.ActiveCoursesCount</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="bi bi-journal-bookmark-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- 2. ЛЕВАЯ КОЛОНКА: ЗАДАНИЯ НА ПРОВЕРКУ -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0"><i class="bi bi-hourglass-split text-warning me-2"></i> Ожидают проверки</h6>
                <a href="/AssignmentReview/Index" class="btn btn-sm btn-outline-primary fw-bold rounded-3" style="font-size: 0.75rem;">Все задания</a>
            </div>
            <div class="card-body">
                @if (!Model.PendingAssignments.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check2-circle fs-1 text-success opacity-50 d-block mb-2"></i>
                        <h6 class="fw-bold">Все задания проверены!</h6>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-nowrap">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th>Студент</th>
                                    <th>Курс / Задание</th>
                                    <th class="text-end">Действие</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PendingAssignments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@item.Student?.LastName @item.Student?.FirstName</div>
                                            <span class="text-muted small">@item.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                        </td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;" title="@item.CourseMaterial?.Course?.Title">
                                                @item.CourseMaterial?.Course?.Title
                                            </div>
                                            <span class="badge bg-secondary mt-1">@item.CourseMaterial?.Title</span>
                                        </td>
                                        <td class="text-end">
                                            <a href="/AssignmentReview/Index" class="btn btn-sm btn-warning fw-bold rounded-3" style="font-size: 0.75rem;">
                                                <i class="bi bi-pencil-square"></i> Проверить
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. ПРАВАЯ КОЛОНКА: СТАТИСТИКА И АУДИТ -->
    <div class="col-lg-5">
        
        <!-- Статистика тестирования за СЕГОДНЯ -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-bar-chart-fill text-primary me-2"></i> Результаты тестов за сегодня
                </h6>
                @{
                    int totalAttempts = Model.PassedTests + Model.FailedTests;
                    int passPercent = totalAttempts > 0 ? (int)((double)Model.PassedTests / totalAttempts * 100) : 0;
                }
                <div class="d-flex justify-content-between small fw-bold mb-1">
                    <span class="text-success">Сдали (@Model.PassedTests)</span>
                    <span class="text-danger">Провалили (@Model.FailedTests)</span>
                </div>
                <div class="progress mb-2" style="height: 12px; border-radius: 10px;">
                    <div class="progress-bar bg-success progress-bar-striped" role="progressbar" style="width: @passPercent%"></div>
                    <div class="progress-bar bg-danger" role="progressbar" style="width: @(100 - passPercent)%"></div>
                </div>
                <div class="text-muted small text-center mt-2">Всего попыток сегодня: @totalAttempts</div>
            </div>
        </div>

        <!-- Мини-лента аудита -->
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark m-0"><i class="bi bi-shield-check text-secondary me-2"></i> Последние действия</h6>
                <a href="/AuditLogs/Index" class="text-muted small text-decoration-none">Весь журнал</a>
            </div>
            <div class="card-body p-3">
                <div class="d-flex flex-column gap-3">
                    @if (!Model.RecentAuditLogs.Any())
                    {
                        <div class="text-muted small text-center py-2">Записей пока нет.</div>
                    }
                    else
                    {
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <div class="d-flex gap-3">
                                <div class="mt-1">
                                    @if (log.Action == "Login") { <i class="bi bi-box-arrow-in-right text-success fs-5"></i> }
                                    else if (log.Action == "Delete") { <i class="bi bi-trash text-danger fs-5"></i> }
                                    else if (log.Action == "Create") { <i class="bi bi-plus-circle text-primary fs-5"></i> }
                                    else if (log.Action == "Export") { <i class="bi bi-file-earmark-excel text-info fs-5"></i> }
                                    else { <i class="bi bi-info-circle text-secondary fs-5"></i> }
                                </div>
                                <div>
                                    <div class="small text-dark fw-bold">@(log.User != null ? $"{log.User.LastName} {log.User.FirstName}" : "Система")</div>
                                    <div class="small text-muted" style="font-size: 0.75rem; line-height: 1.3;">@log.Description</div>
                                    <div class="text-muted mt-1" style="font-size: 0.65rem;">@log.Timestamp.ToLocalTime().ToString("dd.MM HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>