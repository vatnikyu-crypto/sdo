@model IEnumerable<SdoApp.Models.GroupCourseConfig>
@{
    // ИСПРАВЛЕНО: Теперь студент изолирован от админки и видит только свой чистый интерфейс
    Layout = "_StudentLayout";
    ViewData["Title"] = "Личный кабинет слушателя";

    var progressMap = ViewBag.StudentProgress as Dictionary<int, SdoApp.Models.CourseProgress> ?? new Dictionary<int,
    SdoApp.Models.CourseProgress>();
    var fullName = User.FindFirst("FullName")?.Value ?? "Слушатель";
}

<style>
    .student-banner {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
        border-radius: 12px;
        color: white;
    }

    .course-student-card {
        border: 1px solid #e3e6f0;
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
        background: #fff;
    }

    .course-student-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06) !important;
    }

    .course-cover-img {
        height: 160px;
        object-fit: cover;
        border-top-left-radius: 11px;
        border-top-right-radius: 11px;
        background-color: #eaecf4;
    }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .status-badge.completed {
        background-color: rgba(28, 200, 138, 0.15);
        color: #1cc88a;
        border: 1px solid #1cc88a;
    }

    .status-badge.learning {
        background-color: rgba(7e, 115, 223, 0.15);
        color: #4e73df;
        border: 1px solid #4e73df;
    }
</style>

<!-- ПРИВЕТСТВЕННЫЙ БАННЕР -->
<div class="p-4 p-md-5 mb-4 student-banner shadow-sm d-flex align-items-center justify-content-between">
    <div>
        <span class="badge bg-white text-success fw-bold text-uppercase mb-2"
              style="font-size:0.7rem; tracking-wider: 1px;">Обучение заведено</span>
        <h1 class="fw-bold m-0">Приветствуем, @fullName!</h1>
        <p class="lead small opacity-75 mt-1 mb-0">Ниже представлены ваши доступные учебные программы и статус их
            выполнения.</p>
        </div>
        <div class="d-none d-md-block" style="font-size: 4rem;">🎓</div>
    </div>

    <div class="mb-3">
        <h4 class="fw-bold text-dark m-0">Мои учебные курсы</h4>
        <small class="text-muted">Программы, назначенные вашей учебной группе администратором</small>
    </div>
    <!-- СЕТКА ДОСТУПНЫХ СТУДЕНТУ КУРСОВ -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
        @if (!Model.Any())
        {
            <div class="col-12 w-100 text-center py-5 bg-white border rounded-3 shadow-sm"
                 style="border-radius: 12px !important;">
                <span style="font-size: 3.5rem;">📅</span>
                <h5 class="fw-bold mt-2 text-dark">Вам пока не назначено ни одного курса</h5>
                <p class="text-muted small mb-0">Ожидайте, пока администратор СДО привяжет учебный курс к вашей группе.</p>
            </div>
        }
        else
        {
            @foreach (var config in Model)
            {
                // Проверяем статус зачета по текущему CourseId
                bool isCoursePassed = false;
                string completionDateStr = "";

                if (progressMap.TryGetValue(config.CourseId, out var progress))
                {
                    isCoursePassed = progress.IsCompleted;
                    if (progress.CompletedAt.HasValue)
                    {
                        completionDateStr = progress.CompletedAt.Value.ToString("dd.MM.yyyy");
                    }
                }

                <div class="col">
                    <div class="card h-100 course-student-card border-0 shadow-sm d-flex flex-column justify-content-between">
                        <div>
                            <!-- Обложка курса -->
                            <img src="@(string.IsNullOrEmpty(config.Course?.ImageUrl) ? "/uploads/courses/default-course.jpg" : config.Course.ImageUrl)"
                                 class="card-img-top course-cover-img" alt="Обложка курса" />

                            <div class="p-4">
                                <!-- Блок статуса зачета -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    @if (isCoursePassed)
                                    {
                                        <span class="status-badge completed">✅ КУРС СДАН</span>
                                        <small class="text-muted font-monospace" style="font-size:0.75rem;">Зачет:
                                            @completionDateStr</small>
                                        }
                                else
                                        {
                                            <span class="status-badge learning">📖 ИЗУЧАЕТСЯ</span>
                                            <small class="text-muted font-monospace" style="font-size:0.75rem;">В процессе</small>
                                        }
                                    </div>

                                    <!-- Название и описание курса -->
                                    <h5 class="card-title fw-bold text-dark mb-2">@config.Course?.Title</h5>
                                    <p class="card-text text-muted small mb-0"
                                       style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(string.IsNullOrEmpty(config.Course?.Description) ? "Описание учебной программы не заполнено."               : config.Course.Description)
                                    </p>
                                </div>
                            </div>

                            <!-- Нижняя панель с кнопкой входа -->
                            <div class="p-4 pt-0 border-0 bg-transparent">
                                <hr class="text-muted opacity-25 mt-0 mb-3" />

                                <!-- Ссылка ведет на страницу изучения материалов курса (наш Moodle-интерфейс, который увидит студент) -->
                                <a href="/CourseMaterials/StudentView?courseId=@config.CourseId"
                                   class="btn @(isCoursePassed ? "btn-outline-success" : "btn-primary") w-100 fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    @(isCoursePassed ? "👀 Просмотреть материалы" : "🚀 Начать обучение")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
