@model IEnumerable<SdoApp.Models.GroupCourseConfig>
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Личный кабинет слушателя";

    var progressMap = ViewBag.StudentProgress as Dictionary<int, SdoApp.Models.CourseProgress> ?? new Dictionary<int,
SdoApp.Models.CourseProgress>();
    var fullName = User.FindFirst("FullName")?.Value ?? "Слушатель";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-accent: #F59E0B;
        --brand-gray: #e2e8f0;
    }

    /* Приветственный баннер */
    .student-banner {
        background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-dark) 100%);
        border-radius: 16px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(79, 88, 157, 0.15);
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
    }

    .student-banner::before {
        content: '';
        position: absolute;
        width: 250px;
        height: 250px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
        top: -80px;
        right: -30px;
    }

    .logo-circle {
        width: 65px;
        height: 65px;
        background-color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        z-index: 1;
    }

    .logo-circle img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    /* Ссылка на карточку */
    .course-card-link {
        display: block;
        height: 100%;
        text-decoration: none;
    }

    /* Карточки курсов */
    .course-student-card {
        border: 1px solid var(--brand-gray);
        border-radius: 12px;
        transition: transform 0.3s, box-shadow 0.3s;
        background: #fff;
        overflow: hidden;
        cursor: pointer;
    }

    .course-card-link:hover .course-student-card {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.06) !important;
        border-color: var(--brand-primary);
    }

    .course-cover-img {
        height: 190px;
        object-fit: cover;
        background-color: #f8fafc;
        border-bottom: 1px solid var(--brand-gray);
    }

    /* Статусы */
    .status-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .status-badge.completed {
        background-color: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .status-badge.learning {
        background-color: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    /* Кнопка */
    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }
    
    /* При наведении на карточку кнопка темнеет, а текст остается БЕЛЫМ */
    .course-card-link:hover .btn-brand {
        background-color: var(--brand-dark);
        color: white !important;
        /* Принудительно белый цвет */
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    /* Чтобы текст на зеленой кнопке (для сданных курсов) тоже не чернел */
    .course-card-link:hover .btn-outline-success {
        color: #198754 !important;
        background-color: rgba(25, 135, 84, 0.1);
        /* Легкий зеленый фон при наведении */
    }

    /* СТИЛИ ДЛЯ УВЕДОМЛЕНИЙ */
    .toast-container-custom {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .custom-toast {
        min-width: 300px;
        max-width: 400px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }

    .custom-toast.success {
        border-left-color: #198754;
    }

    .custom-toast.danger {
        border-left-color: #dc3545;
    }

    .custom-toast.warning {
        border-left-color: #F59E0B;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(120%);
            opacity: 0;
        }
    }
</style>

<div id="toastContainer" class="toast-container-custom"></div>

<!-- ПРИВЕТСТВЕННЫЙ БАННЕР -->
<div class="student-banner d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div class="position-relative" style="z-index: 1;">
        <h4 class="fw-bold m-0 mb-1">Приветствуем, @fullName!</h4>
        <p class="small opacity-75 m-0">Ниже представлены ваши доступные учебные программы.</p>
    </div>
    
    <div class="logo-circle mx-auto mx-md-0">
        <img src="~/logo.png" alt="Логотип" onerror="this.style.display='none'">
    </div>
</div>

<!-- ЗАГОЛОВОК -->
<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-collection-play text-primary fs-5"></i>
        <h5 class="fw-bold text-dark m-0">Мои учебные курсы</h5>
    </div>
    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">
        Всего: @Model.Count()
    </span>
</div>

<!-- СЕТКА -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-5">
    @if (!Model.Any())
    {
        <div class="col-12 w-100 text-center py-5 bg-white border rounded-4 shadow-sm">
            <i class="bi bi-calendar-x fs-1 text-secondary opacity-50 d-block mb-3"></i>
            <h6 class="fw-bold mt-2 text-dark">Вам пока не назначено ни одного курса</h6>
            <p class="text-muted small mb-0">Ожидайте, пока администратор привяжет курс к вашей группе.</p>
        </div>
    }
    else
    {
        @foreach (var config in Model)
        {
            bool isCoursePassed = progressMap.TryGetValue(config.CourseId, out var progress) && progress.IsCompleted;
            
            var startDate = config.CourseStartDate ?? config.Group?.StartDate;
            var endDate = config.CourseEndDate ?? config.Group?.EndDate;
            
            string completionDateStr = "";
            if (progress != null && progress.CompletedAt.HasValue)
            {
                completionDateStr = progress.CompletedAt.Value.ToString("dd.MM.yyyy");
            }

            <div class="col">
                <a href="/CourseMaterials/StudentView?courseId=@config.CourseId" class="course-card-link">
                    <div class="card h-100 course-student-card shadow-sm d-flex flex-column">
                        <div>
                            <img src="@(string.IsNullOrEmpty(config.Course?.ImageUrl) ? "/uploads/courses/default-course.jpg" : config.Course.ImageUrl)"
                                 class="card-img-top course-cover-img" alt="Обложка курса" />

                            <div class="p-3 pb-2">
                                <!-- СТАТУС И СРОКИ ОБУЧЕНИЯ НА ОДНОЙ ЛИНИИ -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    @if (isCoursePassed)
                                    {
                                        <span class="status-badge completed">
                                            <i class="bi bi-patch-check-fill"></i> СДАН
                                        </span>
                                        <small class="text-muted fw-bold" style="font-size:0.75rem;">
                                            Зачет: @completionDateStr
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="status-badge learning">
                                            <i class="bi bi-clock-history"></i> В ПРОЦЕССЕ
                                        </span>
                                        <!-- Перенесли сюда сроки обучения, убрав "До:" -->
                                        <small class="text-secondary fw-semibold" style="font-size:0.75rem;">
                                            @if (startDate.HasValue && endDate.HasValue)
                                            {
                                                <span>@startDate.Value.ToString("dd.MM.yyyy") —
                                                    @endDate.Value.ToString("dd.MM.yyyy")</span>
                                                }
                                            else if (endDate.HasValue)
                                                {
                                                    <span>@endDate.Value.ToString("dd.MM.yyyy")</span>
                                                }
                                            </small>
                                        }
                                    </div>

                                    <!-- Название -->
                                    <h6 class="card-title fw-bold text-dark mb-2"
                                        style="min-height: 2.4em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @config.Course?.Title
                                    </h6>

                                    <!-- Описание (максимум 2 строки) -->
                                    @if (!string.IsNullOrEmpty(config.Course?.Description))
                                    {
                                        <p class="card-text text-muted small mb-0"
                                           style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @config.Course.Description
                                        </p>
                                    }
                                </div>
                            </div>

                            <!-- Кнопка -->
                            <div class="px-3 pb-3 pt-0 mt-auto bg-transparent">
                                <span
                                    class="btn @(isCoursePassed ? "btn-outline-success" : "btn-brand") w-100 fw-bold py-1.5 shadow-sm d-flex align-items-center justify-content-center gap-2 rounded-3"
                                    style="font-size: 0.85rem;">
                                    @if (isCoursePassed)
                                    {
                                        <i class="bi bi-eye"></i> <span>Просмотреть</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-play-circle"></i> <span>Начать обучение</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>

    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `custom-toast ${type}`;
            let iconClass = 'bi-check-circle-fill text-success';
            if (type === 'danger') iconClass = 'bi-exclamation-triangle-fill text-danger';
            if (type === 'warning') iconClass = 'bi-info-circle-fill text-warning';
            toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            @if (Model.Any())
                {
                    <text>
                            setTimeout(() => {
                                showToast('Курсы отсортированы по приоритету сдачи.', 'warning');
                            }, 1000);
                    </text>
            }
        });
    </script>