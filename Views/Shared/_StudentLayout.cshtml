<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - СДО Энергетик</title>
    
    <!-- Иконка вкладки -->
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <!-- Локальный Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Локальные Иконки Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    
    <link rel="stylesheet" href="~/lib/tom-select/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/plyr/plyr.css" />

    <style>
            :root {
                --brand-primary: #4F589D;
                --brand-dark: #3b4382;
                --brand-accent: #F59E0B;
            }

            body {
                background-color: #f4f7f6;
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            }

            /* Стили для навигационной панели */
            .navbar-custom {
                background-color: var(--brand-dark);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            }

            .navbar-brand {
                display: flex;
                align-items: center;
                gap: 14px;
                transition: transform 0.2s ease;
            }

            .navbar-brand:hover {
                transform: scale(1.02);
            }

            /* Белый круг для логотипа в шапке */
            .nav-logo-circle {
                width: 48px;
                height: 48px;
                background-color: #ffffff;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 6px;
                /* Красивая двойная тень */
                box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1), 0 4px 10px rgba(0, 0, 0, 0.2);
            }

            .nav-logo-circle img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

            .brand-text {
                display: flex;
                flex-direction: column;
                line-height: 1.1;
            }

            .brand-title {
                color: #ffffff;
                font-weight: 800;
                font-size: 1.35rem;
                letter-spacing: 1px;
                text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
            }

            .brand-subtitle {
                color: var(--brand-accent);
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
            }

            /* Стили для ссылок меню */
            .navbar-custom .nav-link {
                color: rgba(255, 255, 255, 0.75);
                font-weight: 500;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .navbar-custom .nav-link:hover,
            .navbar-custom .nav-link.active {
                color: white;
                transform: translateY(-1px);
            }

            .navbar-custom .nav-link i {
                font-size: 1.1rem;
            }

            /* Бейдж уведомлений в меню */
            .navbar-custom .badge {
                background-color: var(--brand-accent) !important;
                color: #fff;
                box-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
            }

            /* Блок пользователя */
            .user-profile {
                display: flex;
                align-items: center;
                color: rgba(255, 255, 255, 0.95);
                font-size: 0.95rem;
                font-weight: 500;
                letter-spacing: 0.3px;
            }

            .btn-logout {
                border-color: rgba(255, 255, 255, 0.3);
                color: white;
                transition: all 0.2s;
            }
        
            .btn-logout:hover {
                background-color: #dc3545;
                border-color: #dc3545;
                color: white;
            }
    </style>
</head>

<body>
    <!-- ПЕРЕХВАТЧИК FETCH (ВЫНЕСЕН В ПАРТИАЛ) -->
    @await Html.PartialAsync("_FetchInterceptor")

    <!-- НАВИГАЦИОННАЯ ПАНЕЛЬ СТУДЕНТА -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
        <div class="container">
            
            <!-- ЛОГОТИП И НАЗВАНИЕ -->
            <a class="navbar-brand" href="/Dashboard/Student">
                <div class="nav-logo-circle">
                    <img src="~/logo.png" alt="Логотип" onerror="this.style.display='none'">
                </div>
                <div class="brand-text">
                    <span class="brand-title">СДО</span>
                    <span class="brand-subtitle">"ЭНЕРГЕТИК"</span>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#studentNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="studentNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link" href="/Dashboard/Student">
                            <i class="bi bi-house-door"></i> Мои курсы
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/KnowledgeBase/Index" target="_self">
                            <i class="bi bi-book"></i> База знаний
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-1" href="/Support/StudentIndex" target="_self">
                            <i class="bi bi-tools"></i> Тех. поддержка
                            <!-- Счётчик непрочитанных ответов -->
                            <span id="studentSupportMenuBadge" class="badge rounded-pill d-none"
                                  style="font-size: 0.7rem; padding: 4px 7px; line-height: 1;">0</span>
                        </a>
                    </li>
                </ul>
                
                <!-- Блок пользователя, уведомлений и выхода -->
                <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3 mt-3 mt-lg-0">
                    
                    <!-- 1. ФИО и Должность -->
                    <div class="user-profile d-flex flex-column align-items-lg-end text-lg-end">
                        <span class="fw-bold" style="font-size: 0.95rem;">@User.FindFirst("FullName")?.Value</span>
                        @if (!string.IsNullOrEmpty(User.FindFirst("Position")?.Value))
                        {
                            <span class="text-white-50" style="font-size: 0.75rem; line-height: 1.2;">
                                @User.FindFirst("Position")?.Value
                            </span>
                        }
                    </div>

                    <!-- 2. КОЛОКОЛЬЧИК УВЕДОМЛЕНИЙ -->
                    <div class="dropdown mx-lg-2 text-center">
                        <a href="#" class="text-white position-relative text-decoration-none" id="notifBell"
                           data-bs-toggle="dropdown" aria-expanded="false" style="display: inline-block;">
                            <i class="bi bi-bell-fill fs-5"></i>
                            <!-- Счетчик непрочитанных -->
                            <span id="notifBadge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                                  style="font-size: 0.65rem; 
                                padding: 3px 6px; 
                                min-width: 20px; 
                                height: 20px; 
                                display: inline-flex; 
                                align-items: center; 
                                justify-content: center;
                                box-shadow: 0 0 8px rgba(220, 53, 69, 0.6);">
                                0
                            </span>
                        </a>
                        
                        <!-- Выпадающее окно -->
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-0 mt-2"
                             aria-labelledby="notifBell" style="width: 320px; overflow: hidden; left: auto; right: 0;">
                            <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold m-0 text-dark">Уведомления</h6>
                                <button type="button" id="markAllReadBtn"
                                        class="btn btn-sm btn-link text-primary text-decoration-none fw-bold p-0"
                                        style="font-size: 0.75rem;">Прочитать все</button>
                            </div>
                            <div id="notifListContainer" class="d-flex flex-column text-start"
                                 style="max-height: 300px; overflow-y: auto;">
                                <!-- Уведомления будут здесь -->
                                <div class="text-center text-muted small py-4">Загрузка...</div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Кнопка Выйти -->
                    <a href="/Auth/Logout"
                       class="btn btn-sm btn-outline-light btn-logout fw-bold px-3 rounded-3 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i> Выйти
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ОСНОВНОЙ КОНТЕНТ СТРАНИЦЫ -->
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- СКРИПТЫ -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/tom-select/js/site.js" asp-append-version="true"></script>

    <!-- ОПРОС СЧЁТЧИКА ТЕХПОДДЕРЖКИ -->
    <script>
            async function updateStudentSupportMenuBadge() {
                try {
                    const response = await fetch('/Support/GetStudentUnreadCount');
                    const data = await response.json();
                    const badge = document.getElementById('studentSupportMenuBadge');

                    if (badge && data.count > 0) {
                        badge.textContent = data.count;
                        badge.classList.remove('d-none');
                    } else if (badge) {
                        badge.classList.add('d-none');
                    }
                } catch (err) {
                    console.error('Ошибка обновления счетчика поддержки в меню:', err);
                }
            }

            window.updateStudentSupportBadge = updateStudentSupportMenuBadge;

            document.addEventListener("DOMContentLoaded", updateStudentSupportMenuBadge);

            document.addEventListener("DOMContentLoaded", function () {
                const badge = document.getElementById('notifBadge');
                const listContainer = document.getElementById('notifListContainer');
                const markAllBtn = document.getElementById('markAllReadBtn');

                // 1. Обновление счетчика
                async function updateNotifCount() {
                    try {
                        const res = await fetch('/Notifications/GetUnreadCount');
                        const data = await res.json();
                
                        if (data.count > 0) {
                            badge.textContent = data.count > 99 ? '99+' : data.count;
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    } catch (e) { console.error('Ошибка счетчика', e); }
                }

                // 2. Загрузка последних 5 уведомлений
                async function loadLatestNotifications() {
                    try {
                        const res = await fetch('/Notifications/GetLatest');
                        const data = await res.json();

                        if (data.length === 0) {
                            listContainer.innerHTML = '<div class="text-center text-muted small py-4"><i class="bi bi-bell-slash fs-4 d-block mb-2"></i>Нет новых уведомлений</div>';
                            return;
                        }

                        listContainer.innerHTML = data.map(n => `
                                    <a href="${n.link || '#'}" class="text-decoration-none p-3 border-bottom notif-item ${n.isRead ? 'bg-white' : 'bg-light'}" style="transition: 0.2s;">
                                        <div class="d-flex gap-2">
                                            <div class="text-primary mt-1"><i class="bi bi-info-circle-fill"></i></div>
                                            <div>
                                                <div class="text-dark small fw-bold" style="line-height: 1.3;">${n.message}</div>
                                                <small class="text-muted" style="font-size: 0.7rem;">${n.date}</small>
                                            </div>
                                        </div>
                                    </a>
                                `).join('');
                    } catch (e) {
                        listContainer.innerHTML = '<div class="text-center text-danger small py-4">Ошибка загрузки</div>';
                    }
                }

                // 3. Обработка кнопки "Прочитать все"
                markAllBtn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();
            
                    try {
                        await fetch('/Notifications/MarkAllAsRead', { method: 'POST' });
                        updateNotifCount();
                        loadLatestNotifications();
                    } catch (e) { console.error(e); }
                });

                // При клике на колокольчик — загружаем список
                document.getElementById('notifBell').addEventListener('click', loadLatestNotifications);

                // Инициализация при загрузке
                updateNotifCount();
        
                // Автообновление счетчика каждые 30 секунд
                setInterval(updateNotifCount, 30000);
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>