@model IEnumerable<SdoApp.Models.Group>
@using System.Text.Encodings.Web
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Отчетность по группам";
    var groupConfigs = ViewBag.GroupConfigs as List<SdoApp.Models.GroupCourseConfig> ?? new();
    var studentsMap = ViewBag.Students as Dictionary<int, SdoApp.Models.User> ?? new();
    var commission = ViewBag.Commission as List<SdoApp.Models.CommissionMember> ?? new();
    var progressMap = ViewBag.ProgressMap as Dictionary<string, string> ?? new Dictionary<string, string>();
    var passedTests = ViewBag.PassedFinalTests as HashSet<string> ?? new HashSet<string>();
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-accent: #F59E0B;
        --brand-gray: #e2e8f0;
    }
    
    .accordion-button:not(.collapsed) {
        background-color: #f0f4ff !important;
        color: var(--brand-primary) !important;
        box-shadow: inset 0 -1px 0 rgba(0, 0, 0, .125);
    }

    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(0, 0, 0, .125);
    }
    
    .table-custom th {
        font-weight: 600;
        color: #6c757d;
        background-color: #f8f9fa;
        border-bottom: 2px solid var(--brand-gray);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-custom td {
        vertical-align: middle;
        font-size: 0.9rem;
    }
    
    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }

    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    /* === ПАГИНАЦИЯ === */
    #groupPaginationButtons {
        gap: 4px;
    }

    #groupPaginationButtons .page-link {
        color: #4F589D !important;
        background-color: #ffffff !important;
        border: 1px solid #e2e8f0 !important;
        font-weight: 700;
        min-width: 38px;
        text-align: center;
        border-radius: 6px !important;
        margin: 0 2px;
        transition: all 0.2s;
    }

    #groupPaginationButtons .page-link:hover {
        background-color: #f0f4ff !important;
        color: #3b4382 !important;
        border-color: #4F589D !important;
    }

    #groupPaginationButtons .page-item.active .page-link {
        background-color: #4F589D !important;
        border-color: #4F589D !important;
        color: #ffffff !important;
        box-shadow: 0 2px 8px rgba(79, 88, 157, 0.35);
    }

    #groupPaginationButtons .page-item.disabled .page-link {
        color: #cbd5e1 !important;
        background-color: #f8f9fa !important;
        border-color: #e2e8f0 !important;
    }

    /* === TOASTS === */
    .toast-container-custom {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .custom-toast {
        min-width: 300px;
        max-width: 400px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }

    .custom-toast.success {
        border-left-color: #198754;
    }

    .custom-toast.danger {
        border-left-color: #dc3545;
    }

    .custom-toast.warning {
        border-left-color: #F59E0B;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(120%);
            opacity: 0;
        }
    }

    /* === КНОПКА МИНТРУД (оранжевая с dropdown) === */
    .btn-import-mintrud {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 8px 18px 8px 8px;
        border: none;
        border-radius: 50px;
        background: linear-gradient(135deg, #FBBF24 0%, #F59E0B 50%, #D97706 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        font-family: inherit;
    }

    .btn-import-mintrud::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        transition: left 0.5s;
    }

    .btn-import-mintrud:hover::before {
        left: 100%;
    }

    .btn-import-mintrud:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(245, 158, 11, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    .btn-import-mintrud:active {
        transform: translateY(-1px);
    }

    .import-logo-circle {
        width: 36px;
        height: 36px;
        background: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        animation: pulseLogo 2.5s infinite ease-in-out;
    }

    .import-logo-circle img {
        width: 22px;
        height: 22px;
        object-fit: contain;
    }

    @@keyframes pulseLogo {

        0%,
        100% {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        50% {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15), 0 0 0 5px rgba(255, 255, 255, 0.3);
        }
    }

    .import-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1.1;
    }

    .import-label {
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
    }

    .import-sublabel {
        font-size: 0.65rem;
        opacity: 0.85;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .import-icon {
        font-size: 1.4rem;
        opacity: 0.9;
        transition: transform 0.3s;
    }

    .btn-import-mintrud:hover .import-icon {
        transform: translateY(3px);
    }

    /* === КНОПКА ФИС ФРДО (фиолетовая) === */
    .btn-import-frdo {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 8px 18px 8px 8px;
        border: none;
        border-radius: 50px;
        background: linear-gradient(135deg, #A78BFA 0%, #8B5CF6 50%, #6366F1 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        font-family: inherit;
    }

    .btn-import-frdo::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        transition: left 0.5s;
    }

    .btn-import-frdo:hover::before {
        left: 100%;
    }

    .btn-import-frdo:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(139, 92, 246, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    .btn-import-frdo:active {
        transform: translateY(-1px);
    }

    .btn-import-frdo .import-logo-circle {
        animation: pulseLogo 2.5s infinite ease-in-out;
    }

    /* Состояние загрузки кнопки */
    .btn-import-frdo.loading {
        opacity: 0.75;
        cursor: not-allowed;
        pointer-events: none;
    }

    .btn-import-frdo.loading .import-logo-circle {
        animation: pulseLogo 1s infinite ease-in-out;
    }

    .btn-import-frdo .spinner-border-sm {
        width: 1.2rem;
        height: 1.2rem;
        border-width: 0.15em;
    }

    /* === КНОПКА СТАТИСТИКИ (изумрудная) === */
    .btn-import-stats {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 8px 18px 8px 8px;
        border: none;
        border-radius: 50px;
        background: linear-gradient(135deg, #34D399 0%, #10B981 50%, #059669 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        font-family: inherit;
    }

    .btn-import-stats::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        transition: left 0.5s;
    }

    .btn-import-stats:hover::before {
        left: 100%;
    }

    .btn-import-stats:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(16, 185, 129, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    .btn-import-stats:active {
        transform: translateY(-1px);
    }

    .btn-import-stats .import-logo-circle {
        animation: pulseLogo 2.5s infinite ease-in-out;
        color: #10B981;
        /* Иконка внутри белого круга будет зеленой */
        font-size: 1.2rem;
    }

    /* Состояние загрузки для кнопки статистики */
    .btn-import-stats.loading {
        opacity: 0.75;
        cursor: not-allowed;
        pointer-events: none;
    }

    .btn-import-stats.loading .import-logo-circle {
        animation: pulseLogo 1s infinite ease-in-out;
    }
</style>

<!-- Контейнер для уведомлений -->
<div id="toastContainer" class="toast-container-custom"></div>

<div class="container mt-4">
    <!-- Шапка с кнопками -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark d-flex align-items-center gap-2 mb-0">
            <i class="bi bi-file-earmark-bar-graph text-primary fs-3"></i> Отчетность по группам
        </h3>
        
        <div class="d-flex gap-2">
            <!-- Кнопка выгрузки статистики -->
            <button class="btn-import-stats" id="btnExportStats" onclick="exportStatistics()"
                    title="Скачать детальную статистику по группам">
                <div class="import-logo-circle">
                    <!-- Иконка внутри белого кружка -->
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <div class="import-text">
                    <span class="import-label" id="statsBtnLabel">СТАТИСТИКА</span>
                    <span class="import-sublabel" id="statsBtnSublabel">Экспорт (Excel)</span>
                </div>
                <i class="bi bi-file-earmark-arrow-down-fill import-icon" id="statsBtnIcon"></i>
            </button>
            <!-- Выпадающая кнопка Минтруд -->
            <div class="dropdown">
                <button class="btn-import-mintrud dropdown-toggle" type="button" id="mintrudDropdown"
                        data-bs-toggle="dropdown" aria-expanded="false" style="border: none;">
                    <div class="import-logo-circle">
                        <img src="~/mintrud.png" alt="Минтруд" onerror="this.style.display='none'" />
                    </div>
                    <div class="import-text">
                        <span class="import-label">МИНТРУД</span>
                        <span class="import-sublabel">Экспорт / Импорт</span>
                    </div>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2"
                    aria-labelledby="mintrudDropdown">
                    <li>
                        <button class="dropdown-item py-2 fw-bold" onclick="generateMintrudXml()">
                            <i class="bi bi-file-earmark-code me-2 text-primary"></i> Экспорт (XML)
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item py-2 fw-bold" onclick="openImportModal()">
                            <i class="bi bi-cloud-arrow-down me-2 text-warning"></i> Импорт (Excel)
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Кнопка ФИС ФРДО -->
            <button class="btn-import-frdo" id="btnExportFrdo" onclick="exportFrdo()"
                    title="Выгрузить реестр для ФИС ФРДО">
                <div class="import-logo-circle">
                    <img src="~/fis-frdo.png" alt="ФИС ФРДО" onerror="this.style.display='none'" />
                </div>
                <div class="import-text">
                    <span class="import-label" id="frdoBtnLabel">ФИС ФРДО</span>
                    <span class="import-sublabel" id="frdoBtnSublabel">Экспорт (Excel)</span>
                </div>
                <i class="bi bi-file-earmark-arrow-down-fill import-icon" id="frdoBtnIcon"></i>
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3">
            <i class="bi bi-info-circle me-2"></i> Нет созданных групп для формирования отчетов.
        </div>
    }
    else
    {
        <!-- Поиск и выбор размера страницы -->
        <div class="row g-3 align-items-center mb-3">
            <div class="col-sm-auto d-flex align-items-center gap-2 small text-muted fw-bold">
                <span>Показать по:</span>
                <select id="groupPageSizeSelect" class="form-select form-select-sm rounded-3 shadow-none"
                        style="width: 80px;">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
            <div class="col-sm ms-auto" style="max-width: 450px;">
                <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                    <span class="input-group-text bg-white text-muted border-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="groupSearchInput" class="form-control border-0 shadow-none"
                           placeholder="Поиск по номеру, названию, студенту или компании..." autocomplete="off" />
                </div>
            </div>
        </div>

        <!-- Чекбокс "Выбрать все" -->
        <div class="d-flex align-items-center mb-3 ps-1">
            <input type="checkbox" id="selectAllGroups" class="form-check-input me-2"
                   style="width: 1.2rem; height: 1.2rem; cursor: pointer;" onchange="toggleSelectAll(this)" />
            <label for="selectAllGroups" class="fw-bold text-muted small mb-0" style="cursor: pointer;">Выбрать все группы
                на странице</label>
                <span id="selectedCountBadge" class="badge bg-primary ms-2 d-none">0</span>
            </div>

            <div class="accordion" id="groupsAccordion">
                @foreach (var group in Model)
                {
                    var currentGroupConfigs = groupConfigs.Where(c => c.GroupId == group.Id).ToList();

                    <div class="accordion-item mb-3 border shadow-sm rounded-3 overflow-hidden group-item"
                         data-group-id="@group.Id">
                        <h2 class="accordion-header" id="headingGroup-@group.Id">
                            <div class="d-flex align-items-center bg-white">
                                <div class="ps-3 pe-1">
                                    <input type="checkbox" class="form-check-input group-checkbox" value="@group.Id"
                                           onchange="updateSelectedCount()" onclick="event.stopPropagation();"
                                           style="width: 1.2rem; height: 1.2rem; cursor: pointer;" />
                                </div>
                                <button class="accordion-button collapsed bg-white text-dark shadow-none p-3 flex-grow-1" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#collapseGroup-@group.Id">
                                    <span class="fs-5">
                                        <span class="text-muted me-2">#@group.Id</span> |
                                        <i class="bi bi-collection text-primary mx-1"></i> <strong>Группа №
                                        @group.GroupNumber</strong>
                                        &nbsp;—&nbsp; @group.Title
                                    </span>
                                    <span class="badge bg-light text-dark border ms-3">
                                        <i class="bi bi-calendar3 me-1"></i> @group.StartDate.ToString("dd.MM.yyyy") -
                                        @group.EndDate.ToString("dd.MM.yyyy")
                                    </span>
                                </button>
                            </div>
                        </h2>
                    
                        <div id="collapseGroup-@group.Id" class="accordion-collapse collapse" data-bs-parent="#groupsAccordion">
                            <div class="accordion-body bg-white p-4">
                            
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                    <h6 class="text-muted fw-bold m-0">
                                        <i class="bi bi-journal-bookmark me-2"></i> Курсы, закрепленные за группой:
                                    </h6>
                                    <div class="d-flex gap-2">
                                        <!-- Кнопка "Присвоить номера" (осталась внутри группы) -->
                                        <button class="btn btn-sm btn-outline-primary fw-bold rounded-3"
                                                onclick="openAssignModal(@group.Id)">
                                            <i class="bi bi-award me-1"></i> Присвоить номера
                                        </button>
                                    </div>
                                </div>
                            
                                @if (!currentGroupConfigs.Any())
                                {
                                    <p class="text-muted fst-italic">За данной группой еще не закреплены курсы.</p>
                                }
                                else
                                {
                                    <div class="accordion" id="coursesAccordion-@group.Id">
                                        @foreach (var config in currentGroupConfigs)
                                        {
                                            var allowedIds = config.AllowedStudentIds?
                                                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                .Select(int.Parse).ToList() ?? new List<int>();
                                        
                                            if (!allowedIds.Any() && group.GroupStudents != null)
                                            {
                                                allowedIds = group.GroupStudents.Select(gs => gs.StudentId).ToList();
                                            }
                                        
                                            var totalStudentsCount = allowedIds.Count(id => studentsMap.ContainsKey(id));

                                            <div class="accordion-item mb-2 border rounded-3 overflow-hidden">
                                                <h2 class="accordion-header" id="headingConfig-@config.Id">
                                                    <button class="accordion-button collapsed bg-light text-dark shadow-none p-3"
                                                            type="button" data-bs-toggle="collapse" data-bs-target="#collapseConfig-@config.Id">
                                                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center w-100 me-3">
                                                            <div class="mb-2 mb-sm-0">
                                                                <span class="text-primary fw-bold fs-6"><i class="bi bi-book me-1"></i>
                                                                    @config.Course?.Title</span>
                                                                    <span class="badge bg-primary rounded-pill ms-2">Слушателей:
                                                                        @totalStudentsCount</span>
                                                                        @if (config.Course?.MintrudProgramId != null)
                                                                        {
                                                                            <span class="badge bg-success rounded-pill ms-1" title="Программа Минтруда">
                                                                                <i class="bi bi-shield-check"></i> Минтруд
                                                                            </span>
                                                                        }
                                                                        <div class="text-muted mt-1" style="font-size: 0.85rem;">
                                                                            Протокол/Приказ: <strong>@config.ProtocolNumber</strong>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </button>
                                                        </h2>
                            
                                                        <div id="collapseConfig-@config.Id" class="accordion-collapse collapse"
                                                             data-bs-parent="#coursesAccordion-@group.Id">
                                                            <div class="accordion-body bg-white border-top p-3">
                                
                                                                <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-2 border rounded shadow-sm">
                                                                    <span class="text-muted fw-semibold ps-2" style="font-size: 0.9rem;">
                                                                        <i class="bi bi-gear me-1"></i> Генерация документов по курсу:
                                                                    </span>
                                                                    <div>
                                                                        @if (config.Course?.DocumentTemplates != null &&
                                                        config.Course.DocumentTemplates.Any())
                                                                        {
                                                                            <div class="dropdown">
                                                                                <button class="btn btn-success btn-sm dropdown-toggle fw-bold"
                                                                                        type="button" data-bs-toggle="dropdown">
                                                                                    <i class="bi bi-download me-1"></i> Сделать отчет
                                                                                </button>
                                                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                                                    @foreach (var template in config.Course.DocumentTemplates.OrderBy(t => t.SortOrder))
                                                                                    {
                                                                                        <li>
                                                                                            <button type="button" class="dropdown-item"
                                                                                                    onclick="openReportSetupModal(@config.Id, @template.Id, @(template.RequiresCommission ? "true" : "false"), @(template.IsPerStudent ? "true" : "false"))">
                                                                                                <i class="bi bi-file-earmark-text me-1"></i> @template.Name
                                                                                                @if (template.RequiresCommission)
                                                                                                {
                                                                                                    <i class="bi bi-briefcase ms-1 text-warning"
                                                                                                       title="Требует комиссию"></i>
                                                                                                }
                                                                                                @if (template.IsPerStudent)
                                                                                                {
                                                                                                    <i class="bi bi-mortarboard ms-1 text-primary" title="На каждого студента"></i>
                                                                                                }
                                                                                            </button>
                                                                                        </li>
                                                                                    }
                                                                                </ul>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button class="btn btn-secondary btn-sm fw-bold" disabled>Сделать отчет (Нет шаблонов)</button>
                                                                        }
                                                                    </div>
                                                                </div>

                                                                <div class="bg-white p-3 rounded border shadow-sm mt-4">
                                                                    <span class="text-muted d-block mb-2 fw-semibold" style="font-size: 0.85rem;">
                                                                        <i class="bi bi-people me-1"></i> Список слушателей (нажмите на строку для просмотра результатов):
                                                                    </span>
                                        


                                                                    @{
                                                                        var courseStudents = allowedIds
                                                                            .Where(id => studentsMap.ContainsKey(id))
                                                                            .Select(id => studentsMap[id])
                                                                            .OrderBy(s => s.LastName)
                                                                            .ToList();
                                                                        int rowNumber = 1;
                                                                    }

                                                                    @if (!courseStudents.Any())
                                                                    {
                                                                        <span class="text-danger d-block p-2" style="font-size: 0.9rem;">Нет допущенных студентов</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="table-responsive">
                                                                            <table class="table table-custom table-hover table-bordered bg-white m-0 align-middle" style="cursor: pointer;">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th style="width: 5%; text-align: center;">№</th>
                                                                                        <th style="width: 35%;">ФИО полностью</th>
                                                                                        <th style="width: 20%;">Должность</th>
                                                                                        <th style="width: 25%;">Организация</th>
                                                                                        <th style="width: 10%;" class="text-center">Результат</th>
                                                                                        <th style="width: 15%;">№ Удостоверения</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @foreach (var student in courseStudents)
                                                                                    {
                                                                                        var fullName = $"{student.LastName} {student.FirstName}                                                   {student.MiddleName}".Trim();
                                                                                        var companyName = student.Company?.Name ?? "Не указана";
                                                                                        var position = string.IsNullOrEmpty(student.Position) ? "—" : student.Position;
                                                                            
                                                                                        var certKey = $"{student.Id}_{config.CourseId}_{config.GroupId}";
                                                                                        string certNumber = progressMap.ContainsKey(certKey) ?
                                                                progressMap[certKey] : null;
                                                                                        var testKey = $"{student.Id}_{config.CourseId}_{config.GroupId}";
                                                                                        bool isPassed = passedTests.Contains(testKey);

                                                                                        <tr onclick="openStudentPushModal(@student.Id, @config.CourseId, @config.GroupId, '@fullName')">
                                                                                            <td style="text-align: center;" class="text-muted">@(rowNumber++)</td>
                                                                                            <td class="fw-bold text-dark"><i
                                                                                                class="bi bi-person me-1 text-muted"></i> @fullName</td>
                                                                                                <td><span class="text-muted">@position</span></td>
                                                                                                <td><span class="badge bg-light text-dark border"><i
                                                                                                    class="bi bi-building me-1"></i> @companyName</span></td>
                                                                                                    <td class="text-center">
    @if (isPassed)
    {
        <span class="badge bg-success text-white px-3 py-2 rounded-pill" style="font-size: 0.75rem; font-weight: 600;">Сдал</span>
    }
    else
    {
        <span class="badge bg-danger text-white px-3 py-2 rounded-pill" style="font-size: 0.75rem; font-weight: 600;">Не сдал</span>
    }
</td>
                                                                                                    <td>
                                                                                                        @if (!string.IsNullOrEmpty(certNumber))
                                                                                                        {
                                                                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fw-bold">
                                                                                                                <i class="bi bi-check-circle me-1"></i> @certNumber
                                                                                                            </span>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                                                                                                Не присвоен
                                                                                                            </span>
                                                                                                        }
                                                                                                    </td>
                                                                                                </tr>
                                                                                            }
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Пагинация -->
                            <div class="d-flex justify-content-between align-items-center px-1 mb-5 mt-3">
                                <div id="groupPaginationInfo" class="small text-muted fw-bold">Показано 0-0 из 0 групп</div>
