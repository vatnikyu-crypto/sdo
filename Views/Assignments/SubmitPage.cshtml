@model SdoApp.Models.ViewModels.AssignmentSubmitViewModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = $"Задание: {Model.Title}";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    .task-instruction-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--brand-gray);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    /* Чат */
    #chatCard {
        height: 650px;
        max-height: calc(100vh - 150px);
    }

    .chat-box {
        background-color: #f4f6f9;
        overflow-y: auto;
        min-height: 0;
    }

    .msg-bubble {
        max-width: 85%;
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 10px;
        font-size: 0.9rem;
    }

    .msg-student {
        background-color: var(--brand-primary);
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 2px;
        box-shadow: 0 2px 8px rgba(79, 88, 157, 0.2);
    }

    .msg-teacher {
        background-color: #fff;
        color: #333;
        margin-right: auto;
        border-bottom-left-radius: 2px;
        border: 1px solid var(--brand-gray);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }

    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
    }

    .file-chip {
        background: #f8fafc;
        border: 1px solid var(--brand-gray);
        border-radius: 8px;
        padding: 4px 8px;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        color: #333;
        text-decoration: none;
    }

    .file-chip:hover {
        background: #e2e8f0;
    }

    /* Стили для скролла */
    .chat-box::-webkit-scrollbar {
        width: 6px;
    }

    .chat-box::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

    /* === TOASTS === */
    .toast-container-custom {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .custom-toast {
        min-width: 300px;
        max-width: 400px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }

    .custom-toast.success {
        border-left-color: #198754;
    }

    .custom-toast.danger {
        border-left-color: #dc3545;
    }

    .custom-toast.warning {
        border-left-color: #F59E0B;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(120%);
            opacity: 0;
        }
    }
</style>

<!-- Контейнер для уведомлений -->
<div id="toastContainer" class="toast-container-custom"></div>

<!-- Навигация назад -->
<div class="mb-3 mt-2">
    <a href="/CourseMaterials/StudentView?courseId=@Model.CourseId&groupId=@Model.GroupId&activeId=@Model.MaterialId"
       class="text-decoration-none text-muted small d-flex align-items-center gap-1 mb-2 fw-semibold">
        <i class="bi bi-arrow-left"></i> Назад к курсу
    </a>
</div>

<div class="row g-4 mb-5">
    <!-- ЛЕВАЯ КОЛОНКА: УСЛОВИЕ ЗАДАНИЯ -->
    <div class="col-lg-5">
        <div class="task-instruction-card p-4 h-100">
            <h4 class="fw-bold text-dark mb-1">@Model.Title</h4>
            <p class="text-muted small mb-4 pb-3 border-bottom">@Model.CourseTitle</p>

            <h6 class="fw-bold text-secondary small text-uppercase mb-3">
                <i class="bi bi-info-circle text-primary me-1"></i> Описание задания
            </h6>
            
            <div class="text-dark mb-4" style="line-height: 1.6; font-size: 0.95rem;">
                @if (string.IsNullOrEmpty(Model.Instruction))
                {
                    <span class="text-muted fst-italic">Инструкция к заданию не указана.</span>
                }
                else
                {
                    @Html.Raw(Model.Instruction)
                }
            </div>

            @if (Model.TaskFiles.Any())
            {
                <div class="mt-4 pt-3 border-top">
                    <span class="d-block text-muted small fw-bold mb-2">Файлы к заданию:</span>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var f in Model.TaskFiles)
                        {
                            <a href="@f.FilePath" download="@f.FileName"
                               class="btn btn-outline-secondary btn-sm fw-bold rounded-3 d-flex align-items-center gap-2 text-truncate">
                                <i class="bi bi-download"></i> <span class="text-truncate">@f.FileName</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: ЧАТ -->
    <div class="col-lg-7">
        <div class="card bg-white border-0 shadow-sm p-0 d-flex flex-column" id="chatCard"
             style="border-radius: 16px; border: 1px solid var(--brand-gray) !important; overflow: hidden;">
            
            <!-- Шапка чата -->
            <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px; background: linear-gradient(135deg, #5b64ab 0%, #4F589D 100%); color: white;">
                        <i class="bi bi-chat-dots-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark m-0">Диалог с преподавателем</h5>
                        <small class="text-muted d-block mt-1" id="chatStatusText">
                            @if (Model.Status == SdoApp.Models.SubmissionStatus.Completed)
                            {
                                <span>Задание
                                    завершено</span>
                                }
                            else if (Model.Status == SdoApp.Models.SubmissionStatus.NeedFix)
                                {

                                    <span>Возвращено на
                                        доработку</span>
                                    }
                            else
                                    {

                                        <span>Ожидает проверки</span>
                                    }
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Лента сообщений -->
                    <div class="chat-box flex-grow-1 m-0 p-4 border-0" id="chatBoxContainer">
                        @if (!Model.Messages.Any())
                        {
                            <div class="text-center text-muted small py-4">Напишите ваше первое сообщение преподавателю...</div>
                        }
                        else
                        {
                            foreach (var msg in Model.Messages)
                            {
                                // Определяем, студент ли это по роли автора
                                bool isStudent = msg.Author != null && msg.Author.Role == SdoApp.Models.UserRole.Обучающийся;
                        
                                string bubbleClass = isStudent ? "msg-student" : "msg-teacher";
                                string nameStyle = isStudent ? "color: rgba(255,255,255,0.8);" : "color: #dc3545;";
                        
                                // Формируем ФИО преподавателя
                                string senderName = isStudent
                                    ? "Вы"
                                    : $"Преподаватель ({(msg.Author != null ? $"{msg.Author.LastName} {msg.Author.FirstName}             {msg.Author.MiddleName}".Trim() : "Администратор")})";

                                <div class="d-flex flex-column w-100">
                                    <div class="msg-bubble @bubbleClass">
                                        <div style="font-size:0.75rem; @nameStyle" class="fw-bold mb-1">@senderName</div>
                                        <div style="font-size:0.9rem; white-space:pre-line;">@msg.TextContent</div>
                                
                                        @{
                                            var hasNewFiles = msg.Files != null && msg.Files.Any();
                                            var hasOldFile = !string.IsNullOrEmpty(msg.FilePath);
                                        }
                                        @if (hasNewFiles || hasOldFile)
                                        {
                                            <div class="mt-2 border-top pt-2">
                                                @if (hasNewFiles)
                                                {
                                                    foreach (var f in msg.Files)
                                                    {
                                                        <a href="@f.FilePath" download="@f.FileName" class="file-chip me-1 mb-1">
                                                            <i class="bi bi-paperclip"></i> @f.FileName
                                                        </a>
                                                    }
                                                }
                                                else if (hasOldFile)
                                                {
                                                    <a href="@msg.FilePath" download class="file-chip">
                                                        <i class="bi bi-paperclip"></i> Скачать файл
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted mb-3 @(isStudent ? "text-end pe-2" : "ps-2")"
                                           style="font-size:0.7rem; margin-top:-8px;">
                                        @msg.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                </div>
                            }
                        }
                    </div>

                    <!-- Форма ввода -->
                    @if (Model.Status != SdoApp.Models.SubmissionStatus.Completed)
                    {
                        <div id="studentReplyFormContainer" class="p-3 bg-white border-top">
                            <form id="studentReplyForm" autocomplete="off" enctype="multipart/form-data">
                                <input type="hidden" id="materialId" value="@Model.MaterialId" />
                                <input type="hidden" id="groupId" value="@Model.GroupId" />
                    
                                <!-- Контейнер для списка выбранных файлов -->
                                <div id="studentFileListContainer" class="d-flex flex-wrap gap-2 mb-2 d-none"></div>

                                <div class="d-flex align-items-end bg-light rounded-4 p-2 border shadow-sm gap-2">
                                    <textarea id="studentReplyText" class="form-control border-0 bg-transparent shadow-none p-2"
                                              rows="2" style="resize: none; max-height: 120px;"
                                              placeholder="Напишите ваше решение..."></textarea>
                            
                                    <input type="file" id="studentReplyFiles" class="d-none" multiple />
                                    <label for="studentReplyFiles"
                                           class="btn btn-light border-0 rounded-circle text-secondary flex-shrink-0 d-flex align-items-center justify-content-center"
                                           style="width: 38px; height: 38px; cursor: pointer;"
                                           title="Прикрепить файлы (макс. 3 шт, до 75 МБ)">
                                        <i class="bi bi-paperclip fs-5"></i>
                                    </label>
                            
                                    <button type="button" id="studentSubmitReplyBtn"
                                            class="btn btn-brand rounded-circle flex-shrink-0 shadow-sm d-flex align-items-center justify-content-center"
                                            style="width: 38px; height: 38px; padding: 0;" title="Отправить">
                                        <i class="bi bi-send-fill fs-5"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <!-- Заглушка, если задача закрыта -->
                        <div
                            class="alert alert-success border-0 border-top text-center small p-3 m-0 rounded-0 d-flex flex-column align-items-center">
                            <div><i class="bi bi-check-circle-fill fs-4 mb-1"></i></div>
                            <h6 class="fw-bold mb-1">Задание проверено и закрыто!</h6>
                            @if (Model.Grade.HasValue)
                            {
                                <span class="fs-5 fw-bold">Ваша оценка: @Model.Grade</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // === ФУНКЦИЯ УВЕДОМЛЕНИЙ ===
                function showToast(message, type = 'success') {
                    const container = document.getElementById('toastContainer');
                    const toast = document.createElement('div');
                    toast.className = `custom-toast ${type}`;
                    let iconClass = 'bi-check-circle-fill text-success';
                    if (type === 'danger') iconClass = 'bi-exclamation-triangle-fill text-danger';
                    if (type === 'warning') iconClass = 'bi-info-circle-fill text-warning';
            
                    toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
                    container.appendChild(toast);
            
                    setTimeout(() => {
                        toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
                        setTimeout(() => toast.remove(), 300);
                    }, 3500);
                }

                const chatBox = document.getElementById('chatBoxContainer');
                chatBox.scrollTop = chatBox.scrollHeight;

                const fileInput = document.getElementById('studentReplyFiles');
                const fileListContainer = document.getElementById('studentFileListContainer');
                const submitBtn = document.getElementById('studentSubmitReplyBtn');
                const textInput = document.getElementById('studentReplyText');

                if (!submitBtn) return; // Если задача закрыта, скрипт не нужен

                let selectedFiles = new DataTransfer();

                // Управление файлами
                fileInput.addEventListener('change', function () {
                    const newFiles = Array.from(this.files);

                    for (let file of newFiles) {
                        if (selectedFiles.files.length >= 3) {
                            showToast('Можно прикрепить не более 3 файлов!', 'warning');
                            break;
                        }
                        let isDuplicate = false;
                        for (let i = 0; i < selectedFiles.files.length; i++) {
                            if (selectedFiles.files[i].name === file.name && selectedFiles.files[i].size === file.size) {
                                isDuplicate = true; break;
                            }
                        }
                        if (!isDuplicate) selectedFiles.items.add(file);
                    }

                    let totalSizeMb = Array.from(selectedFiles.files).reduce((sum, f) => sum + f.size, 0) / (1024 * 1024);
                    if (totalSizeMb > 75.0) {
                        showToast(`Общий вес файлов (${totalSizeMb.toFixed(2)} МБ) превышает 75 МБ!`, 'danger');
                        selectedFiles = new DataTransfer();
                    }

                    this.files = selectedFiles.files;
                    renderFileList();
                });

                function renderFileList() {
                    fileListContainer.innerHTML = '';
                    const files = Array.from(selectedFiles.files);

                    if (files.length === 0) {
                        fileListContainer.classList.add('d-none');
                        return;
                    }
                    fileListContainer.classList.remove('d-none');

                    files.forEach((file, index) => {
                        const sizeMb = (file.size / 1024 / 1024).toFixed(2);
                        const chip = document.createElement('div');
                        chip.className = 'badge bg-light text-dark border px-2 py-2 d-flex align-items-center gap-2 shadow-sm';
                        chip.style.fontSize = '0.75rem';
                        chip.innerHTML = `
                            <i class="bi bi-file-earmark-text text-primary"></i>
                            <span class="text-truncate" style="max-width: 150px;">${file.name}</span>
                            <span class="text-muted">(${sizeMb} МБ)</span>
                            <button type="button" class="btn-close ms-1" style="font-size: 0.5rem;" onclick="removeSelectedFile(${index})"></button>
                        `;
                        fileListContainer.appendChild(chip);
                    });
                }

                window.removeSelectedFile = function (index) {
                    const dt = new DataTransfer();
                    const files = Array.from(selectedFiles.files);
                    files.splice(index, 1);
                    files.forEach(f => dt.items.add(f));
                    selectedFiles = dt;
                    fileInput.files = selectedFiles.files;
                    renderFileList();
                };

                // Отправка
                submitBtn.addEventListener('click', async function () {
                    const text = textInput.value.trim();
                    if (!text && selectedFiles.files.length === 0) {
                        showToast('Напишите текст или прикрепите файл!', 'warning');
                        return;
                    }

                    const originalIcon = '<i class="bi bi-send-fill fs-5"></i>';
                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm text-white"></span>';

                    const formData = new FormData();
                    formData.append('materialId', document.getElementById('materialId').value);
                    formData.append('groupId', document.getElementById('groupId').value);
                    formData.append('text', text);

                    Array.from(selectedFiles.files).forEach(file => {
                        formData.append('files', file);
                    });

                    try {
                        const response = await fetch('/Assignments/SendMessage', { method: 'POST', body: formData });
                        const result = await response.json();

                        if (result.success) {
                            window.location.reload();
                        } else {
                            showToast(result.message, 'danger');
                            this.disabled = false;
                            this.innerHTML = originalIcon;
                        }
                    } catch (err) {
                        showToast('Ошибка сети при отправке.', 'danger');
                        this.disabled = false;
                        this.innerHTML = originalIcon;
                    }
                });
            });
        </script>