@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Добавление компании";
}

<style>
    :root {
        --brand-primary: #4F589D;
        --brand-dark: #3b4382;
        --brand-gray: #e2e8f0;
    }

    .form-control {
        border-radius: 10px;
        padding: 12px 15px 12px 45px;
        border: 1px solid var(--brand-gray);
        background-color: #f8fafc;
        transition: all 0.3s;
        box-sizing: border-box;
        font-weight: 500;
        color: #333;
    }

    .form-control:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 0.25rem rgba(79, 88, 157, 0.15);
        background-color: #fff;
    }

    .input-icon-wrapper {
        position: relative;
    }
    .input-icon-wrapper .bi {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #a0aabf;
        font-size: 1.1rem;
        z-index: 10;
    }

    .btn-brand {
        background-color: var(--brand-primary);
        color: white;
        border: none;
        transition: all 0.3s;
    }
    .btn-brand:hover {
        background-color: var(--brand-dark);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(79, 88, 157, 0.3);
    }

    .info-box {
        background-color: #f0f4ff;
        border-left: 4px solid var(--brand-primary);
        color: #445;
        border-radius: 6px;
        font-size: 0.85rem;
    }

    /* Стили для превью логотипа */
    .logo-preview-box {
        width: 100px;
        height: 100px;
        border-radius: 12px;
        border: 2px dashed var(--brand-gray);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f8fafc;
    }
    .logo-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Уведомления */
    .toast-container-custom {
        position: fixed; top: 20px; right: 20px; z-index: 9999;
        display: flex; flex-direction: column; gap: 10px;
    }
    .custom-toast {
        min-width: 300px; max-width: 400px; background: white;
        border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        display: flex; align-items: center; padding: 15px 20px;
        animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        border-left: 6px solid #ccc;
    }
    .custom-toast.success { border-left-color: #198754; }
    .custom-toast.danger { border-left-color: #dc3545; }

    @@keyframes slideInRight { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes fadeOutRight { from { transform: translateX(0); opacity: 1; } to { transform: translateX(120%); opacity: 0; } }
</style>

<div id="toastContainer" class="toast-container-custom"></div>

<div class="mb-4 mt-2">
    <a href="/Companies/Index" class="text-decoration-none text-muted small d-flex align-items-center gap-1 mb-2 hover-primary" style="transition: color 0.2s;">
        <i class="bi bi-arrow-left"></i> Назад к списку компаний
    </a>
    <h3 class="fw-bold text-dark m-0">Добавление новой компании</h3>
</div>

<div class="card border-0 shadow-sm p-4 mb-5" style="max-width: 650px; border-radius: 12px;">
    <!-- ДОБАВЛЕН enctype="multipart/form-data" -->
    <form id="createCompanyForm" autocomplete="off" enctype="multipart/form-data">
        
        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">НАИМЕНОВАНИЕ КОМПАНИИ <span class="text-danger">*</span></label>
            <div class="input-icon-wrapper">
                <i class="bi bi-building"></i>
                <input name="Name" id="companyName" type="text" class="form-control" required value="@ViewBag.Name" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">ИНН КОМПАНИИ <span class="text-danger">*</span></label>
            <div class="input-icon-wrapper">
                <i class="bi bi-hash"></i>
                <input name="Inn" id="companyInn" type="text" class="form-control" required  
                       pattern="[0-9]{10,12}" title="ИНН должен состоять только из 10 или 12 цифр" 
                       value="@ViewBag.Inn" style="letter-spacing: 1px;" />
            </div>
        </div>

        <!-- НОВОЕ ПОЛЕ: ЛОГОТИП -->
        <div class="mb-4">
            <label class="form-label text-muted small fw-bold">ЛОГОТИП КОМПАНИИ (НЕОБЯЗАТЕЛЬНО)</label>
            <div class="d-flex align-items-center gap-4">
                <div class="logo-preview-box" id="logoPreviewBox">
                    <i class="bi bi-image text-muted opacity-50 fs-1" id="logoPlaceholderIcon"></i>
                    <img id="logoImagePreview" src="" alt="Превью" style="display: none;" />
                </div>
                <div class="flex-grow-1">
                    <input name="logoFile" id="companyLogo" type="file" class="form-control" accept="image/*" style="padding-left: 15px;" onchange="previewImage(this)" />
                    <div class="form-text small text-muted mt-1">Загрузите картинку (.jpg, .png, .svg, .webp).</div>
                </div>
            </div>
        </div>

        <div class="info-box p-3 mb-4 d-flex gap-2 align-items-start">
            <i class="bi bi-info-circle-fill text-primary fs-5"></i>
            <div>
                <strong>Проверка системы:</strong> ИНН компании является её уникальным идентификатором. Система автоматически заблокирует сохранение, если компания с таким ИНН уже существует в СДО.
            </div>
        </div>

        <div class="d-flex gap-2 pt-2 border-top">
            <button type="button" id="submitCreateBtn" class="btn btn-brand px-4 py-2 fw-bold d-flex align-items-center gap-2 rounded-3 mt-3">
                <i class="bi bi-check-lg fs-5"></i> Сохранить компанию
            </button>
            <a href="/Companies/Index" class="btn btn-light px-4 py-2 fw-bold border text-secondary rounded-3 mt-3">
                Отмена
            </a>
        </div>
    </form>
</div>

<script>
    function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `custom-toast ${type}`;
        const iconClass = type === 'success' ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger';
        toast.innerHTML = `<i class="bi ${iconClass} fs-4 me-3"></i><div class="fw-bold text-dark" style="font-size: 0.9rem; line-height: 1.4;">${message}</div>`;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.animation = 'fadeOutRight 0.3s ease-in forwards';
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }

    // Функция для предпросмотра картинки
    function previewImage(input) {
        const preview = document.getElementById('logoImagePreview');
        const placeholder = document.getElementById('logoPlaceholderIcon');
        
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        }
    }

    document.getElementById('submitCreateBtn').addEventListener('click', async function () {
        const form = document.getElementById('createCompanyForm');
        
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Сохранение...';

        // ИСПОЛЬЗУЕМ FormData ВМЕСТО URLSearchParams
        const formData = new FormData(form);

        try {
            const response = await fetch('/Companies/Create', {
                method: 'POST',
                body: formData
                // Заголовок Content-Type НЕ УКАЗЫВАЕМ, браузер сам поставит multipart/form-data с boundary
            });
            
            const result = await response.json();

            if (result.success) {
                showToast('Компания успешно добавлена!', 'success');
                setTimeout(() => {
                    window.location.href = '/Companies/Index';
                }, 1000);
            } else {
                showToast(result.message, 'danger');
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-check-lg fs-5"></i> Сохранить компанию';
            }
        } catch (err) {
            showToast('Ошибка сети при сохранении.', 'danger');
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-check-lg fs-5"></i> Сохранить компанию';
        }
    });
</script>